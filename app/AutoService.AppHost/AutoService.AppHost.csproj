<Project Sdk="Aspire.AppHost.Sdk/13.2.4">

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.2.4" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.2.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>251e678a-5d1f-4579-8d82-85175558b81a</UserSecretsId>
  </PropertyGroup>

  <!-- Stop a stale AppHost process before build so output files are not locked. -->
  <Target Name="KillRunningAppHost" BeforeTargets="PreBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="taskkill /F /IM AutoService.AppHost.exe 2&gt;nul" IgnoreExitCode="true" />
  </Target>

</Project>
