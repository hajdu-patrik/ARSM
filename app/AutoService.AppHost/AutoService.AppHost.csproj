<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <!-- Transitive pin over Aspire 13.6.1 (MessagePack 2.5.302, GHSA-qhrr-8q5h-9q3h); drop once Aspire ships a fixed one. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>251e678a-5d1f-4579-8d82-85175558b81a</UserSecretsId>
    <!-- ASPIRE010 opt-out: Dashboard/DCP stay NuGet-restored and lock-pinned since the CLI bundle
         resolves from machine-local ~/.aspire, absent on CI (see AppHost/CLAUDE.md). -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <!-- Aspire injects Dashboard/DCP packages for the build host RID. -->
    <NuGetLockFilePath Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">$(MSBuildProjectDirectory)/packages.lock.linux-x64.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">$(MSBuildProjectDirectory)/packages.lock.osx-arm64.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">$(MSBuildProjectDirectory)/packages.lock.osx-x64.json</NuGetLockFilePath>
  </PropertyGroup>

  <!-- Stop a stale AppHost process before build so output files are not locked. -->
  <Target Name="KillRunningAppHost" BeforeTargets="PreBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="taskkill /F /IM AutoService.AppHost.exe 2&gt;nul" IgnoreExitCode="true" />
  </Target>

</Project>
