# =====================================================================
# ARSM root environment: TEMPLATE
# Copy to .env and fill in the local values:
#   cp .env.example .env
# .env is gitignored and never leaves the developer machine;
# only this placeholder template is tracked.
# =====================================================================

# =====================================================================
# Local development
# =====================================================================

# Read-only PostgreSQL URI for the AI SQL tooling (ai_agent_test_user, SELECT-only,
# never an owner or superuser). The host port must match the AppHost PostgreSQL container.
ARSM_MCP_POSTGRES_CONNECTION_STRING=postgresql://ai_agent_test_user:SET_LOCAL_READONLY_PASSWORD@localhost:50000/AutoServiceDb

# Local dev DB admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SET_LOCAL_ADMIN_PASSWORD

# Shared password of the 10 generated test mechanics
MECHANIC_PASSWORD=SET_LOCAL_MECHANIC_PASSWORD

# teszt.arsm.hu gate token (at least 32 chars)
GATE_TOKEN=SET_LOCAL_GATE_TOKEN

# =====================================================================
# Azure production deploy: python scripts/deploy-azure.py
# =====================================================================

# --- Azure ---
# Subscription id: az account show --query id -o tsv
ARSM_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Resource group the script creates and deploys into
ARSM_AZURE_RESOURCE_GROUP=arsm-rg
# Region allowed by the student subscription (optional, default swedencentral)
ARSM_AZURE_LOCATION=swedencentral
# Container registry name: 5-50 lowercase letters/digits, globally unique
ARSM_ACR_NAME=arsmexampleacr
# Blob container for profile pictures (optional, default arsm-profile-pictures)
ARSM_BLOB_CONTAINER=arsm-profile-pictures

# --- Scaling ---
# Keep one API replica always running (optional, default true)
ARSM_API_ALWAYS_ON=true
# Keep one web (gate + Nginx) replica running (optional, default false, ~2 s cold start)
ARSM_WEB_ALWAYS_ON=false

# --- Guard rails ---
# E-mail for the budget and alert mails; empty creates no budget, action group or alert rule (optional)
ARSM_ALERT_EMAIL=
# Monthly budget in the subscription currency, mails at 50, 80 and 100 percent (optional, default 20)
ARSM_MONTHLY_BUDGET=20
# Daily Log Analytics ingestion cap in GB (optional, default 1)
ARSM_LOG_DAILY_QUOTA_GB=1

# --- Production secrets and public address ---
# Public https origin, no trailing slash; baked into the web image, used as CORS origin
ARSM_PUBLIC_URL=https://arsm.hu
# PostgreSQL admin password: openssl rand -hex 24
ARSM_POSTGRES_PASSWORD=change-me
# JWT signing secret, at least 32 bytes: openssl rand -base64 48
ARSM_JWT_SECRET=change-me-at-least-32-bytes-long
# Production gate token, at least 32 chars, different from GATE_TOKEN above
ARSM_PROD_GATE_TOKEN=change-me-at-least-32-characters-long

# --- Bootstrap admin (the only account in the empty production database) ---
ARSM_PROD_ADMIN_EMAIL=admin@example.com
# Required on every deploy, used only on the first start
ARSM_PROD_ADMIN_PASSWORD=change-me
ARSM_PROD_ADMIN_FIRST_NAME=Example
ARSM_PROD_ADMIN_LAST_NAME=Admin
# Optional
ARSM_PROD_ADMIN_MIDDLE_NAME=
# Optional
ARSM_PROD_ADMIN_PHONE=
# GasolineAndDiesel, HybridAndElectric or All
ARSM_PROD_ADMIN_SPECIALIZATION=All
# Comma separated ExpertiseType names, 1-10 unique (Engine, Brakes, ...)
ARSM_PROD_ADMIN_EXPERTISE=Engine,Brakes

# --- Company letterhead on quote PDFs ---
ARSM_COMPANY_NAME=Example Auto Kft.
ARSM_COMPANY_ADDRESS_LINE=Example utca 1.
ARSM_COMPANY_POSTAL_CODE=1111
ARSM_COMPANY_CITY=Budapest
ARSM_COMPANY_TAX_NUMBER=00000000-0-00
ARSM_COMPANY_PHONE=+36 1 000 0000
ARSM_COMPANY_EMAIL=info@example.com
