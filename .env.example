# ─────────────────────────────────────────────────────────────
# ARSM Root Environment Variables — TEMPLATE
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your local values.
#
#   cp .env.example .env
#
# .env is gitignored and never leaves the developer machine;
# only this placeholder template is tracked.
# ─────────────────────────────────────────────────────────────

# Read-only PostgreSQL URI used by the AI SQL tooling.
# Policy: ai_agent_test_user with a SELECT-only grant — never an owner or superuser role.
# The host port must match the PostgreSQL container published by AppHost.
ARSM_MCP_POSTGRES_CONNECTION_STRING=postgresql://ai_agent_test_user:SET_LOCAL_READONLY_PASSWORD@localhost:50000/AutoServiceDb
