# Copy to rustfs.env in the kit folder; the arsm-tunnel-rustfs container (S3 store for profile pictures) reads it.
RUSTFS_ACCESS_KEY=<generate: openssl rand -hex 16>
RUSTFS_SECRET_KEY=<generate: openssl rand -base64 36>
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
RUSTFS_VOLUMES=/data
RUSTFS_OBS_LOGGER_LEVEL=warn
RUSTFS_OBS_LOG_DIRECTORY=/logs
RUSTFS_OBS_ENVIRONMENT=production
