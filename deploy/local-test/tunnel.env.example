# ARSM test kit: tunnel.env (deploy.py)
PUBLIC_URL=https://teszt.example.com
POSTGRES_PASSWORD=<same as POSTGRES_PASSWORD in postgres.env>
JWT_SECRET=<same as JwtSettings__Secret in api.env>
S3_ACCESS_KEY=<same as RUSTFS_ACCESS_KEY in rustfs.env>
S3_SECRET_KEY=<same as RUSTFS_SECRET_KEY in rustfs.env>
ADMIN_EMAIL=<bootstrap admin e-mail, same as Bootstrap__Admin__Email in api.env>
ADMIN_PASSWORD=<bootstrap admin password; passed only on the first boot of an empty database>
ARSM_REPO=<absolute path of the ARSM repository clone>
