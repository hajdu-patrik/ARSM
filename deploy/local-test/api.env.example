# ARSM test kit: api.env (the arsm-tunnel-api container)
ASPNETCORE_ENVIRONMENT=Production
Deployment__RateLimiterTopology=SingleInstance
AllowedHosts=arsm-tunnel-api
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
ForwardedHeaders__ForwardLimit=1
ConnectionStrings__AutoServiceDb=Host=arsm-tunnel-postgres;Port=5432;Database=AutoServiceDb;Username=postgres;Password=<POSTGRES_PASSWORD from postgres.env>
PGGSSENCMODE=disable
JwtSettings__Secret=<generate: openssl rand -base64 48>
ObjectStorage__ServiceUrl=http://arsm-tunnel-rustfs:9000
ObjectStorage__AccessKeyId=<RUSTFS_ACCESS_KEY from rustfs.env>
ObjectStorage__SecretAccessKey=<RUSTFS_SECRET_KEY from rustfs.env>
ObjectStorage__AutoCreateBucket=true
CompanyProfile__Name=<quote letterhead: company name>
CompanyProfile__AddressLine=<street and number>
CompanyProfile__PostalCode=<4-digit postal code>
CompanyProfile__City=<city>
CompanyProfile__TaxNumber=<12345678-1-12>
CompanyProfile__PhoneNumber=<phone number>
CompanyProfile__Email=<e-mail address>
Bootstrap__Admin__Email=<bootstrap admin e-mail>
Bootstrap__Admin__FirstName=<first name>
Bootstrap__Admin__LastName=<last name>
Bootstrap__Admin__Specialization=All
Bootstrap__Admin__Expertise__0=Engine
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
# Transactional e-mail (Resend): the key of the repository .env (ARSM_RESEND_API_KEY); blank = no-op sender
Email__ResendApiKey=<re_... or blank>
Email__From=ARSM <info@example.com>
Email__ReplyTo=info@example.com
Email__PublicUrl=<PUBLIC_URL from tunnel.env>
