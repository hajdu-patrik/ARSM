# Local secret template (copy to .secrets and fill with real local values)

# Shared HTTP/E2E test identities
ARSM_TEST_ADMIN_EMAIL=SET_LOCAL_ADMIN_EMAIL
ARSM_TEST_ADMIN_PASSWORD=SET_LOCAL_ADMIN_PASSWORD
ARSM_TEST_MECHANIC_EMAIL=SET_LOCAL_MECHANIC_EMAIL
ARSM_TEST_MECHANIC_PASSWORD=SET_LOCAL_MECHANIC_PASSWORD
ARSM_TEST_MECHANIC_NEW_PASSWORD=SET_LOCAL_MECHANIC_NEW_PASSWORD
ARSM_TEST_CUSTOMER_EMAIL=SET_LOCAL_CUSTOMER_EMAIL

# Shared password aliases used by HTTP test matrixes
ARSM_TEST_PASSWORD=SET_LOCAL_SHARED_TEST_PASSWORD
ARSM_TEST_WRONG_PASSWORD=SET_LOCAL_WRONG_PASSWORD