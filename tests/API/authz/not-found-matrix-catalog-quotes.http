X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "lineKind": "Part", "quantity": 1, "partId": null, "laborTypeId": null, "description": "Ghost line", "netUnitPrice": 10, "vatRatePercent": 27, "version": 1 }

