PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{NonExistentId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Ghost Update", "notes": null, "version": 1 }

?? status == 404

