POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Ghost Quote" }

?? status == 404

