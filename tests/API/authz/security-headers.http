# SecurityHeadersMiddleware runs first, so the fixed header set is on every response: a 200, a 401 and the 403 of the Origin
# check. Every /api JSON answer also carries Cache-Control no-store. HSTS is not asserted: the API runs in Development here.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}

### [Negative][Headers] A 401 carries the full header set (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics

?? status == 401
?? js (response.headers['x-content-type-options'] == "nosniff") == true
?? js (response.headers['x-frame-options'] == "DENY") == true
?? js (response.headers['referrer-policy'] == "strict-origin-when-cross-origin") == true
?? js (response.headers['cross-origin-opener-policy'] == "same-origin") == true
?? js (response.headers['cross-origin-resource-policy'] == "same-site") == true
?? js (response.headers['cache-control'] == "no-store") == true
?? js (response.headers['content-security-policy'] == "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'") == true
?? js (response.headers['permissions-policy'].includes("camera=()") && response.headers['permissions-policy'].includes("geolocation=()")) == true

###

### [Setup][Headers] Clear any session cookie left by a previous file (204, 401 or 403, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Headers] Login as admin (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js (response.headers['x-content-type-options'] == "nosniff" && response.headers['cache-control'] == "no-store") == true

###

### [Positive][Headers] A 200 JSON answer carries the full header set (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/auth/validate

?? status == 200
?? js (response.headers['x-content-type-options'] == "nosniff") == true
?? js (response.headers['x-frame-options'] == "DENY") == true
?? js (response.headers['referrer-policy'] == "strict-origin-when-cross-origin") == true
?? js (response.headers['cross-origin-opener-policy'] == "same-origin") == true
?? js (response.headers['cross-origin-resource-policy'] == "same-site") == true
?? js (response.headers['cache-control'] == "no-store") == true
?? js (response.headers['content-security-policy'] == "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'") == true
?? js (response.headers['permissions-policy'].includes("camera=()") && response.headers['permissions-policy'].includes("microphone=()")) == true

###

### [Positive][Headers] A list answer is not cacheable either (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics?pageSize=1

?? status == 200
?? js (response.headers['cache-control'] == "no-store") == true
?? js (response.headers['x-content-type-options'] == "nosniff") == true

###

### [Negative][Headers] The 403 written by the Origin middleware carries the set too (403 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: https://evil.example.com
X-CSRF-Token: {{CsrfToken}}

?? status == 403
?? js (response.headers['x-content-type-options'] == "nosniff" && response.headers['x-frame-options'] == "DENY") == true
?? js (response.headers['cache-control'] == "no-store") == true

###

### [Setup][Headers] Logout admin (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
