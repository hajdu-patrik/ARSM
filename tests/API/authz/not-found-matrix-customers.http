# Not-found matrix, split by resource (catalog/quotes live in not-found-matrix-catalog-quotes.http): every
# mutation with a non-existent id (999999) must answer 404, never 500. Customers/Vehicles/Appointments need only an authenticated session (no Customer ever gets an IdentityUserId, see catalog-authz.http); AdminOnly assign/unassign is excluded (403 first) and covered in admin-assign-unassign.http. The admin account used here also satisfies MechanicOnly.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@SessionEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@SessionPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@NonExistentId = 999999
@GhostVin = TST{{RunId.toString().slice(-10)}}0401


### [Setup][Authz] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Authz] Login with the admin account (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{SessionEmail}}",
  "password": "{{SessionPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# ── Customers (Customers/CustomerEndpoints*.cs) ───────────────


### [Negative][Authz] PUT /api/customers/{{NonExistentId}} (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Ghost", "middleName": null, "lastName": "Customer", "email": "ghost.customer.{{RunId}}@example.test", "phoneNumber": null }

?? status == 404

###

### [Negative][Authz] DELETE /api/customers/{{NonExistentId}} (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

# ── Vehicles (Vehicles/VehicleEndpoints*.cs) ──────────────────


### [Negative][Authz] POST /api/customers/{{NonExistentId}}/vehicles (404 expected: GhostVin is a syntactically valid 17-char VIN, so body validation passes and the route-id existence lookup is reached)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentId}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "GHO-404", "vin": "{{GhostVin}}", "brand": "Ghost", "model": "Rider", "year": 2020, "mileageKm": 10000, "enginePowerKw": 100, "drivetrainType": "Petrol" }

?? status == 404

###

### [Negative][Authz] PUT /api/vehicles/{{NonExistentId}} (404 expected: GhostVin is a syntactically valid 17-char VIN, so body validation passes and the route-id existence lookup is reached)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "GHO-404", "vin": "{{GhostVin}}", "brand": "Ghost", "model": "Rider", "year": 2020, "mileageKm": 10000, "enginePowerKw": 100, "drivetrainType": "Petrol" }

?? status == 404

###

### [Negative][Authz] DELETE /api/vehicles/{{NonExistentId}} (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

# ── Appointments (Appointments/AppointmentEndpoints*.cs) ──────


### [Negative][Authz] PUT /api/appointments/{{NonExistentId}} (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{NonExistentId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "dueDateTime": "2026-04-25T16:00:00", "taskDescription": "Ghost task" }

?? status == 404

###

### [Negative][Authz] PUT /api/appointments/{{NonExistentId}}/vehicle (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{NonExistentId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "GHO-404", "vin": "{{GhostVin}}", "brand": "Ghost", "model": "Rider", "year": 2020, "mileageKm": 10000, "enginePowerKw": 100, "drivetrainType": "Petrol" }

?? status == 404

###

### [Negative][Authz] PUT /api/appointments/{{NonExistentId}}/claim (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{NonExistentId}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

### [Negative][Authz] DELETE /api/appointments/{{NonExistentId}}/claim (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{NonExistentId}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

### [Negative][Authz] PUT /api/appointments/{{NonExistentId}}/status (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{NonExistentId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "InProgress" }

?? status == 404
