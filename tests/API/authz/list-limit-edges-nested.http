# Appointment and vehicle-quote lists clamp `limit` via ListQueryLimits.Normalize (1..500); the paged lists clamp page/pageSize via NormalizePage.
# Smoke check (clamp floor + binding failure) for the nested lists; parts/labor-types/quotes paging lives in list-paging-catalog-quotes.http; ids resolved at run time. Signs in as admin (also a mechanic, so MechanicOnly passes); admin/mechanics itself is AdminOnly and excluded.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@FixtureCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@SessionEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@SessionPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}


### [Setup][Authz] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Authz] Login with the admin account (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{SessionEmail}}", "password": "{{SessionPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###


### [Setup][Authz] Resolve the shared fixture customer (200 expected)
# Resolved at run time: earlier suites delete fixture rows, so a hardcoded id can disappear.
# @name fixtureCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{FixtureCustomerEmail}}

?? status == 200

###

### [Setup][Authz] Resolve one of that customer's vehicles (200 expected)
@FixtureCustomerId = {{fixtureCustomer.id}}
# @name fixtureVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/vehicles?page=1&pageSize=500

?? status == 200

###


# ── Smoke checks (limit=0, limit=abc) for the remaining shared-clamp endpoints ──


### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/vehicles?pageSize=0 (200 expected, clamped to 1 row)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/vehicles?pageSize=0

?? status == 200
?? js response.parsedBody.pageSize == 1
?? js response.parsedBody.items.length <= 1

###

### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/vehicles?pageSize=100000 (200 expected, clamped to 500 rows)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/vehicles?pageSize=100000

?? status == 200
?? js response.parsedBody.pageSize == 500
?? js response.parsedBody.items.length <= 500

###

### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/vehicles?page=0 (200 expected, page below 1 becomes 1)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/vehicles?page=0

?? status == 200
?? js response.parsedBody.page == 1
?? js response.parsedBody.pageSize == 20
?? js (response.parsedBody.totalCount >= response.parsedBody.items.length) == true

###

### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/vehicles?page=100000 (200 expected, past the end: no items, real totalCount)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/vehicles?page=100000&pageSize=5

?? status == 200
?? js response.parsedBody.items.length == 0
?? js response.parsedBody.totalCount >= 0

###

### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/vehicles?page=abc (400 expected, a non-numeric page fails model binding - never 500)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/vehicles?page=abc

?? status == 400

###

### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/vehicles?pageSize=1&page=1 (200 expected, totalCount covers every page)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/vehicles?page=1&pageSize=1

?? status == 200
?? js response.parsedBody.items.length == 1
?? js (response.parsedBody.totalCount == fixtureVehicles.totalCount) == true

###

### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/appointments?limit=0 (200 expected, clamped to 1 row)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/appointments?limit=0

?? status == 200
?? js response.parsedBody.length <= 1

###

### [Case][Authz] GET /api/customers/{{FixtureCustomerId}}/appointments?limit=abc (400 expected, a non-numeric limit fails model binding - never 500)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/appointments?limit=abc

?? status == 400

###

### [Case][Authz] GET /api/vehicles/{{fixtureVehicles.items[0].id}}/appointments?limit=0 (200 expected, clamped to 1 row)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureVehicles.items[0].id}}/appointments?limit=0

?? status == 200
?? js response.parsedBody.length <= 1

###

### [Case][Authz] GET /api/vehicles/{{fixtureVehicles.items[0].id}}/appointments?limit=abc (400 expected, a non-numeric limit fails model binding - never 500)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureVehicles.items[0].id}}/appointments?limit=abc

?? status == 400

