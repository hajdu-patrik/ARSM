# limit clamps via ListQueryLimits.Normalize (1..500, default 500) or, for by-name only, NormalizeCustomerLookupLimit
# (1..25, default 10); limit=abc fails model binding (400, never 500). Signs in as admin (also a mechanic, so MechanicOnly passes); /api/admin/mechanics shares the clamp but is AdminOnly, so it 403s first and is excluded here.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@SessionEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@SessionPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}


### [Setup][Authz] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Authz] Login with the admin account (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{SessionEmail}}", "password": "{{SessionPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###


# ── Customers: GET /api/customers, full matrix (ListQueryLimits, Customers/CustomerEndpoints.Queries.cs) ──


### [Case][Authz] GET /api/customers?limit=0 (200 expected, clamped to 1 row)
GET {{AutoService_ApiService_HostAddress}}/api/customers?limit=0

?? status == 200
?? js response.parsedBody.length <= 1

###

