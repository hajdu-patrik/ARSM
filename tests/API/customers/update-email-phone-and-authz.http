# ─────────────────────────────────────────────────────────────
# CUSTOMERS - UPDATE EMAIL PHONE AND AUTHZ
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@KnownCustomerPhone = +36304445566
@RunId = {{$timestamp}}
@FixtureCustomerEmail = update.conflict.{{RunId}}@example.test


# ─────────────────────────────────────────────────────────────

### [Setup][Customers] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as admin for update tests (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Setup][Customers] Create a fixture customer to update below (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Negative][Customers] Update customer with invalid email format (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth",
  "email": "invalid-email-format",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Update customer with invalid European phone format (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": "12345"
}

?? status == 422

###

### [Negative][Customers] Update customer with duplicate email conflict (409 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{AdminEmail}}",
  "phoneNumber": null
}

?? status == 409

###

### [Negative][Customers] Update customer with duplicate phone conflict (409 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": "{{KnownCustomerPhone}}"
}

?? status == 409

###

### [Setup][Customers] Logout admin, login as non-admin for update check
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as non-admin mechanic (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

?? status == 200

###

### [Positive][Customers] Non-admin can update customer (204 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 204

###

### [Cleanup][Customers] Non-admin deletes the fixture customer created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}

?? status == 204
