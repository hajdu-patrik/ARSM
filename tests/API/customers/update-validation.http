# PUT /api/customers/{id} validation: the same required, name, email, phone (422) and length (400) rules as create
# (create-validation-fields.http, create-validation-length.http) hold on update, and a refused update changes nothing.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@Digits = {{RunId.toString().slice(-7)}}
@Name51 = {{'N'.repeat(51)}}
@Email155 = {{'l'.repeat(40)}}@{{'d'.repeat(63)}}.{{'e'.repeat(45)}}.test

### [Setup][Customers] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as admin (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Customers] Create the customer the updates target (201 expected)
# @name target
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "Toth", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": "+3650{{Digits}}" }

?? status == 201

###

### [Negative][Customers] Empty first name (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "", "middleName": null, "lastName": "Toth", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": null }

?? status == 422
?? js (response.parsedBody.detail === "FirstName, LastName, and Email are required.") == true

###

### [Negative][Customers] Whitespace-only last name (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "   ", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": null }

?? status == 422
?? js (response.parsedBody.detail === "FirstName, LastName, and Email are required.") == true

###

### [Negative][Customers] Empty email (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "Toth", "email": "", "phoneNumber": null }

?? status == 422
?? js (response.parsedBody.detail === "FirstName, LastName, and Email are required.") == true

###

### [Negative][Customers] First name with a space (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Mary Jane", "middleName": null, "lastName": "Toth", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": null }

?? status == 422
?? js (response.parsedBody.detail === "First name may only contain letters and hyphens.") == true

###

### [Negative][Customers] Last name with a digit (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "Toth2", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": null }

?? status == 422
?? js (response.parsedBody.detail === "Last name may only contain letters and hyphens.") == true

###

### [Negative][Customers] Middle name with an apostrophe (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": "O'Maria", "lastName": "Toth", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": null }

?? status == 422
?? js (response.parsedBody.detail === "Middle name may only contain letters and hyphens.") == true

###

### [Negative][Customers] Malformed email (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "Toth", "email": "invalid-email-format", "phoneNumber": null }

?? status == 422
?? js (response.parsedBody.detail === "Email must be a valid email address.") == true

###

### [Negative][Customers] Phone too short to be a number (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "Toth", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": "12345" }

?? status == 422
?? js (response.parsedBody.detail === "Phone number must be a valid European number.") == true

###

### [Negative][Customers] A valid non-European number (US) is refused (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "Toth", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": "+1 202 555 0143" }

?? status == 422
?? js (response.parsedBody.detail === "Phone number must be a valid European number.") == true

###

### [Negative][Customers] Last name of 51 characters (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "{{Name51}}", "email": "update.validation.{{RunId}}@example.test", "phoneNumber": null }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).join(',').toLowerCase() === 'lastname') == true
?? js (Object.values(response.parsedBody.errors)[0][0] === 'LastName must be at most 50 characters.') == true

###

### [Negative][Customers] Email of 155 characters (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Anna", "middleName": null, "lastName": "Toth", "email": "{{Email155}}", "phoneNumber": null }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).join(',').toLowerCase() === 'email') == true
?? js (Object.values(response.parsedBody.errors)[0][0] === 'Email must be at most 150 characters.') == true

###

### [Positive][Customers] None of the refused updates changed the customer (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}

?? status == 200
?? js response.parsedBody.firstName == Anna
?? js (response.parsedBody.middleName === null) == true
?? js response.parsedBody.lastName == Toth
?? js response.parsedBody.email == update.validation.{{RunId}}@example.test
?? js response.parsedBody.phoneNumber == +3650{{Digits}}

###

### [Cleanup][Customers] Delete the customer (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
