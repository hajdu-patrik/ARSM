@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@FixtureCustomerEmail = update.happy.{{RunId}}@example.test
@NonExistentCustomerId = 99999

### [Setup][Customers] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as admin for update tests (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Customers] Create a fixture customer to update below (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Positive][Customers] Admin updates existing customer (204 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": "Maria",
  "lastName": "Toth-Updated",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 204

###

### [Negative][Customers] Update non-existent customer (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentCustomerId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Ghost",
  "middleName": null,
  "lastName": "Customer",
  "email": "ghost.customer.{{RunId}}@example.test",
  "phoneNumber": null
}

?? status == 404

###

### [Negative][Customers] Update customer with missing required fields (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Update customer with firstName containing a space (422 expected)
# "First name may only contain letters and hyphens."
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Mary Jane",
  "middleName": null,
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Update customer with lastName containing a digit (422 expected)
# "Last name may only contain letters and hyphens."
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": null,
  "lastName": "Toth2",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Update customer with middleName containing an apostrophe (422 expected)
# "Middle name may only contain letters and hyphens."
PUT {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Anna",
  "middleName": "O'Maria",
  "lastName": "Toth",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 422

###

### [Cleanup][Customers] Delete the fixture customer created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
