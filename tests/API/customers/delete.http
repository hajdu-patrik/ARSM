# DELETE /api/customers/{id} as admin: 204, gone from every read, 404 on repeat, email/phone/plate/VIN free again. The 403
# and 401 are in authz.http, the appointment and quote cascade in delete-cascade.http.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@Tag = {{RunId.toString().slice(-8).split('').map(d => 'ABCDEFGHIJ'[d]).join('')}}
@Digits = {{RunId.toString().slice(-7)}}
@GhostCustomerId = 999999999

### [Setup][Customers] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as admin (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Customers] Create the customer to delete (201 expected)
# @name doomed
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Delete", "middleName": null, "lastName": "Fixture-{{Tag}}", "email": "customers.delete.{{RunId}}@example.test", "phoneNumber": "+3670{{Digits}}" }

?? status == 201

###

### [Setup][Customers] Give it a vehicle (201 expected)
# @name doomedVehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{doomed.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "CD-{{Digits}}", "vin": "TST{{RunId.toString().slice(-10)}}0861", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

###

### [Positive][Customers] Admin deletes the customer (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{doomed.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Customers] The deleted customer cannot be read (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{doomed.id}}

?? status == 404
?? js (response.parsedBody.detail === "Customer not found.") == true

###

### [Negative][Customers] Its vehicle list is gone with it (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{doomed.id}}/vehicles

?? status == 404
?? js (response.parsedBody.detail === "Customer not found.") == true

###

### [Negative][Customers] Its vehicle was deleted with it (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{doomedVehicle.id}}

?? status == 404
?? js (response.parsedBody.detail === "Vehicle not found.") == true

###

### [Negative][Customers] The email lookup no longer finds it (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email=customers.delete.{{RunId}}@example.test

?? status == 404

###

### [Negative][Customers] The plate lookup no longer finds the vehicle (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-license-plate?licensePlate=CD-{{Digits}}

?? status == 404

###

### [Positive][Customers] The list no longer contains it (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers?search={{Tag}}

?? status == 200
?? js response.parsedBody.totalCount == 0

###

### [Negative][Customers] Deleting it again (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{doomed.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js (response.parsedBody.detail === "Customer not found.") == true

###

### [Negative][Customers] Deleting a missing id (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{GhostCustomerId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js (response.parsedBody.detail === "Customer not found.") == true

###

### [Positive][Customers] The same email and phone can be registered again (201 expected)
# @name reborn
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Delete", "middleName": null, "lastName": "Fixture-{{Tag}}", "email": "customers.delete.{{RunId}}@example.test", "phoneNumber": "+3670{{Digits}}" }

?? status == 201

###

### [Positive][Customers] The plate and VIN are free again (201 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{reborn.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "CD-{{Digits}}", "vin": "TST{{RunId.toString().slice(-10)}}0861", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

###

### [Cleanup][Customers] Delete the re-registered customer (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{reborn.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
