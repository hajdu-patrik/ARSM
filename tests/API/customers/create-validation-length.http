# POST /api/customers length limits (FieldLengthValidator): names 50, email 150, measured on the trimmed value. An over-long
# field answers 400 with an `errors` entry keyed by the request property (any key casing), and the exact maximum is accepted.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@Name50 = {{'N'.repeat(50)}}
@Name51 = {{'N'.repeat(51)}}
@Email150 = {{RunId}}{{'l'.repeat(27)}}@{{'d'.repeat(63)}}.{{'e'.repeat(40)}}.test
@Email155 = {{'l'.repeat(40)}}@{{'d'.repeat(63)}}.{{'e'.repeat(45)}}.test

### [Setup][Customers] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as admin (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Customers] First name of 51 characters (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "{{Name51}}", "middleName": null, "lastName": "Customer", "email": "cv.length.{{RunId}}@example.test", "phoneNumber": null }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).join(',').toLowerCase() === 'firstname') == true
?? js (Object.values(response.parsedBody.errors)[0][0] === 'FirstName must be at most 50 characters.') == true

###

### [Negative][Customers] Middle name of 51 characters (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Valid", "middleName": "{{Name51}}", "lastName": "Customer", "email": "cv.length.{{RunId}}@example.test", "phoneNumber": null }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).join(',').toLowerCase() === 'middlename') == true
?? js (Object.values(response.parsedBody.errors)[0][0] === 'MiddleName must be at most 50 characters.') == true

###

### [Negative][Customers] Last name of 51 characters (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Valid", "middleName": null, "lastName": "{{Name51}}", "email": "cv.length.{{RunId}}@example.test", "phoneNumber": null }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).join(',').toLowerCase() === 'lastname') == true
?? js (Object.values(response.parsedBody.errors)[0][0] === 'LastName must be at most 50 characters.') == true

###

### [Negative][Customers] A well-formed email of 155 characters (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Valid", "middleName": null, "lastName": "Customer", "email": "{{Email155}}", "phoneNumber": null }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).join(',').toLowerCase() === 'email') == true
?? js (Object.values(response.parsedBody.errors)[0][0] === 'Email must be at most 150 characters.') == true

###

### [Negative][Customers] Two over-long names are both reported in one response (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "{{Name51}}", "middleName": null, "lastName": "{{Name51}}", "email": "cv.length.{{RunId}}@example.test", "phoneNumber": null }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).join(',').toLowerCase() === 'firstname,lastname') == true

###

### [Positive][Customers] Names of exactly 50 characters (padded with spaces) and an email of exactly 150 are accepted (201 expected)
# @name maxCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": " {{Name50}} ", "middleName": "{{Name50}}", "lastName": "{{Name50}} ", "email": "{{Email150}}", "phoneNumber": null }

?? status == 201
?? js (response.parsedBody.firstName == Name50) == true
?? js (response.parsedBody.middleName == Name50) == true
?? js (response.parsedBody.lastName == Name50) == true
?? js (response.parsedBody.email == Email150) == true

###

### [Cleanup][Customers] Delete the maximum-length customer (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{maxCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
