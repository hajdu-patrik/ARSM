# ─────────────────────────────────────────────────────────────
#  CREATE CUSTOMER
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}


# ─────────────────────────────────────────────────────────────

### [Setup][Customers] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as admin for create tests (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][Customers] Admin creates new customer (201 expected)
# @name createdCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Test",
  "middleName": null,
  "lastName": "Customer",
  "email": "test.customer.new.{{RunId}}@example.test",
  "phoneNumber": "+36302{{RunId.toString().slice(-6)}}"
}

?? status == 201

###

### [Positive][Customers] Admin creates customer without optional fields (201 expected)
# @name createdMinimalCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Minimal",
  "middleName": null,
  "lastName": "Customer",
  "email": "minimal.customer.{{RunId}}@example.test",
  "phoneNumber": null
}

?? status == 201

###

### [Negative][Customers] Create customer with missing required fields (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "",
  "middleName": null,
  "lastName": "Customer",
  "email": "bad.create.{{RunId}}@example.test",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Create customer with firstName containing a space (422 expected)
# "First name may only contain letters and hyphens."
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Mary Jane",
  "middleName": null,
  "lastName": "Customer",
  "email": "firstname.space.customer.{{RunId}}@example.test",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Create customer with firstName containing a digit (422 expected)
# "First name may only contain letters and hyphens."
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "John2",
  "middleName": null,
  "lastName": "Customer",
  "email": "firstname.digit.customer.{{RunId}}@example.test",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Create customer with lastName containing a special character (422 expected)
# "Last name may only contain letters and hyphens."
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Valid",
  "middleName": null,
  "lastName": "O'Brien",
  "email": "lastname.apostrophe.customer.{{RunId}}@example.test",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Create customer with middleName containing a space (422 expected)
# "Middle name may only contain letters and hyphens."
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Valid",
  "middleName": "Van Der",
  "lastName": "Customer",
  "email": "middlename.space.customer.{{RunId}}@example.test",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Create customer with invalid email format (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Invalid",
  "middleName": null,
  "lastName": "Email",
  "email": "invalid-email-format",
  "phoneNumber": null
}

?? status == 422

###

### [Negative][Customers] Create customer with invalid European phone format (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Invalid",
  "middleName": null,
  "lastName": "Phone",
  "email": "invalid.customer.phone.{{RunId}}@example.test",
  "phoneNumber": "12345"
}

?? status == 422

###

### [Cleanup][Customers] Delete the customer created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{createdCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Cleanup][Customers] Delete the minimal customer created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{createdMinimalCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
