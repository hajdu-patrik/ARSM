@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@RunId = {{$timestamp}}
@NonExistentCustomerId = 99999
@KnownCustomerPlate = ABC-101
@UnknownCustomerPlate = ZZZ-{{RunId}}
@KnownCustomerName = Anna
@FixtureCustomerEmail = list.lookup.{{RunId}}@example.test

### [Setup][Customers] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Customers] Login as admin (session prerequisite) (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Positive][Customers] List all customers (200 expected, includes vehicleLicensePlates)
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Setup][Customers] Login as non-admin mechanic (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

?? status == 200

###

### [Positive][Customers] Non-admin can list customers (200 expected, includes vehicleLicensePlates)
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Positive][Customers] Lookup customer by email for scheduler flow (200 expected)
# 200 OK with scheduler lookup fields (id, firstName, middleName, lastName, email, phoneNumber, vehicles);
# for a real customer email, email is normalized and vehicles lists that customer's vehicles.
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

###

### [Positive][Customers] Lookup customer by email with casing/whitespace normalization (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email=%20{{KnownCustomerEmail}}%20

?? status == 200

###

### [Positive][Customers] Lookup customer by mechanic email when linked customer may not exist yet (200 expected)
# 200 OK: a mechanic email is a valid lookup target too, resolving to the mechanic identity with empty
# vehicles, or to the linked customer payload (mechanic-owner-{id}@customers.arsm.local) if one exists.
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{NonAdminEmail}}

?? status == 200

###

### [Negative][Customers] Lookup customer by invalid email format (422 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email=not-an-email

?? status == 422

###

### [Negative][Customers] Lookup customer by unknown email (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email=unknown.scheduler.lookup.{{RunId}}@example.test

?? status == 404

###

### [Positive][Customers] Lookup customer by vehicle license plate for scheduler flow (200 expected)
# 200 OK with scheduler lookup fields plus matchedVehicleId; vehicles include vin, enginePowerKw, and
# drivetrainType for the matched customer.
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-license-plate?licensePlate={{KnownCustomerPlate}}

?? status == 200

###

### [Negative][Customers] Lookup customer by invalid license plate format (422 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-license-plate?licensePlate=%D8%A7%D8%A8-123

?? status == 422

###

### [Negative][Customers] Lookup customer by unknown license plate (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-license-plate?licensePlate={{UnknownCustomerPlate}}

?? status == 404

###

### [Positive][Customers] Lookup customers by name for scheduler flow (200 expected)
# Expected success semantics: response is a list of scheduler lookup payloads with vehicles.
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-name?name={{KnownCustomerName}}&limit=5

?? status == 200

###

### [Negative][Customers] Lookup customers by blank name (422 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-name?name=

?? status == 422

###

### [Negative][Customers] Unauthenticated license-plate lookup (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-license-plate?licensePlate={{KnownCustomerPlate}}

?? status == 401

###

### [Negative][Customers] Unauthenticated name lookup (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-name?name={{KnownCustomerName}}

?? status == 401

###

### [Negative][Customers] Unauthenticated list customers (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 401

###

### [Setup][Customers] Login as admin for single-customer queries (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Customers] Create a fixture customer for the get-by-id checks (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "List",
  "middleName": null,
  "lastName": "Lookup",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Positive][Customers] Get the fixture customer by id (200 expected, includes vehicle list)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}

?? status == 200

###

### [Negative][Customers] Get non-existent customer (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentCustomerId}}

?? status == 404

###

### [Cleanup][Customers] Delete the fixture customer created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
