# ─────────────────────────────────────────────────────────────
# APPOINTMENTS - ADMIN CREATE UPDATE HAPPY
# ─────────────────────────────────────────────────────────────
# PrimaryMechanicId is the admin's own person_id (the admin is a mechanic too); SecondaryMechanicId is
# a disposable mechanic registered here and deleted at the end. CustomerId/CustomerVehicleId are
# resolved from a real customer/vehicle pair instead of a literal id. Both appointments this file
# creates (ApptId, PastDateApptId) are deleted at the end via DELETE /api/appointments/{id} (AdminOnly).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@RunId = {{$timestamp}}
@SecondaryMechanicEmail = appt.create.happy.{{RunId}}@example.test
# Freshly generated, never-before-seen plate/VIN: reusing a real seeded plate/VIN here would make the
# vehicle update below collide with whichever demo vehicle actually owns it (UpdateAppointmentVehicleAsync
# 409s on a plate or VIN already used by a different vehicle).
@UpdatedLicensePlate = UPD-{{RunId}}
@UpdatedVehicleVin = TST{{RunId.toString().slice(-10)}}0801


# ─────────────────────────────────────────────────────────────

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin (session prerequisite for AdminOnly endpoints, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

@PrimaryMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Resolve a customer that owns a vehicle (200 expected)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Setup][Appointments] Resolve one of that customer's vehicles (200 expected)
@CustomerId = {{seedCustomers.find(c => c.vehicleCount > 0).id}}
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/vehicles

?? status == 200

###

@CustomerVehicleId = {{seedVehicles[0].id}}

### [Setup][Appointments] Register disposable secondary mechanic for the two-mechanic create case (200 expected)
# @name secondaryMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "ApptCreate",
  "lastName": "Happy",
  "email": "{{SecondaryMechanicEmail}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

@SecondaryMechanicId = {{secondaryMechanic.personId}}

### [Positive][Appointments] Admin creates appointment for customer (201 expected)
# Response includes intakeCreatedAt and dueDateTime (dueDateTime defaults to scheduledDate for this path).
# @name createdAppt
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [{{PrimaryMechanicId}}, {{SecondaryMechanicId}}]
}

?? status == 201

###

@ApptId = {{createdAppt.id}}

### [Positive][Appointments] Admin updates appointment dueDateTime/taskDescription (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2026-04-22T16:15:00",
  "taskDescription": "Frissitett feladat leiras az admin szerkeszteshez"
}

?? status == 200

###

### [Positive][Appointments] Admin updates appointment vehicle fields (vehicle edits persist, 200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "{{UpdatedLicensePlate}}",
  "vin": "{{UpdatedVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 82,
  "drivetrainType": "Petrol"
}

?? status == 200

###

### [Positive][Appointments] Admin create allows past scheduled date (201 expected)
# @name pastDateApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2020-01-01T10:30:00",
  "taskDescription": "Admin create with past date allowed",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 201

###

@PastDateApptId = {{pastDateApptCreate.id}}

### [Negative][Appointments] Admin update fails when appointment does not exist (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2026-04-22T16:15:00",
  "taskDescription": "Frissitett feladat leiras az admin szerkeszteshez"
}

?? status == 404

###

### [Negative][Appointments] Admin update cannot change ScheduledDate (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "scheduledDate": "2030-01-01T10:45:00",
  "dueDateTime": "2030-01-03T16:15:00",
  "taskDescription": "Scheduled date change should be rejected"
}

?? status == 422

###

### [Negative][Appointments] Admin vehicle update fails when appointment does not exist (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "{{UpdatedLicensePlate}}",
  "vin": "{{UpdatedVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 82,
  "drivetrainType": "Petrol"
}

?? status == 404

###

### [Cleanup][Appointments] Delete the two fixture appointments created above (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastDateApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Cleanup][Appointments] Delete the disposable secondary mechanic (200 expected)
# Safe: SecondaryMechanicId keeps company with PrimaryMechanicId on ApptId (count 2), so the deletion
# invariant in AdminEndpoints.Handlers.cs does not block it. The appointments themselves are already
# gone by this point (deleted above), so the invariant is trivially satisfied either way.
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{SecondaryMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200
