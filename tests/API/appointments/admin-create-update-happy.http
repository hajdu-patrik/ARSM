# PrimaryMechanicId is the admin's own person_id; SecondaryMechanicId is a disposable mechanic registered
# and deleted here. CustomerId/CustomerVehicleId come from a disposable customer and vehicle created and deleted here; both appointments created are deleted at the end. The 404 cases for a missing appointment live in admin-create-update-validation.http (file-size limit).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@RunId = {{$timestamp}}
# Disposable owner and vehicle: the vehicle edits persist, so the shared fixture vehicles stay untouched.
@FixtureCustomerEmail = fixture.appt.create.happy.{{RunId}}@example.test
@OwnLicensePlate = OWH-{{RunId}}
@OwnVehicleVin = TST{{RunId.toString().slice(-10)}}0800
@SecondaryMechanicEmail = appt.create.happy.{{RunId}}@example.test
# Freshly generated plate/VIN: reusing a shared fixture one would collide with the vehicle that owns it
# (UpdateAppointmentVehicleAsync 409s on a plate/VIN already used by a different vehicle).
@UpdatedLicensePlate = UPD-{{RunId}}
@UpdatedVehicleVin = TST{{RunId.toString().slice(-10)}}0801


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin (session prerequisite for AdminOnly endpoints, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-autoservice_csrf='))?.match(/^__Host-autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

@PrimaryMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Create a disposable customer, because the vehicle edits below persist (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Appointment", "middleName": null, "lastName": "Happy", "email": "{{FixtureCustomerEmail}}", "phoneNumber": null }

?? status == 201

###

### [Setup][Appointments] Create the disposable customer's vehicle (201 expected)
# @name ownVehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "{{OwnLicensePlate}}", "vin": "{{OwnVehicleVin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

###

@CustomerId = {{fixtureCustomer.id}}
@CustomerVehicleId = {{ownVehicle.id}}

### [Setup][Appointments] Register disposable secondary mechanic for the two-mechanic create case (200 expected)
# @name secondaryMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "ApptCreate",
  "lastName": "Happy",
  "email": "{{SecondaryMechanicEmail}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

@SecondaryMechanicId = {{secondaryMechanic.personId}}

### [Positive][Appointments] Admin creates appointment for customer (201 expected)
# Response includes intakeCreatedAt, dueDateTime (defaults to scheduledDate for this path) and a positive version.
# @name createdAppt
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [{{PrimaryMechanicId}}, {{SecondaryMechanicId}}]
}

?? status == 201
?? js response.parsedBody.version > 0

###

@ApptId = {{createdAppt.id}}

### [Positive][Appointments] Admin updates appointment dueDateTime/taskDescription (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2026-04-22T16:15:00",
  "taskDescription": "Frissitett feladat leiras az admin szerkeszteshez",
  "version": {{createdAppt.version}}
}

?? status == 200

###

### [Positive][Appointments] Admin updates appointment vehicle fields (vehicle edits persist, 200 expected)
# @name updatedVehicleAppt
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "{{UpdatedLicensePlate}}",
  "vin": "{{UpdatedVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 82,
  "drivetrainType": "Petrol"
}

?? status == 200

###

### [Positive][Appointments] Admin create allows past scheduled date (201 expected)
# @name pastDateApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2020-01-01T10:30:00",
  "taskDescription": "Admin create with past date allowed",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 201

###

@PastDateApptId = {{pastDateApptCreate.id}}

### [Negative][Appointments] Admin update cannot change ScheduledDate (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "scheduledDate": "2030-01-01T10:45:00",
  "dueDateTime": "2030-01-03T16:15:00",
  "taskDescription": "Scheduled date change should be rejected",
  "version": {{updatedVehicleAppt.version}}
}

?? status == 422

###

### [Cleanup][Appointments] Delete the two fixture appointments created above (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastDateApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Cleanup][Appointments] Delete the disposable secondary mechanic (200 expected)
# Safe either way: SecondaryMechanicId shared ApptId with PrimaryMechanicId (count 2), and both fixture
# appointments are already deleted above, so AdminEndpoints.Handlers.cs's deletion invariant never blocks it.
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{SecondaryMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Cleanup][Appointments] Delete the disposable customer, cascading its vehicle (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
