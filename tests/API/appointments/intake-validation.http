# Intake vehicle-choice rules: status input, vehicleId xor vehicle, id range, unknown or foreign vehicle. Every
# case is refused before anything is written, so there is nothing to clean up. Field rules: the sibling intake-validation-*.http.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@SecondCustomerEmail = fixture.second@example.test
@RunId = {{$timestamp}}

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as the plain mechanic (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the known customer and its vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

### [Setup][Appointments] Resolve the second fixture customer and its vehicle (200 expected)
# @name secondCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{SecondCustomerEmail}}

?? status == 200

### [Negative][Appointments] An explicit status is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake status input", "status": "Completed" }

?? status == 422
?? js response.parsedBody.detail includes Status cannot be provided

### [Negative][Appointments] vehicleId together with an inline vehicle is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "vehicle": { "licensePlate": "BAD-{{RunId}}", "vin": "TST{{RunId.toString().slice(-10)}}0501", "brand": "Ford", "model": "Focus", "year": 2018, "mileageKm": 120000, "enginePowerKw": 92, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake both vehicle paths" }

?? status == 422
?? js (response.parsedBody.detail === "Provide either VehicleId or Vehicle, but not both.") == true

### [Negative][Appointments] Neither vehicleId nor an inline vehicle is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake no vehicle path" }

?? status == 422
?? js (response.parsedBody.detail === "Provide either VehicleId or Vehicle, but not both.") == true

### [Negative][Appointments] vehicleId 0 is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": 0, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake vehicleId zero" }

?? status == 422
?? js (response.parsedBody.detail === "VehicleId must be a positive integer.") == true

### [Negative][Appointments] A negative vehicleId is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": -5, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake vehicleId negative" }

?? status == 422
?? js (response.parsedBody.detail === "VehicleId must be a positive integer.") == true

### [Negative][Appointments] An unknown vehicleId is refused (404 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": 99999999, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake unknown vehicle id" }

?? status == 404
?? js (response.parsedBody.detail === "Vehicle not found.") == true

### [Negative][Appointments] A vehicle owned by another customer is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{secondCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake foreign vehicle" }

?? status == 422
?? js (response.parsedBody.detail === "Vehicle does not belong to the selected customer.") == true

### [Negative][Appointments] vehicleId with an unknown customer email is refused (422 expected)
# A customer that does not exist yet cannot own an existing vehicle.
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "intake.unknown.vehicleid.{{RunId}}@example.test", "customerFirstName": "Intake", "customerLastName": "Unknown", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake vehicleId for a new customer" }

?? status == 422
?? js (response.parsedBody.detail === "VehicleId can only be used for an existing customer.") == true

### [Negative][Appointments] The refused request did not create the customer (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email=intake.unknown.vehicleid.{{RunId}}@example.test

?? status == 404
