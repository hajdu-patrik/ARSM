# ─────────────────────────────────────────────────────────────
# APPOINTMENTS - INTAKE VALIDATION
# ─────────────────────────────────────────────────────────────
# POST /api/appointments/intake sits under plain RequireAuthorization() (any mechanic session works, see
# AppointmentEndpoints.cs), so this file no longer assumes a session left over from a previous file —
# it logs in as the non-admin test mechanic itself. CustomerVehicleId is resolved from the known
# customer's own vehicle instead of a literal id.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@RunId = {{$timestamp}}
@BothVehiclePathsVin = TST{{RunId.toString().slice(-10)}}0501
@MaxVehicleVin = TST{{RunId.toString().slice(-10)}}0502
@MissingNameVehicleVin = TST{{RunId.toString().slice(-10)}}0503


# ─────────────────────────────────────────────────────────────

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

?? status == 200

###

### [Setup][Appointments] Resolve the known customer's own vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

###

@CustomerVehicleId = {{knownCustomer.vehicles[0].id}}

### [Negative][Appointments] Scheduler intake forbids explicit status input (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-23T10:00:00",
  "dueDateTime": "2026-04-24T10:00:00",
  "taskDescription": "Scheduler status input should be blocked",
  "status": "Completed"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake requires exactly one vehicle path (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "vehicle": {
    "licensePlate": "BAD-000",
    "vin": "{{BothVehiclePathsVin}}",
    "brand": "Ford",
    "model": "Focus",
    "year": 2018,
    "mileageKm": 120000,
    "enginePowerKw": 92,
    "drivetrainType": "Petrol"
  },
  "scheduledDate": "2026-04-23T10:00:00",
  "dueDateTime": "2026-04-24T10:00:00",
  "taskDescription": "Scheduler invalid vehicle path selection"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake rejects dueDateTime earlier than scheduledDate (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-24T10:00:00",
  "dueDateTime": "2026-04-24T09:59:59",
  "taskDescription": "Scheduler invalid due date ordering"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake rejects vehicle numeric values above max limits (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "intake.vehicle.max.{{RunId}}@example.test",
  "customerFirstName": "Intake",
  "customerMiddleName": null,
  "customerLastName": "Max",
  "customerPhoneNumber": "+36305556666",
  "vehicle": {
    "licensePlate": "MAX-{{RunId}}",
    "vin": "{{MaxVehicleVin}}",
    "brand": "Audi",
    "model": "A3",
    "year": 2021,
    "mileageKm": 1000001,
    "enginePowerKw": 50001,
    "drivetrainType": "Diesel"
  },
  "scheduledDate": "2026-04-24T10:00:00",
  "dueDateTime": "2026-04-25T10:00:00",
  "taskDescription": "Scheduler intake vehicle numeric max should be rejected"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake rejects unsupported vehicle drivetrain type (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "intake.vehicle.drivetrain.{{RunId}}@example.test",
  "customerFirstName": "Intake",
  "customerMiddleName": null,
  "customerLastName": "Drivetrain",
  "customerPhoneNumber": "+36305557777",
  "vehicle": {
    "licensePlate": "DRV-{{RunId}}",
    "vin": "TST{{RunId.toString().slice(-10)}}0504",
    "brand": "Audi",
    "model": "A3",
    "year": 2021,
    "mileageKm": 10000,
    "enginePowerKw": 110,
    "drivetrainType": "Hydrogen"
  },
  "scheduledDate": "2026-04-24T10:00:00",
  "dueDateTime": "2026-04-25T10:00:00",
  "taskDescription": "Scheduler intake vehicle drivetrain should be rejected"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake rejects non-existent vehicleId (404 expected)
# When vehicleId is provided but does not exist in the database.
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": 99999,
  "scheduledDate": "2026-04-23T10:00:00",
  "dueDateTime": "2026-04-24T10:00:00",
  "taskDescription": "Scheduler intake with unknown vehicle id"
}

?? status == 404

###

### [Positive][Appointments] Scheduler intake allows past scheduled date (201 expected)
# Coverage gap: appointments have no delete endpoint, so this fixture appointment is not cleaned up.
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2020-01-01T09:00:00",
  "dueDateTime": "2020-01-03T10:00:00",
  "taskDescription": "Scheduler intake with past date allowed"
}

?? status == 201

###

### [Negative][Appointments] Scheduler intake requires customer name fields when email is unknown and not a mechanic email (422 expected)
# When the email does not match any customer or mechanic, customerFirstName and customerLastName are mandatory.
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "completely.unknown.{{RunId}}@example.test",
  "vehicle": {
    "licensePlate": "UNK-{{RunId}}",
    "vin": "{{MissingNameVehicleVin}}",
    "brand": "Ford",
    "model": "Focus",
    "year": 2018,
    "mileageKm": 60000,
    "enginePowerKw": 81,
    "drivetrainType": "Petrol"
  },
  "scheduledDate": "2026-04-30T10:00:00",
  "dueDateTime": "2026-05-01T10:00:00",
  "taskDescription": "Intake missing customer name fields"
}

?? status == 422
