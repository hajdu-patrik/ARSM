# ─────────────────────────────────────────────────────────────
# APPOINTMENTS - INTAKE VALIDATION
# ─────────────────────────────────────────────────────────────
# POST /api/appointments/intake sits under plain RequireAuthorization() (any mechanic session works, see
# AppointmentEndpoints.cs), so this file no longer assumes a session left over from a previous file —
# it logs in as the non-admin test mechanic itself. CustomerVehicleId is resolved from the known
# customer's own vehicle instead of a literal id. New-customer/new-vehicle intake validation coverage
# lives in the sibling file intake-validation-new-customer.http (split out to stay under the 250-line
# file limit). The one appointment this file persists (PastDateApptId) is deleted at the end by an
# admin session via DELETE /api/appointments/{id} (AdminOnly).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@RunId = {{$timestamp}}
@BothVehiclePathsVin = TST{{RunId.toString().slice(-10)}}0501


# ─────────────────────────────────────────────────────────────

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Appointments] Resolve the known customer's own vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

###

@CustomerVehicleId = {{knownCustomer.vehicles[0].id}}

### [Negative][Appointments] Scheduler intake forbids explicit status input (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-23T10:00:00",
  "dueDateTime": "2026-04-24T10:00:00",
  "taskDescription": "Scheduler status input should be blocked",
  "status": "Completed"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake requires exactly one vehicle path (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "vehicle": {
    "licensePlate": "BAD-000",
    "vin": "{{BothVehiclePathsVin}}",
    "brand": "Ford",
    "model": "Focus",
    "year": 2018,
    "mileageKm": 120000,
    "enginePowerKw": 92,
    "drivetrainType": "Petrol"
  },
  "scheduledDate": "2026-04-23T10:00:00",
  "dueDateTime": "2026-04-24T10:00:00",
  "taskDescription": "Scheduler invalid vehicle path selection"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake rejects dueDateTime earlier than scheduledDate (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-24T10:00:00",
  "dueDateTime": "2026-04-24T09:59:59",
  "taskDescription": "Scheduler invalid due date ordering"
}

?? status == 422

###

### [Negative][Appointments] Scheduler intake rejects non-existent vehicleId (404 expected)
# When vehicleId is provided but does not exist in the database.
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": 99999,
  "scheduledDate": "2026-04-23T10:00:00",
  "dueDateTime": "2026-04-24T10:00:00",
  "taskDescription": "Scheduler intake with unknown vehicle id"
}

?? status == 404

###

### [Positive][Appointments] Scheduler intake allows past scheduled date (201 expected)
# @name pastDateApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2020-01-01T09:00:00",
  "dueDateTime": "2020-01-03T10:00:00",
  "taskDescription": "Scheduler intake with past date allowed"
}

?? status == 201

###

@PastDateApptId = {{pastDateApptCreate.id}}

### [Cleanup][Appointments] Login as admin to delete the fixture appointment (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# CSRF double-submit token for the cleanup delete below (see tests/CLAUDE.md Core Rules).

### [Cleanup][Appointments] Delete the past-date fixture appointment (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastDateApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
