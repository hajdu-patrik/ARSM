# ─────────────────────────────────────────────────────────────
# APPOINTMENTS - UNAUTHENTICATED ACCESS (401 checks)
# ─────────────────────────────────────────────────────────────
# Every route below sits under RequireAuthorization() (see AppointmentEndpoints.cs), so the 401
# is returned by the auth middleware before any handler touches the URL path ids or the request
# body — the literal appointment/customer/vehicle ids below never reach the database and are safe
# sentinels, not seed-row references.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@RunId = {{$timestamp}}
@UnauthIntakeVin = TST{{RunId.toString().slice(-10)}}0601
@UnauthUpdateVin = TST{{RunId.toString().slice(-10)}}0602


# ─────────────────────────────────────────────────────────────

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Negative][Appointments] Unauthenticated list appointments (401 expected)
GET {{AutoService_ApiService_HostAddress}}/api/appointments?year=2026&month=4

?? status == 401

###

### [Negative][Appointments] Unauthenticated list today's appointments (401 expected)
GET {{AutoService_ApiService_HostAddress}}/api/appointments/today

?? status == 401

###

### [Negative][Appointments] Unauthenticated intake create (401 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "customerEmail": "unauth.intake.{{RunId}}@example.test",
  "customerFirstName": "Unauth",
  "customerLastName": "Intake",
  "vehicle": {
    "licensePlate": "UNAUTH-{{RunId}}",
    "vin": "{{UnauthIntakeVin}}",
    "brand": "Ghost",
    "model": "Rider",
    "year": 2020,
    "mileageKm": 0,
    "enginePowerKw": 74,
    "drivetrainType": "Petrol"
  },
  "scheduledDate": "2026-04-30T10:00:00",
  "dueDateTime": "2026-05-01T10:00:00",
  "taskDescription": "Unauthenticated intake should be blocked"
}

?? status == 401

###

### [Negative][Appointments] Unauthenticated appointment update (401 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/1
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "dueDateTime": "2026-05-01T10:00:00",
  "taskDescription": "Unauthenticated update should be blocked"
}

?? status == 401

###

### [Negative][Appointments] Unauthenticated appointment vehicle update (401 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/1/vehicle
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "UNAUTH-401",
  "vin": "{{UnauthUpdateVin}}",
  "brand": "Ghost",
  "model": "Rider",
  "year": 2020,
  "mileageKm": 0,
  "enginePowerKw": 74,
  "drivetrainType": "Petrol"
}

?? status == 401

###

### [Negative][Appointments] Unauthenticated appointment status update (401 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/1/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "InProgress"
}

?? status == 401

###

### [Negative][Appointments] Unauthenticated claim (401 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/1/claim
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Negative][Appointments] Unauthenticated unclaim (401 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/1/claim
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Negative][Appointments] Unauthenticated admin assign mechanic to appointment (401 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/1/assign/2
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Negative][Appointments] Unauthenticated admin unassign mechanic from appointment (401 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/1/assign/2
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Negative][Appointments] Unauthenticated admin create appointment for customer (401 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/1/appointments
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "vehicleId": 1,
  "scheduledDate": "2026-04-30T10:00:00",
  "taskDescription": "Unauthenticated admin create should be blocked",
  "mechanicIds": [1]
}

?? status == 401
