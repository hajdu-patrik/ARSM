# Every id is resolved/created at run time. Locked-state and non-admin authz coverage split into the
# sibling admin-assign-unassign-locked-state.http/admin-assign-unassign-authz.http files (file-size limit).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@RunId = {{$timestamp}}
@SecondaryMechanicEmail = appt.assign.secondary.{{RunId}}@example.test


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin (session prerequisite for AdminOnly endpoints, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

@AdminMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Resolve a customer that owns a vehicle (200 expected)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Setup][Appointments] Resolve one of that customer's vehicles (200 expected)
@SeedCustomerId = {{seedCustomers.find(c => c.vehicleCount > 0).id}}
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/vehicles

?? status == 200

###

### [Setup][Appointments] Register disposable secondary mechanic for the assign/unassign flow (200 expected)
# @name secondaryMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "ApptAssign",
  "lastName": "Secondary",
  "email": "{{SecondaryMechanicEmail}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

@SecondaryMechanicId = {{secondaryMechanic.personId}}

### [Setup][Appointments] Create appointment with a single assigned mechanic for the assign/unassign flow (201 expected)
# @name singleAssignedApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{seedVehicles[0].id}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Assign/unassign fixture: single-mechanic appointment",
  "mechanicIds": [{{AdminMechanicId}}]
}

?? status == 201

###

@SingleAssignedApptId = {{singleAssignedApptCreate.id}}

### [Positive][Appointments] Admin assign mechanic to appointment (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}/assign/{{SecondaryMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Positive][Appointments] Admin unassign mechanic from appointment (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}/assign/{{SecondaryMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Negative][Appointments] Admin cannot unassign last mechanic from appointment (422 expected)
# SingleAssignedApptId's sole mechanic is AdminMechanicId, hence last_assigned_mechanic.
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}/assign/{{AdminMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == last_assigned_mechanic
###

### [Negative][Appointments] Admin assign to non-existent appointment (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999/assign/{{SecondaryMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found
###

### [Negative][Appointments] Admin assign non-existent mechanic (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}/assign/99999
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == mechanic_not_found
###

### [Negative][Appointments] Admin assign mechanic already assigned (409 expected)
# AdminMechanicId is still SingleAssignedApptId's sole mechanic, hence already_assigned.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}/assign/{{AdminMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 409
?? js response.parsedBody.code == already_assigned
###

### [Negative][Appointments] Admin unassign from non-existent appointment (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/99999/assign/{{AdminMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found
###

### [Negative][Appointments] Admin unassign mechanic not assigned to appointment (409 expected)
# SecondaryMechanicId was unassigned from SingleAssignedApptId above, hence not_assigned.
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}/assign/{{SecondaryMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 409
?? js response.parsedBody.code == not_assigned
###

### [Cleanup][Appointments] Delete the disposable secondary mechanic (200 expected)
# Safe: SecondaryMechanicId is unassigned from SingleAssignedApptId by this point, so the deletion
# invariant in AdminEndpoints.Handlers.cs (no appointment left with zero mechanics) does not block it.
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{SecondaryMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Cleanup][Appointments] Delete the fixture appointment created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
