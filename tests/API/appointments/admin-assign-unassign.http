# PUT/DELETE /api/appointments/{id}/assign/{mechanicId} (AdminOnly) on an InProgress appointment. Closed states are in
# admin-assign-unassign-locked-state.http, non-admin 403 in -authz.http. The fixture appointment and mechanic are deleted here.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@FixtureCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@RunId = {{$timestamp}}
@SecondaryMechanicEmail = appt.assign.secondary.{{RunId}}@example.test

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as admin (session prerequisite for AdminOnly endpoints, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the shared fixture customer and its vehicle (200 expected)
# @name fixtureCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{FixtureCustomerEmail}}

?? status == 200

### [Setup][Appointments] Register disposable secondary mechanic for the assign/unassign flow (200 expected)
# @name secondaryMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "ApptAssign", "lastName": "Secondary", "email": "{{SecondaryMechanicEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 200

### [Setup][Appointments] Create appointment with a single assigned mechanic (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Assign/unassign fixture: single-mechanic appointment", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 201

### [Positive][Appointments] Admin assigns a second mechanic (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/assign/{{secondaryMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200
?? js response.parsedBody.mechanics.length == 2
?? js (response.parsedBody.mechanics.some(m => m.id == secondaryMechanic.personId) && response.parsedBody.mechanics.some(m => m.id == adminLogin.personId)) == true
?? js response.parsedBody.status == InProgress

### [Negative][Appointments] Assigning the same mechanic again is a conflict (409, already_assigned)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/assign/{{secondaryMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 409
?? js response.parsedBody.code == already_assigned

### [Positive][Appointments] Admin unassigns the second mechanic and the admin stays (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/assign/{{secondaryMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200
?? js response.parsedBody.mechanics.length == 1
?? js (response.parsedBody.mechanics[0].id == adminLogin.personId) == true

### [Negative][Appointments] Admin cannot unassign the last mechanic (422, last_assigned_mechanic)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/assign/{{adminLogin.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == last_assigned_mechanic

### [Negative][Appointments] Unassigning a mechanic that is not assigned is a conflict (409, not_assigned)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/assign/{{secondaryMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 409
?? js response.parsedBody.code == not_assigned

### [Negative][Appointments] Assigning to an unknown appointment (404, appointment_not_found)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999999/assign/{{secondaryMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found

### [Negative][Appointments] Assigning an unknown mechanic (404, mechanic_not_found)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/assign/99999999
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == mechanic_not_found

### [Negative][Appointments] Unassigning from an unknown appointment (404, appointment_not_found)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/99999999/assign/{{adminLogin.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found

### [Positive][Appointments] The refused calls left exactly the admin assigned (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments?descending=true

?? status == 200
?? js (response.parsedBody.find(a => a.id == apptCreate.id).mechanics.length == 1) == true

### [Cleanup][Appointments] Delete the disposable secondary mechanic (200 expected)
# Safe: it is unassigned by now, so the zero-mechanics deletion invariant does not block it.
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{secondaryMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

### [Cleanup][Appointments] Delete the fixture appointment created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
