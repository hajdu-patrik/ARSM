# Status PUT as the assigned plain mechanic (intake assigns the caller): no-op, case-insensitive names, Cancelled stamps
# and the invalid values. Completed and reopen: appointment-lifecycle.http, -reopen.http; non-assigned 403: appointment-edit-access.http.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@RunId = {{$timestamp}}
@CustomerEmail = status.transitions.{{RunId}}@example.test

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as the plain mechanic (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Create the disposable customer (201 expected)
# @name customer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Status", "middleName": null, "lastName": "Transitions", "email": "{{CustomerEmail}}", "phoneNumber": null }

?? status == 201

### [Setup][Appointments] Create the disposable customer's vehicle (201 expected)
# @name vehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "MST-{{RunId}}", "vin": "TST{{RunId.toString().slice(-10)}}0705", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

### [Setup][Appointments] Create an appointment via intake, auto-assigned to this mechanic (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{CustomerEmail}}", "vehicleId": {{vehicle.id}}, "scheduledDate": "2026-04-19T09:00:00", "dueDateTime": "2026-04-20T09:00:00", "taskDescription": "Status-transitions fixture" }

?? status == 201

### [Positive][Appointments] InProgress on an InProgress appointment is a no-op that keeps the version (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "InProgress", "version": {{apptCreate.version}} }

?? status == 200
?? js response.parsedBody.status == InProgress
?? js (response.parsedBody.version == apptCreate.version) == true

### [Positive][Appointments] The status name is case-insensitive and Cancelled stamps canceledAt (200 expected)
# @name cancelledAppt
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "cancelled", "version": {{apptCreate.version}} }

?? status == 200
?? js response.parsedBody.status == Cancelled
?? js (response.parsedBody.canceledAt != null) == true
?? js (response.parsedBody.completedAt == null) == true
?? js response.parsedBody.canComplete == false
?? js response.parsedBody.canLinkQuote == false
?? js response.parsedBody.canDelete == true
?? js (response.parsedBody.version != apptCreate.version) == true

### [Positive][Appointments] Cancelled on a Cancelled appointment is a no-op that keeps the stamp (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Cancelled", "version": {{cancelledAppt.version}} }

?? status == 200
?? js (response.parsedBody.canceledAt != null) == true
?? js (response.parsedBody.version == cancelledAppt.version) == true

### [Negative][Appointments] An unknown status name is refused (400, invalid_status)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Scheduled", "version": {{cancelledAppt.version}} }

?? status == 400
?? js response.parsedBody.code == invalid_status
?? js response.parsedBody.error includes InProgress, Completed, Cancelled

### [Negative][Appointments] A missing status is refused (400, invalid_status)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "version": {{cancelledAppt.version}} }

?? status == 400
?? js response.parsedBody.code == invalid_status

### [Negative][Appointments] An empty status is refused (400, invalid_status)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "", "version": {{cancelledAppt.version}} }

?? status == 400
?? js response.parsedBody.code == invalid_status

### [Negative][Appointments] An unknown appointment is refused (404, appointment_not_found)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999999/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "InProgress", "version": 1 }

?? status == 404
?? js response.parsedBody.code == appointment_not_found

### [Positive][Appointments] The refused changes left the appointment Cancelled (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/appointments

?? status == 200
?? js (response.parsedBody.find(a => a.id == apptCreate.id).status == "Cancelled") == true

### [Negative][Appointments] A numeric status outside the enum is refused, not stored (400, invalid_status)
# "99" parses as a number but names no status, so it must be rejected like an unknown name.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "99", "version": {{cancelledAppt.version}} }

?? status == 400
?? js response.parsedBody.code == invalid_status

### [Cleanup][Appointments] Login as admin to delete the disposable customer (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Cleanup][Appointments] Delete the disposable customer, cascading its vehicle and appointment (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
