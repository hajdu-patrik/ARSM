# ─────────────────────────────────────────────────────────────
# APPOINTMENTS - STATUS TRANSITIONS & NON-ADMIN AUTHZ
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@ApptId = 1
@PastCancelledApptId = 5
@NonAssignedApptId = 3


# ─────────────────────────────────────────────────────────────

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

###

### [Positive][Appointments] Update appointment status to InProgress (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "InProgress"
}

###

### [Positive][Appointments] Update appointment status to Completed (200 expected)
# Response includes completedAt (DateTime) and canceledAt (null).
### [Case][Appointments] PUT /api/appointments/{{ApptId}}/status

PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Completed"
}

###

### [Negative][Appointments] Claim completed appointment is rejected (422 expected)
# Self-claim is only allowed for InProgress appointments.
# Expected error code: appointment_completed.
### [Case][Appointments] PUT /api/appointments/{{ApptId}}/claim

PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/claim
Origin: {{WebUI_Origin}}

###

### [Positive][Appointments] Update appointment status to Cancelled (200 expected)
# Response includes canceledAt (DateTime) and completedAt (null).
### [Case][Appointments] PUT /api/appointments/{{PastCancelledApptId}}/status

PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Cancelled"
}

###

### [Positive][Appointments] Reopen cancelled appointment to InProgress (past-cancelled remains editable, 200 expected)
# Cancelled appointments can be moved back to active states even after cancellation.
### [Case][Appointments] PUT /api/appointments/{{PastCancelledApptId}}/status

PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "InProgress"
}

###

### [Positive][Appointments] Move reopened appointment to Completed (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Completed"
}

###

### [Negative][Appointments] Update appointment status with invalid value (400 expected)
# Valid statuses are: InProgress, Completed, Cancelled. "Scheduled" is no longer valid.
### [Case][Appointments] PUT /api/appointments/{{ApptId}}/status

PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Scheduled"
}

###

### [Negative][Appointments] Update non-existent appointment status (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "InProgress"
}

###

# Preconditions: NonAssignedApptId exists and the logged-in mechanic is not assigned to it.
### [Negative][Appointments] Non-assigned mechanic cannot change appointment status (403 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{NonAssignedApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Completed"
}

###

# Preconditions: NonAssignedApptId exists and the logged-in mechanic is not assigned to it.
### [Negative][Appointments] Non-assigned non-admin mechanic cannot update appointment (403 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{NonAssignedApptId}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "dueDateTime": "2030-01-03T16:15:00",
  "taskDescription": "Forbidden update attempt by non-assigned mechanic"
}
