# UpdateStatusAsync has no admin bypass - the caller must be an assigned mechanic - so fixtures are
# created via intake (auto-assigns the caller). Non-assigned 403 coverage is the sibling mechanic-status-transitions-authz.http (file-size limit); both are deleted at the end.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Appointments] Resolve the known customer's own vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

###

@KnownCustomerVehicleId = {{knownCustomer.vehicles[0].id}}

### [Setup][Appointments] Create an appointment via intake, auto-assigned to this mechanic (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{KnownCustomerVehicleId}},
  "scheduledDate": "2026-04-19T09:00:00",
  "dueDateTime": "2026-04-20T09:00:00",
  "taskDescription": "Status-transitions fixture: main appointment"
}

?? status == 201

###

@ApptId = {{apptCreate.id}}

### [Setup][Appointments] Create a second appointment via intake for the cancel/reopen flow (201 expected)
# @name pastCancelledApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{KnownCustomerVehicleId}},
  "scheduledDate": "2026-04-19T09:00:00",
  "dueDateTime": "2026-04-20T09:00:00",
  "taskDescription": "Status-transitions fixture: cancel/reopen appointment"
}

?? status == 201

###

@PastCancelledApptId = {{pastCancelledApptCreate.id}}

### [Positive][Appointments] Update appointment status to InProgress (200 expected, no-op since intake already sets it)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "InProgress"
}

?? status == 200

###

### [Positive][Appointments] Update appointment status to Completed (200 expected)
# Response includes completedAt (DateTime) and canceledAt (null).
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Completed"
}

?? status == 200

###

### [Negative][Appointments] Claim completed appointment is rejected (422 expected)
# Self-claim is only allowed for InProgress appointments.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == appointment_completed
###

### [Positive][Appointments] Update appointment status to Cancelled (200 expected)
# Response includes canceledAt (DateTime) and completedAt (null).
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Cancelled"
}

?? status == 200

###

### [Positive][Appointments] Reopen cancelled appointment to InProgress (200 expected)
# Cancelled appointments can be moved back to active states even after cancellation.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "InProgress"
}

?? status == 200

###

### [Positive][Appointments] Move reopened appointment to Completed (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Completed"
}

?? status == 200

###

### [Negative][Appointments] Update appointment status with invalid value (400 expected)
# Valid statuses are: InProgress, Completed, Cancelled. "Scheduled" is no longer valid.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Scheduled"
}

?? status == 400

###

### [Negative][Appointments] Update non-existent appointment status (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "InProgress"
}

?? status == 404

###

### [Cleanup][Appointments] Login as admin to delete the fixture appointments (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# CSRF double-submit token for the cleanup deletes below (see tests/CLAUDE.md Core Rules).

### [Cleanup][Appointments] Delete the two fixture appointments created above (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
