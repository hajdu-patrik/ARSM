# Claim/unclaim refusals: Cancelled appointment, unknown id, the last mechanic and a repeat claim. Not-assigned and the
# happy path are in mechanic-claim-unclaim.http. Fixtures come from intake (caller auto-assigned) and the admin deletes them.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the known customer's own vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

### [Setup][Appointments] Create an appointment via intake for the cancel-then-claim/unclaim checks (201 expected)
# @name cancelTargetCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-19T09:00:00", "dueDateTime": "2026-04-20T09:00:00", "taskDescription": "Claim/unclaim edge-case fixture: cancel then claim/unclaim" }

?? status == 201

### [Setup][Appointments] Create a sole-mechanic appointment for the last-mechanic unclaim check (201 expected)
# @name soleMechanicCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-19T09:00:00", "dueDateTime": "2026-04-20T09:00:00", "taskDescription": "Claim/unclaim edge-case fixture: sole mechanic" }

?? status == 201

### [Setup][Appointments] Cancel the first appointment (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{cancelTargetCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Cancelled", "version": {{cancelTargetCreate.version}} }

?? status == 200

### [Negative][Appointments] Unclaim of a Cancelled appointment is refused (422, appointment_cancelled)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{cancelTargetCreate.id}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == appointment_cancelled

### [Negative][Appointments] Claim of a Cancelled appointment is refused (422, appointment_cancelled)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{cancelTargetCreate.id}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == appointment_cancelled

### [Negative][Appointments] Claim of an unknown appointment (404, appointment_not_found)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999999/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found

### [Negative][Appointments] Unclaim of an unknown appointment (404, appointment_not_found)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/99999999/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found

### [Negative][Appointments] Claim by the mechanic that is already the assignee (409, already_claimed)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{soleMechanicCreate.id}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 409
?? js response.parsedBody.code == already_claimed

### [Negative][Appointments] The last mechanic cannot unclaim (422, last_assigned_mechanic)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{soleMechanicCreate.id}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == last_assigned_mechanic

### [Positive][Appointments] The refused unclaim left the mechanic assigned (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{knownCustomer.id}}/appointments?descending=true

?? status == 200
?? js (response.parsedBody.find(a => a.id == soleMechanicCreate.id).mechanics.length == 1) == true

### [Cleanup][Appointments] Login as admin to delete the fixture appointments (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Cleanup][Appointments] Delete the two fixture appointments (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{cancelTargetCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{soleMechanicCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
