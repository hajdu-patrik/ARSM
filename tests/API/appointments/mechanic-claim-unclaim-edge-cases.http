# Split out of mechanic-claim-unclaim.http; not-assigned-to-me coverage is the sibling
# mechanic-claim-unclaim-not-assigned.http (file-size limit). Fixtures are created via intake (auto-assigns the caller as sole mechanic) and deleted at the end via admin.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Appointments] Resolve the known customer's own vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

###

@KnownCustomerVehicleId = {{knownCustomer.vehicles[0].id}}

### [Setup][Appointments] Create an appointment via intake for the cancel-then-claim/unclaim checks (201 expected)
# @name pastCancelledApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{KnownCustomerVehicleId}},
  "scheduledDate": "2026-04-19T09:00:00",
  "dueDateTime": "2026-04-20T09:00:00",
  "taskDescription": "Claim/unclaim edge-case fixture: cancel then claim/unclaim"
}

?? status == 201

###

@PastCancelledApptId = {{pastCancelledApptCreate.id}}

### [Setup][Appointments] Create a sole-mechanic appointment for the last-mechanic unclaim check (201 expected)
# @name singleAssignedApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "customerEmail": "{{KnownCustomerEmail}}",
  "vehicleId": {{KnownCustomerVehicleId}},
  "scheduledDate": "2026-04-19T09:00:00",
  "dueDateTime": "2026-04-20T09:00:00",
  "taskDescription": "Claim/unclaim edge-case fixture: sole mechanic"
}

?? status == 201

###

@SingleAssignedApptId = {{singleAssignedApptCreate.id}}

### [Setup][Appointments] Cancel appointment for unclaim-cancelled/claim-cancelled checks (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Cancelled"
}

?? status == 200

###

### [Negative][Appointments] Unclaim cancelled appointment is rejected (422 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == appointment_cancelled
###

### [Negative][Appointments] Claim cancelled appointment is rejected (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == appointment_cancelled
###

### [Negative][Appointments] Claim non-existent appointment (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

### [Negative][Appointments] Unclaim non-existent appointment (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/99999/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found
###

### [Negative][Appointments] Mechanic cannot unclaim when appointment would have zero mechanics (422 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}/claim
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422
?? js response.parsedBody.code == last_assigned_mechanic
###

### [Cleanup][Appointments] Login as admin to delete the fixture appointments (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# CSRF double-submit token for the cleanup deletes below (see tests/CLAUDE.md Core Rules).

### [Cleanup][Appointments] Delete the two fixture appointments created above (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastCancelledApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{SingleAssignedApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
