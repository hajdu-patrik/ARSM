# A cancelled appointment reopens to InProgress (stamps cleared) and, with an Accepted linked quote, completes (stamps set).
# Completed is terminal, so the disposable customer is deleted at the end by the admin (cascade).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@RunId = {{$timestamp}}
@FixtureCustomerEmail = status.reopen.{{RunId}}@example.test
@FixtureVehicleVin = TST{{RunId.toString().slice(-10)}}0706

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the fixture part OLF-1001 for the quote line (200 expected)
# @name fixturePart
GET {{AutoService_ApiService_HostAddress}}/api/parts?search=OLF-1001&pageSize=500

{{
  exports.PartId = fixturePart.items.find(p => p.partNumber === 'OLF-1001').id;
}}

?? status == 200

### [Setup][Appointments] Create the disposable customer (201 expected)
# @name customer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Status", "middleName": null, "lastName": "Reopen", "email": "{{FixtureCustomerEmail}}", "phoneNumber": null }

?? status == 201

### [Setup][Appointments] Create the disposable customer's vehicle (201 expected)
# @name vehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "MSR-{{RunId}}", "vin": "{{FixtureVehicleVin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

### [Setup][Appointments] Create an appointment via intake for the cancel/reopen flow (201 expected)
# @name pastCancelledApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{FixtureCustomerEmail}}", "vehicleId": {{vehicle.id}}, "scheduledDate": "2026-04-19T09:00:00", "dueDateTime": "2026-04-20T09:00:00", "taskDescription": "Status-transitions fixture: cancel/reopen appointment" }

?? status == 201

### [Positive][Appointments] Update appointment status to Cancelled (200 expected)
# @name cancelledAppt
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{pastCancelledApptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Cancelled", "version": {{pastCancelledApptCreate.version}} }

?? status == 200
?? js response.parsedBody.status == Cancelled
?? js (response.parsedBody.canceledAt != null) == true
?? js (response.parsedBody.completedAt == null) == true

### [Positive][Appointments] Reopen the cancelled appointment to InProgress and clear the stamp (200 expected)
# @name reopenedAppt
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{pastCancelledApptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "InProgress", "version": {{cancelledAppt.version}} }

?? status == 200
?? js response.parsedBody.status == InProgress
?? js (response.parsedBody.canceledAt == null) == true
?? js response.parsedBody.canLinkQuote == true
?? js response.parsedBody.canDelete == true

### [Setup][Appointments] Create a draft quote linked to the reopened appointment (201 expected)
# @name quote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{vehicle.id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Status reopen quote {{RunId}}", "appointmentId": {{pastCancelledApptCreate.id}} }

?? status == 201

### [Setup][Appointments] Add the catalog part line so the quote can be sent (201 expected)
# @name quoteLine
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{quote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "lineKind": "Part", "quantity": 1, "partId": {{PartId}}, "version": {{quote.version}} }

?? status == 201

### [Setup][Appointments] Send the quote (200 expected, no-op mail sender in the test environment)
# @name quoteSent
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{quote.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Sent", "version": {{quoteLine.version}} }

?? status == 200

### [Setup][Appointments] Accept the quote, so the appointment may be completed (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{quote.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Accepted", "version": {{quoteSent.version}} }

?? status == 200

### [Positive][Appointments] Move the reopened appointment to Completed and stamp completedAt (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{pastCancelledApptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Completed", "version": {{reopenedAppt.version}} }

?? status == 200
?? js response.parsedBody.status == Completed
?? js (response.parsedBody.completedAt != null) == true
?? js (response.parsedBody.canceledAt == null) == true
?? js response.parsedBody.canDelete == false
?? js response.parsedBody.canLinkQuote == false

### [Cleanup][Appointments] Login as admin to delete the disposable customer (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Cleanup][Appointments] Delete the disposable customer, cascading its vehicle, appointment and quote (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
