# Non-admin mechanics get 403 on POST /api/customers/{id}/appointments (401 coverage in appointments-unauth.http);
# AdminOnly rejects before reading ids, but real ones are resolved to keep the fixture reusable. CSRF token is still required: without it, CsrfDoubleSubmitMiddleware would 403 for the wrong reason.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as non-admin mechanic (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# CSRF double-submit token for the unsafe request below (see tests/CLAUDE.md Core Rules).

### [Setup][Appointments] Resolve a customer that owns a vehicle (200 expected, GET /api/customers is plain-authenticated)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Setup][Appointments] Resolve one of that customer's vehicles (200 expected)
@CustomerId = {{seedCustomers.find(c => c.vehicleCount > 0).id}}
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/vehicles

?? status == 200

###

### [Negative][Appointments] Non-admin mechanic cannot create appointment for customer (403 expected)
# POST /api/customers/{customerId}/appointments requires AdminOnly policy.
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{seedVehicles[0].id}},
  "scheduledDate": "2026-04-30T10:00:00",
  "dueDateTime": "2026-05-01T10:00:00",
  "taskDescription": "Non-admin create attempt — should be rejected with 403",
  "mechanicIds": [1]
}

?? status == 403
