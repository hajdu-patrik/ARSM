# Intake email, task and schedule rules on an otherwise valid request (known customer and its own vehicle).
# Every case is refused before anything is written, so there is nothing to clean up.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as the plain mechanic (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the known customer and its vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

### [Negative][Appointments] A missing customer email is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake no email" }

?? status == 422
?? js (response.parsedBody.detail === "Email must be a valid email address.") == true

### [Negative][Appointments] A malformed customer email is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "not-an-email", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake bad email" }

?? status == 422
?? js (response.parsedBody.detail === "Email must be a valid email address.") == true

### [Negative][Appointments] A blank task description is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "   " }

?? status == 422
?? js (response.parsedBody.detail === "TaskDescription is required.") == true

### [Negative][Appointments] A task description of 201 characters is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "{{'a'.repeat(201)}}" }

?? status == 422
?? js (response.parsedBody.detail === "TaskDescription must be at most 200 characters.") == true

### [Negative][Appointments] A missing scheduledDate is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "Intake no scheduled date" }

?? status == 422
?? js (response.parsedBody.detail === "ScheduledDate is required.") == true

### [Negative][Appointments] A missing dueDateTime is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-23T10:00:00", "taskDescription": "Intake no due date" }

?? status == 422
?? js (response.parsedBody.detail === "DueDateTime is required.") == true

### [Negative][Appointments] dueDateTime one second before scheduledDate is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-24T10:00:00", "dueDateTime": "2026-04-24T09:59:59", "taskDescription": "Intake due before scheduled" }

?? status == 422
?? js (response.parsedBody.detail === "DueDateTime must be greater than or equal to ScheduledDate.") == true

### [Negative][Appointments] The comparison is made in UTC, so a +02:00 due time earlier than the UTC start is refused (422 expected)
# 11:30+02:00 is 09:30 UTC, before the 10:00 UTC start.
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-24T10:00:00Z", "dueDateTime": "2026-04-24T11:30:00+02:00", "taskDescription": "Intake offset due before scheduled" }

?? status == 422
?? js (response.parsedBody.detail === "DueDateTime must be greater than or equal to ScheduledDate.") == true
