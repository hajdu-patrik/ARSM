# POST negative-validation coverage moved to the sibling admin-create-validation.http (file-size limit).
# PrimaryMechanicId is the admin's own person_id; PastScheduledApptId/ApptId are created and deleted here (admin create allows any ScheduledDate, including past).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
# Freshly generated, never-before-seen plate/VIN for the positive vehicle update below: reusing a real
# seeded plate/VIN would collide with whichever demo vehicle actually owns it (409 instead of 200).
@PastLicensePlate = PST-{{RunId}}
@PastVehicleVin = TST{{RunId.toString().slice(-10)}}0701
# SeedVehicleVin only appears in a negative test whose mileageKm/enginePowerKw violation is caught
# before the handler ever reaches VIN validation, so a real seeded VIN here is harmless.
@SeedVehicleVin = WVWZZZAUZJW123456


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin (session prerequisite for AdminOnly create endpoint, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

@PrimaryMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Resolve a customer that owns a vehicle (200 expected)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Setup][Appointments] Resolve one of that customer's vehicles (200 expected)
@CustomerId = {{seedCustomers.find(c => c.vehicleCount > 0).id}}
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/vehicles

?? status == 200

###

@CustomerVehicleId = {{seedVehicles[0].id}}

### [Setup][Appointments] Create an appointment with a past scheduled date (201 expected)
# @name pastScheduledApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2020-06-15T09:00:00",
  "taskDescription": "Update-validation fixture: past scheduled appointment",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 201

###

@PastScheduledApptId = {{pastScheduledApptCreate.id}}

### [Setup][Appointments] Create an appointment for the vehicle-numeric-max negative check (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Update-validation fixture: numeric-max check",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 201

###

@ApptId = {{apptCreate.id}}

### [Positive][Appointments] Admin updates past appointment dueDateTime/taskDescription (200 expected)
# Confirms past appointments remain editable.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastScheduledApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2030-01-03T16:15:00",
  "taskDescription": "Past appointment due and task update allowed"
}

?? status == 200

###

### [Positive][Appointments] Admin updates past appointment vehicle details (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastScheduledApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "{{PastLicensePlate}}",
  "vin": "{{PastVehicleVin}}",
  "brand": "Ford",
  "model": "Focus",
  "year": 2016,
  "mileageKm": 167800,
  "enginePowerKw": 92,
  "drivetrainType": "Petrol"
}

?? status == 200

###

### [Negative][Appointments] Admin update rejects vehicle numeric values above max limits (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "ABC-101",
  "vin": "{{SeedVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 1000001,
  "enginePowerKw": 50001,
  "drivetrainType": "Petrol"
}

?? status == 422

###

### [Cleanup][Appointments] Delete the two fixture appointments created above (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{PastScheduledApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
