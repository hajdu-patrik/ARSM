# Both history routes sit under plain RequireAuthorization(), so any authenticated mechanic reaches them.
# SeedCustomerId/SeedVehicleId resolve from a real customer at run time, never a literal id, since earlier suites may delete lower-numbered demo rows.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@NonExistentCustomerId = 99999
@NonExistentVehicleId = 99999


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as non-admin mechanic (history endpoints require authenticated user, 200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# CSRF double-submit token for the unsafe request below (see tests/CLAUDE.md Core Rules).

### [Setup][Appointments] Resolve a seeded customer that owns a vehicle (200 expected)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Setup][Appointments] Resolve one of that customer's vehicles (200 expected)
@SeedCustomerId = {{seedCustomers.find(c => c.vehicleCount > 0).id}}
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/vehicles

?? status == 200

###

### [Positive][Appointments] Get customer repair history oldest-first (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/appointments

?? status == 200

###

### [Positive][Appointments] Get customer repair history newest-first (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/appointments?descending=true

?? status == 200

###

### [Positive][Appointments] Get vehicle repair history oldest-first (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{seedVehicles[0].id}}/appointments

?? status == 200

###

### [Positive][Appointments] Get vehicle repair history newest-first (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{seedVehicles[0].id}}/appointments?descending=true

?? status == 200

###

### [Negative][Appointments] Unknown customer history returns 404
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentCustomerId}}/appointments

?? status == 404

###

### [Negative][Appointments] Unknown vehicle history returns 404
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentVehicleId}}/appointments

?? status == 404

###

### [Setup][Appointments] Logout to verify unauthenticated behavior (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Appointments] Unauthenticated customer history returns 401
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/appointments

?? status == 401

###

### [Negative][Appointments] Unauthenticated vehicle history returns 401
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{seedVehicles[0].id}}/appointments

?? status == 401
