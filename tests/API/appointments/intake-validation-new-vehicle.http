# Inline-vehicle rules of an intake (a new customer with an otherwise valid request). The checks run before
# the transaction, so nothing persists and there is nothing to clean up. Customer fields: intake-validation-new-customer.http.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@RunId = {{$timestamp}}
@Vin = TST{{RunId.toString().slice(-10)}}1501

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as the plain mechanic (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Negative][Appointments] Missing required vehicle fields (brand and model absent) (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "intake.veh.0.{{RunId}}@example.test", "customerFirstName": "Intake", "customerLastName": "Vehicle", "vehicle": { "licensePlate": "VF-{{RunId}}", "vin": "{{Vin}}", "year": 2018, "mileageKm": 60000, "enginePowerKw": 81, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-24T10:00:00", "dueDateTime": "2026-04-25T10:00:00", "taskDescription": "Intake vehicle rule" }

?? status == 422
?? js (response.parsedBody.detail === "Vehicle.LicensePlate, Vehicle.Vin, Vehicle.Brand, Vehicle.Model, and Vehicle.DrivetrainType are required.") == true

### [Negative][Appointments] A license plate over 20 characters (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "intake.veh.1.{{RunId}}@example.test", "customerFirstName": "Intake", "customerLastName": "Vehicle", "vehicle": { "licensePlate": "{{'P'.repeat(21)}}", "vin": "{{Vin}}", "brand": "Ford", "model": "Focus", "year": 2018, "mileageKm": 60000, "enginePowerKw": 81, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-24T10:00:00", "dueDateTime": "2026-04-25T10:00:00", "taskDescription": "Intake vehicle rule" }

?? status == 422
?? js (response.parsedBody.detail === "Vehicle.LicensePlate must be at most 20 characters.") == true

### [Negative][Appointments] A brand over 50 characters (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "intake.veh.2.{{RunId}}@example.test", "customerFirstName": "Intake", "customerLastName": "Vehicle", "vehicle": { "licensePlate": "VB-{{RunId}}", "vin": "{{Vin}}", "brand": "{{'B'.repeat(51)}}", "model": "Focus", "year": 2018, "mileageKm": 60000, "enginePowerKw": 81, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-24T10:00:00", "dueDateTime": "2026-04-25T10:00:00", "taskDescription": "Intake vehicle rule" }

?? status == 422
?? js (response.parsedBody.detail === "Vehicle.Brand must be at most 50 characters.") == true

