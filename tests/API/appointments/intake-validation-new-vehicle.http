{ "customerEmail": "intake.veh.3.{{RunId}}@example.test", "customerFirstName": "Intake", "customerLastName": "Vehicle", "vehicle": { "licensePlate": "VM-{{RunId}}", "vin": "{{Vin}}", "brand": "Ford", "model": "{{'M'.repeat(51)}}", "year": 2018, "mileageKm": 60000, "enginePowerKw": 81, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-24T10:00:00", "dueDateTime": "2026-04-25T10:00:00", "taskDescription": "Intake vehicle rule" }

