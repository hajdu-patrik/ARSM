Content-Type: application/json

{ "customerEmail": "intake.veh.4.{{RunId}}@example.test", "customerFirstName": "Intake", "customerLastName": "Vehicle", "vehicle": { "licensePlate": "VY-{{RunId}}", "vin": "{{Vin}}", "brand": "Ford", "model": "Focus", "year": 1885, "mileageKm": 60000, "enginePowerKw": 81, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-24T10:00:00", "dueDateTime": "2026-04-25T10:00:00", "taskDescription": "Intake vehicle rule" }

