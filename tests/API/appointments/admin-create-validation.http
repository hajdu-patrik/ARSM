# ─────────────────────────────────────────────────────────────
# APPOINTMENTS - ADMIN CREATE-FOR-CUSTOMER VALIDATION
# ─────────────────────────────────────────────────────────────
# Split out of admin-create-update-validation.http (PUT/vehicle-update validation) to stay under the
# 250-line file limit. None of the cases below persist an appointment: ValidateCreateForCustomerRequest
# (AppointmentEndpoints.CustomerMutations.cs) rejects every payload here before any database write, so
# there is nothing to clean up. UnknownVehicleId/UnknownMechanicId stay 99999 sentinels per the plan;
# CustomerId/CustomerVehicleId and AnotherCustomerVehicleId (a vehicle owned by a *different* customer)
# are resolved from real rows.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@UnknownVehicleId = 99999
@UnknownMechanicId = 99999


# ─────────────────────────────────────────────────────────────

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin (session prerequisite for AdminOnly create endpoint, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

@PrimaryMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Resolve two customers that each own a vehicle (200 expected)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

@CustomerId = {{seedCustomers.filter(c => c.vehicleCount > 0)[0].id}}
@OtherCustomerId = {{seedCustomers.filter(c => c.vehicleCount > 0)[1].id}}

### [Setup][Appointments] Resolve CustomerId's own vehicle (200 expected)
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/vehicles

?? status == 200

###

@CustomerVehicleId = {{seedVehicles[0].id}}

### [Setup][Appointments] Resolve a vehicle owned by the other customer (200 expected)
# @name otherSeedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{OtherCustomerId}}/vehicles

?? status == 200

###

@AnotherCustomerVehicleId = {{otherSeedVehicles[0].id}}

### [Negative][Appointments] Admin create fails when customer does not exist (404 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/99999/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 404

###

### [Negative][Appointments] Admin create fails when vehicle is not owned by customer (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{AnotherCustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 422

###

### [Negative][Appointments] Admin create fails when vehicle does not exist (404 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{UnknownVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 404

###

### [Negative][Appointments] Admin create fails for empty mechanicIds (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": []
}

?? status == 422

###

### [Negative][Appointments] Admin create fails for duplicate mechanicIds (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [{{PrimaryMechanicId}}, {{PrimaryMechanicId}}]
}

?? status == 422

###

### [Negative][Appointments] Admin create fails for non-positive mechanicIds (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [0]
}

?? status == 422

###

### [Negative][Appointments] Admin create fails for empty taskDescription (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "   ",
  "mechanicIds": [{{PrimaryMechanicId}}]
}

?? status == 422

###

### [Negative][Appointments] Admin create fails for invalid mechanicIds (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{CustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{CustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Uj idopont felvetele admin oldalon",
  "mechanicIds": [{{UnknownMechanicId}}]
}

?? status == 422
