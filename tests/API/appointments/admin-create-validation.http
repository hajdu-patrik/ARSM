# POST /api/customers/{id}/appointments refusals (AdminOnly). Payload rules are checked first, then the customer,
# the vehicle and its owner, then the mechanics. Nothing is written, and the shared fixture customers are only read.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@FixtureCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@SecondCustomerEmail = fixture.second@example.test
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as admin (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the two shared fixture customers, each owning a vehicle (200 expected)
# @name fixtureCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{FixtureCustomerEmail}}

?? status == 200

###

# @name otherCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{SecondCustomerEmail}}

?? status == 200

### [Negative][Appointments] An unknown customer is refused (404 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/99999999/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create unknown customer", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 404
?? js (response.parsedBody.detail === "Customer not found.") == true

### [Negative][Appointments] A vehicle of another customer is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{otherCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create foreign vehicle", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 422
?? js (response.parsedBody.detail === "Vehicle does not belong to the specified customer.") == true

### [Negative][Appointments] An unknown vehicle is refused (404 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": 99999999, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create unknown vehicle", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 404
?? js (response.parsedBody.detail === "Vehicle not found.") == true

### [Negative][Appointments] vehicleId 0 is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": 0, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create vehicle zero", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 422
?? js (response.parsedBody.detail === "VehicleId must be a positive integer.") == true

### [Negative][Appointments] An empty mechanicIds list is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create no mechanic", "mechanicIds": [] }

?? status == 422
?? js (response.parsedBody.detail === "At least one mechanic must be assigned.") == true

### [Negative][Appointments] A missing mechanicIds field is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create mechanics missing" }

?? status == 422
?? js (response.parsedBody.detail === "At least one mechanic must be assigned.") == true

### [Negative][Appointments] Duplicate mechanicIds are refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create duplicate mechanic", "mechanicIds": [{{adminLogin.personId}}, {{adminLogin.personId}}] }

?? status == 422
?? js (response.parsedBody.detail === "MechanicIds must be unique.") == true

### [Negative][Appointments] A non-positive mechanic id is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create mechanic zero", "mechanicIds": [0] }

?? status == 422
?? js (response.parsedBody.detail === "MechanicIds must contain positive values only.") == true

### [Negative][Appointments] An unknown mechanic id is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create unknown mechanic", "mechanicIds": [99999999] }

?? status == 422
?? js (response.parsedBody.detail === "One or more mechanicIds are invalid.") == true

### [Negative][Appointments] A known plus an unknown mechanic id is refused as a whole (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Admin create partly unknown mechanics", "mechanicIds": [{{adminLogin.personId}}, 99999999] }

?? status == 422
?? js (response.parsedBody.detail === "One or more mechanicIds are invalid.") == true

### [Negative][Appointments] A blank task description is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "   ", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 422
?? js (response.parsedBody.detail === "TaskDescription is required.") == true

### [Negative][Appointments] A task description of 201 characters is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "{{'a'.repeat(201)}}", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 422
?? js (response.parsedBody.detail === "TaskDescription must be at most 200 characters.") == true

### [Negative][Appointments] A missing scheduledDate is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "taskDescription": "Admin create no schedule", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 422
?? js (response.parsedBody.detail === "ScheduledDate is required.") == true
