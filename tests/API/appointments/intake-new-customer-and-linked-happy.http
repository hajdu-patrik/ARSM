# Intake that creates the customer (email unknown) or resolves a mechanic email to its mechanic-owned customer. The new customer
# is deleted at the end (cascades its vehicle); for the mechanic-owned customer only the vehicle goes, that identity is shared.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@RunId = {{$timestamp}}
@NewCustomerEmail = scheduler.intake.new.{{RunId}}@example.test
@NewCustomerPlate = SCH-{{RunId}}
@NewCustomerVin = TST{{RunId.toString().slice(-10)}}0401
@MechanicFlowPlate = MEC-{{RunId}}
@MechanicFlowVin = TST{{RunId.toString().slice(-10)}}0403

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as the plain mechanic, the intake caller (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Positive][Appointments] Unknown email creates customer and vehicle, normalizing email, plate and phone (201 expected)
# Mixed-case padded email, lower-case plate and a national-format phone number are stored normalized.
# @name newCustomerApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "  Scheduler.Intake.NEW.{{RunId}}@Example.Test ", "customerFirstName": "Scheduler", "customerMiddleName": "Mid", "customerLastName": "New", "customerPhoneNumber": "06 30 1{{RunId.toString().slice(-6)}}", "vehicle": { "licensePlate": "sch-{{RunId}}", "vin": "{{NewCustomerVin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 98500, "enginePowerKw": 110, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-22T10:00:00", "dueDateTime": "2026-04-25T15:00:00", "taskDescription": "Scheduler intake new customer and vehicle" }

?? status == 201
?? js response.parsedBody.status == InProgress
?? js response.parsedBody.mechanics.length == 1
?? js (response.parsedBody.mechanics[0].id == nonAdminLogin.personId) == true
?? js response.parsedBody.vehicle.licensePlate == SCH-{{RunId}}
?? js (response.parsedBody.vehicle.vin == NewCustomerVin) == true
?? js response.parsedBody.vehicle.year == 2020
?? js response.parsedBody.vehicle.mileageKm == 98500
?? js response.parsedBody.vehicle.enginePowerKw == 110

### [Positive][Appointments] The created customer is stored with normalized email and E.164 phone (200 expected)
# @name createdCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{NewCustomerEmail}}

?? status == 200
?? js response.parsedBody.firstName == Scheduler
?? js response.parsedBody.middleName == Mid
?? js response.parsedBody.lastName == New
?? js (response.parsedBody.email == NewCustomerEmail) == true
?? js response.parsedBody.phoneNumber == +36301{{RunId.toString().slice(-6)}}
?? js response.parsedBody.vehicles.length == 1
?? js (response.parsedBody.id == newCustomerApptCreate.vehicle.customerId) == true

### [Positive][Appointments] A mechanic email resolves to the mechanic-owned customer and creates a vehicle (201 expected)
# The customer name comes from the mechanic account, so no name fields are sent.
# @name mechanicLinkedApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{NonAdminEmail}}", "vehicle": { "licensePlate": "{{MechanicFlowPlate}}", "vin": "{{MechanicFlowVin}}", "brand": "Seat", "model": "Leon", "year": 2019, "mileageKm": 151000, "enginePowerKw": 96, "drivetrainType": "PHEV" }, "scheduledDate": "2026-04-23T11:00:00", "dueDateTime": "2026-04-24T13:00:00", "taskDescription": "Scheduler intake mechanic email linked flow" }

?? status == 201
?? js response.parsedBody.vehicle.drivetrainType == PHEV
?? js (response.parsedBody.vehicle.customerId != newCustomerApptCreate.vehicle.customerId) == true

### [Positive][Appointments] The mechanic-owned customer is reused and takes its vehicle by id (201 expected)
# @name mechanicReuseApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{NonAdminEmail}}", "vehicleId": {{mechanicLinkedApptCreate.vehicle.id}}, "scheduledDate": "2026-04-23T14:00:00", "dueDateTime": "2026-04-24T16:00:00", "taskDescription": "Scheduler intake mechanic-owned customer reused" }

?? status == 201
?? js (response.parsedBody.vehicle.id == mechanicLinkedApptCreate.vehicle.id) == true
?? js (response.parsedBody.vehicle.customerId == mechanicLinkedApptCreate.vehicle.customerId) == true

### [Cleanup][Appointments] Login as admin to delete the fixtures (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Cleanup][Appointments] Delete the three fixture appointments (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{newCustomerApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{mechanicLinkedApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{mechanicReuseApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

### [Cleanup][Appointments] Delete the customer the first intake created, cascading its vehicle (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{newCustomerApptCreate.vehicle.customerId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

### [Cleanup][Appointments] Delete the vehicle of the mechanic-linked intake, never the shared customer (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{mechanicLinkedApptCreate.vehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
