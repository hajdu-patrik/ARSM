# DELETE /api/appointments/{id} (AdminOnly) hard-deletes the appointment, its mechanic assignments and its linked quotes
# (cascade); a Completed one is 409 (appointment-lifecycle.http), unauthenticated 401 is in appointments-unauth.http.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@FixtureCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as admin (session prerequisite for AdminOnly endpoints, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the shared fixture customer and its vehicle (200 expected)
# @name fixtureCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{FixtureCustomerEmail}}

?? status == 200

### [Setup][Appointments] Create a disposable appointment to delete below (201 expected)
# @name firstApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Appointment-delete fixture: first disposable appointment", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 201

### [Positive][Appointments] Admin deletes the appointment (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{firstApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

### [Positive][Appointments] The deleted appointment is gone from the customer history (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments?descending=true

?? status == 200
?? js (response.parsedBody.some(a => a.id == firstApptCreate.id)) == false

### [Negative][Appointments] Repeat delete on the now-deleted appointment (404, appointment_not_found)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{firstApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js response.parsedBody.code == appointment_not_found

### [Setup][Appointments] Create an appointment that owns two quotes (201 expected)
# @name cascadeApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Appointment-delete fixture: quote cascade", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 201

### [Setup][Appointments] Create the first quote linked to it (201 expected)
# @name cascadeQuoteOne
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureCustomer.vehicles[0].id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Appointment-delete cascade one", "appointmentId": {{cascadeApptCreate.id}} }

?? status == 201

### [Setup][Appointments] Create the second quote linked to it (201 expected)
# @name cascadeQuoteTwo
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureCustomer.vehicles[0].id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Appointment-delete cascade two", "appointmentId": {{cascadeApptCreate.id}} }

?? status == 201

### [Positive][Appointments] Deleting the non-Completed appointment deletes its quotes with it (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{cascadeApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

### [Negative][Appointments] Cascade check - the first quote no longer exists (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{cascadeQuoteOne.id}}

?? status == 404

### [Negative][Appointments] Cascade check - the second quote no longer exists (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{cascadeQuoteTwo.id}}

?? status == 404

### [Setup][Appointments] Create an appointment and cancel it (201, then 200 expected)
# @name cancelledApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Appointment-delete fixture: cancelled appointment", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 201

###

PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{cancelledApptCreate.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Cancelled", "version": {{cancelledApptCreate.version}} }

?? status == 200
?? js response.parsedBody.canDelete == true

### [Positive][Appointments] A Cancelled appointment can be deleted (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{cancelledApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

### [Setup][Appointments] Create a second disposable appointment for the authz check (201 expected)
# @name secondApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{fixtureCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Appointment-delete fixture: second disposable appointment", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 201

### [Setup][Appointments] Login as the plain mechanic for the authz check (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Negative][Appointments] Plain mechanic cannot delete appointment (403 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{secondApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 403

### [Positive][Appointments] The refused delete left the appointment in place (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments?descending=true

?? status == 200
?? js (response.parsedBody.some(a => a.id == secondApptCreate.id)) == true

### [Setup][Appointments] Login as admin again for cleanup (200 expected)
# @name adminAgainLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Cleanup][Appointments] Admin deletes the second appointment (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{secondApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
