# POST /api/appointments/intake for a customer that already exists (found by normalized email). Every appointment
# is deleted at the end by the admin, and so is the vehicle created here; the shared fixture customer stays unchanged.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@RunId = {{$timestamp}}
@NewVehicleVin = TST{{RunId.toString().slice(-10)}}1201

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as the plain mechanic, the intake caller (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Resolve the known customer and its vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

### [Positive][Appointments] Existing customer and existing vehicle: created InProgress, caller auto-assigned (201 expected)
# @name existingApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-21T08:30:00", "dueDateTime": "2026-04-23T16:00:00", "taskDescription": "  Scheduler intake existing customer and vehicle  " }

?? status == 201
?? header location includes /api/appointments/
?? js response.parsedBody.status == InProgress
?? js (response.parsedBody.taskDescription === "Scheduler intake existing customer and vehicle") == true
?? js response.parsedBody.scheduledDate startsWith 2026-04-21T08:30:00
?? js response.parsedBody.dueDateTime startsWith 2026-04-23T16:00:00
?? js (response.parsedBody.completedAt == null) == true
?? js (response.parsedBody.canceledAt == null) == true
?? js response.parsedBody.mechanics.length == 1
?? js (response.parsedBody.mechanics[0].id == nonAdminLogin.personId) == true
?? js (response.parsedBody.vehicle.id == knownCustomer.vehicles[0].id) == true
?? js (response.parsedBody.vehicle.customerId == knownCustomer.id) == true
?? js response.parsedBody.version > 0
?? js response.parsedBody.hasAcceptedQuote == false
?? js response.parsedBody.canComplete == false
?? js response.parsedBody.canDelete == true
?? js response.parsedBody.canLinkQuote == true

### [Positive][Appointments] The new appointment shows in the customer history (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{knownCustomer.id}}/appointments?descending=true

?? status == 200
?? js (response.parsedBody.some(a => a.id == existingApptCreate.id)) == true

### [Positive][Appointments] Email matching ignores case and padding, and a new vehicle joins the existing customer (201 expected)
# @name newVehicleApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": " {{KnownCustomerEmail.toUpperCase()}} ", "vehicle": { "licensePlate": "ivh-{{RunId}}", "vin": "{{NewVehicleVin}}", "brand": "Seat", "model": "Ibiza", "year": 2019, "mileageKm": 80000, "enginePowerKw": 70, "drivetrainType": "Petrol" }, "scheduledDate": "2026-04-22T09:00:00", "dueDateTime": "2026-04-22T17:00:00", "taskDescription": "Scheduler intake existing customer and new vehicle" }

?? status == 201
?? js (response.parsedBody.vehicle.customerId == knownCustomer.id) == true
?? js response.parsedBody.vehicle.licensePlate startsWith IVH-
?? js response.parsedBody.vehicle.brand == Seat
?? js response.parsedBody.vehicle.drivetrainType == Petrol
?? js (response.parsedBody.vehicle.id != knownCustomer.vehicles[0].id) == true

### [Positive][Appointments] dueDateTime equal to scheduledDate and a 200-character task are allowed (201 expected)
# @name dueEqualApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2026-04-24T10:00:00", "dueDateTime": "2026-04-24T10:00:00", "taskDescription": "{{'t'.repeat(200)}}" }

?? status == 201
?? js response.parsedBody.taskDescription.length == 200

### [Positive][Appointments] A past scheduled date is allowed (201 expected)
# @name pastApptCreate
POST {{AutoService_ApiService_HostAddress}}/api/appointments/intake
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "customerEmail": "{{KnownCustomerEmail}}", "vehicleId": {{knownCustomer.vehicles[0].id}}, "scheduledDate": "2020-01-01T09:00:00", "dueDateTime": "2020-01-03T10:00:00", "taskDescription": "Scheduler intake with past date allowed" }

?? status == 201
?? js response.parsedBody.scheduledDate startsWith 2020-01-01T09:00:00

### [Cleanup][Appointments] Login as admin (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Cleanup][Appointments] Delete the four fixture appointments (204 expected each)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{existingApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{newVehicleApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{dueEqualApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{pastApptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

### [Cleanup][Appointments] Delete the vehicle the second intake created (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{newVehicleApptCreate.vehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
