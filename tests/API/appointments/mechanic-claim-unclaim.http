# ─────────────────────────────────────────────────────────────
# APPOINTMENTS - MECHANIC CLAIM & UNCLAIM
# ─────────────────────────────────────────────────────────────
# ClaimAsync only accepts an appointment the caller is not already assigned to (see
# AppointmentEndpoints.Mutations.cs), so ApptId is created by admin with only the admin's own mechanic
# id assigned, leaving room for the non-admin test mechanic to claim it below.
# Cancelled/not-assigned/last-mechanic claim-unclaim coverage lives in the sibling file
# mechanic-claim-unclaim-edge-cases.http (split out to stay under the 250-line file limit).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}


# ─────────────────────────────────────────────────────────────

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin to create the claimable fixture (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

@AdminMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Resolve the known customer's own vehicle (200 expected)
# @name knownCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{KnownCustomerEmail}}

?? status == 200

###

@KnownCustomerId = {{knownCustomer.id}}
@KnownCustomerVehicleId = {{knownCustomer.vehicles[0].id}}

### [Setup][Appointments] Create an appointment assigned only to the admin (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{KnownCustomerId}}/appointments
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "vehicleId": {{KnownCustomerVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Claim/unclaim fixture: claimable appointment",
  "mechanicIds": [{{AdminMechanicId}}]
}

?? status == 201

###

@ApptId = {{apptCreate.id}}

### [Setup][Appointments] Logout admin, login as non-admin mechanic (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

?? status == 204

###

### [Setup][Appointments] Login as non-admin mechanic (session prerequisite, 200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

?? status == 200

###

### [Positive][Appointments] Claim appointment by id (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/claim
Origin: {{WebUI_Origin}}

?? status == 200

###

### [Negative][Appointments] Duplicate claim conflict when already assigned (409 expected)
# Expected error code: already_claimed.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/claim
Origin: {{WebUI_Origin}}

?? status == 409
?? js response.parsedBody.code == already_claimed
###

### [Setup][Appointments] Complete appointment (setup for unclaim-completed check, 200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Completed"
}

?? status == 200

###

### [Negative][Appointments] Claim completed appointment is rejected (422 expected)
# Claim now returns explicit completed-state validation.
# Expected error code: appointment_completed.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/claim
Origin: {{WebUI_Origin}}

?? status == 422
?? js response.parsedBody.code == appointment_completed
###

### [Negative][Appointments] Unclaim completed appointment is rejected (422 expected)
# Self-unclaim is blocked when status is Completed.
# Expected error code: appointment_completed.
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/claim
Origin: {{WebUI_Origin}}

?? status == 422
?? js response.parsedBody.code == appointment_completed
###

### [Setup][Appointments] Reopen completed appointment to InProgress for remaining tests (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "InProgress"
}

?? status == 200

###

### [Positive][Appointments] Unclaim appointment by id (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/claim
Origin: {{WebUI_Origin}}

?? status == 200
