# PUT /api/appointments/{id} refusals: due date, task and fixed start. The version rules are in appointment-concurrency.http,
# vehicle edits in appointment-vehicle-update.http. A disposable customer, vehicle and appointment are created and deleted here.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@CustomerEmail = fixture.appt.update.validation.{{RunId}}@example.test

### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

### [Setup][Appointments] Login as admin (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][Appointments] Create the disposable customer (201 expected)
# @name customer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Appointment", "middleName": null, "lastName": "FieldValidation", "email": "{{CustomerEmail}}", "phoneNumber": null }

?? status == 201

### [Setup][Appointments] Create the disposable customer's vehicle (201 expected)
# @name vehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "OWU-{{RunId}}", "vin": "TST{{RunId.toString().slice(-10)}}0900", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

### [Setup][Appointments] Create the appointment under validation (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "vehicleId": {{vehicle.id}}, "scheduledDate": "2026-04-18T10:30:00", "taskDescription": "Update validation fixture", "mechanicIds": [{{adminLogin.personId}}] }

?? status == 201

### [Negative][Appointments] A missing dueDateTime is refused (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "taskDescription": "Update without due date", "version": {{apptCreate.version}} }

?? status == 422
?? js (response.parsedBody.detail === "DueDateTime is required.") == true

### [Negative][Appointments] A blank task description is refused (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "dueDateTime": "2026-04-25T16:00:00", "taskDescription": "   ", "version": {{apptCreate.version}} }

?? status == 422
?? js (response.parsedBody.detail === "TaskDescription is required.") == true

### [Negative][Appointments] A missing task description is refused (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "dueDateTime": "2026-04-25T16:00:00", "version": {{apptCreate.version}} }

?? status == 422
?? js (response.parsedBody.detail === "TaskDescription is required.") == true

### [Negative][Appointments] A task description of 201 characters is refused (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "dueDateTime": "2026-04-25T16:00:00", "taskDescription": "{{'a'.repeat(201)}}", "version": {{apptCreate.version}} }

?? status == 422
?? js (response.parsedBody.detail === "TaskDescription must be at most 200 characters.") == true

### [Negative][Appointments] A due date before the start is refused (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "dueDateTime": "2026-04-18T10:29:59", "taskDescription": "Due before scheduled date", "version": {{apptCreate.version}} }

?? status == 422
?? js (response.parsedBody.detail === "DueDateTime must be greater than or equal to ScheduledDate.") == true

### [Negative][Appointments] A different start is refused, the start cannot be changed (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{apptCreate.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "scheduledDate": "2026-04-18T10:30:01", "dueDateTime": "2026-04-25T16:00:00", "taskDescription": "Scheduled date change", "version": {{apptCreate.version}} }

?? status == 422
?? js (response.parsedBody.detail === "ScheduledDate cannot be changed.") == true

### [Negative][Appointments] An unknown appointment is refused (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/99999999
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "dueDateTime": "2026-04-22T16:15:00", "taskDescription": "Update of a missing appointment", "version": 1 }

?? status == 404
?? js response.parsedBody.code == appointment_not_found

### [Positive][Appointments] None of the refused edits changed the appointment (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/appointments

?? status == 200
?? js (response.parsedBody.find(a => a.id == apptCreate.id).taskDescription == "Update validation fixture") == true
?? js (response.parsedBody.find(a => a.id == apptCreate.id).dueDateTime.startsWith("2026-04-18T10:30:00")) == true
?? js (response.parsedBody.find(a => a.id == apptCreate.id).version == apptCreate.version) == true

### [Cleanup][Appointments] Delete the disposable customer, cascading vehicle and appointment (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
