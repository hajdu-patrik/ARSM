# ApptId is created here so field validation is reached instead of 404; AdminMechanicId is the admin's
# own person_id. SeedVehicleVin only needs to pass VIN format (drivetrain parsing runs before the uniqueness check); ApptId is deleted at the end.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@SeedVehicleVin = WVWZZZAUZJW123456


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin (session prerequisite, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

@AdminMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Resolve a customer that owns a vehicle (200 expected)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

### [Setup][Appointments] Resolve one of that customer's vehicles (200 expected)
@SeedCustomerId = {{seedCustomers.find(c => c.vehicleCount > 0).id}}
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/vehicles

?? status == 200

###

### [Setup][Appointments] Create the appointment under field-level validation test (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{SeedCustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{seedVehicles[0].id}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Update-field-validation fixture",
  "mechanicIds": [{{AdminMechanicId}}]
}

?? status == 201

###

@ApptId = {{apptCreate.id}}

### [Negative][Appointments] Admin update rejects empty taskDescription (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2026-04-25T16:00:00",
  "taskDescription": "   "
}

?? status == 422

###

### [Negative][Appointments] Admin update rejects taskDescription exceeding 200 characters (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2026-04-25T16:00:00",
  "taskDescription": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX"
}

?? status == 422

###

### [Negative][Appointments] Admin update rejects dueDateTime earlier than scheduledDate (422 expected)
# dueDateTime must be >= scheduledDate for the linked appointment.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2000-01-01T00:00:00",
  "taskDescription": "Due before scheduled date should be rejected"
}

?? status == 422

###

### [Negative][Appointments] Admin vehicle update missing required fields (422 expected)
# LicensePlate, Vin, Brand, Model, and DrivetrainType are required for /vehicle update payloads.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "brand": "Volkswagen"
}

?? status == 422

###

### [Negative][Appointments] Admin vehicle update rejects invalid VIN format (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "ABC-101",
  "vin": "SHORTVIN",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 422

###

### [Negative][Appointments] Admin vehicle update rejects unsupported drivetrain type (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "ABC-101",
  "vin": "{{SeedVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 81,
  "drivetrainType": "Hydrogen"
}

?? status == 422

###

### [Cleanup][Appointments] Delete the fixture appointment created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
