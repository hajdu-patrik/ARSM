# ApptId is created here (on a disposable customer and vehicle, deleted at the end) so field validation is reached instead of 404;
# AdminMechanicId is the admin's own person_id. FixtureVehicleVin only needs to pass VIN format (drivetrain parsing runs before the uniqueness check); ApptId is deleted at the end.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
# Disposable owner and vehicle: the vehicle edits persist, so the shared fixture vehicles stay untouched.
@RunId = {{$timestamp}}
@FixtureCustomerEmail = fixture.appt.update.validation.{{RunId}}@example.test
@OwnLicensePlate = OWU-{{RunId}}
@OwnVehicleVin = TST{{RunId.toString().slice(-10)}}0900
@FixtureVehicleVin = WVWZZZAUZJW123456


### [Setup][Appointments] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Appointments] Login as admin (session prerequisite, 200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-autoservice_csrf='))?.match(/^__Host-autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

@AdminMechanicId = {{adminLogin.personId}}

### [Setup][Appointments] Create a disposable customer, because the vehicle edits below persist (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Appointment", "middleName": null, "lastName": "FieldValidation", "email": "{{FixtureCustomerEmail}}", "phoneNumber": null }

?? status == 201

###

### [Setup][Appointments] Create the disposable customer's vehicle (201 expected)
# @name ownVehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "{{OwnLicensePlate}}", "vin": "{{OwnVehicleVin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

###

@FixtureCustomerId = {{fixtureCustomer.id}}

### [Setup][Appointments] Create the appointment under field-level validation test (201 expected)
# @name apptCreate
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{FixtureCustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{ownVehicle.id}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Update-field-validation fixture",
  "mechanicIds": [{{AdminMechanicId}}]
}

?? status == 201

###

@ApptId = {{apptCreate.id}}

### [Negative][Appointments] Admin update rejects empty taskDescription (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2026-04-25T16:00:00",
  "taskDescription": "   ",
  "version": {{apptCreate.version}}
}

?? status == 422

###

### [Negative][Appointments] Admin update rejects taskDescription exceeding 200 characters (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2026-04-25T16:00:00",
  "taskDescription": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX",
  "version": {{apptCreate.version}}
}

?? status == 422

###

### [Negative][Appointments] Admin update rejects dueDateTime earlier than scheduledDate (422 expected)
# dueDateTime must be >= scheduledDate for the linked appointment.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "dueDateTime": "2000-01-01T00:00:00",
  "taskDescription": "Due before scheduled date should be rejected",
  "version": {{apptCreate.version}}
}

?? status == 422

###

### [Negative][Appointments] Admin vehicle update missing required fields (422 expected)
# LicensePlate, Vin, Brand, Model, and DrivetrainType are required for /vehicle update payloads.
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "brand": "Volkswagen"
}

?? status == 422

###

### [Negative][Appointments] Admin vehicle update rejects invalid VIN format (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "ABC-101",
  "vin": "SHORTVIN",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 422

###

### [Negative][Appointments] Admin vehicle update rejects unsupported drivetrain type (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}/vehicle
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "ABC-101",
  "vin": "{{FixtureVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 81,
  "drivetrainType": "Hydrogen"
}

?? status == 422

###

### [Cleanup][Appointments] Delete the fixture appointment created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ApptId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Cleanup][Appointments] Delete the disposable customer, cascading its vehicle (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
