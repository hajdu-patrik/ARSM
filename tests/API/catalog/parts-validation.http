# ─────────────────────────────────────────────────────────────
# PARTS - VALIDATION AND CONFLICTS
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@ValidPartNumber = ZZV{{RunId}}A
@SeedPartNumber = OLF-1001
@LowercaseSeedPartNumber = olf-1001
@NonExistentPartId = 999999999
@OverLengthPartNumber = P9999999999999999999999999999999999999999
@OverLengthName = N999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999


# ─────────────────────────────────────────────────────────────

### [Setup][Parts] Login as admin for validation tests
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

###

### [Negative][Parts] Create part with missing part number (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "",
  "name": "Valid Name",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Create part with missing name (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{ValidPartNumber}}",
  "name": "",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Create part with part number over 40 characters (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{OverLengthPartNumber}}",
  "name": "Valid Name",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Create part with name over 120 characters (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{ValidPartNumber}}",
  "name": "{{OverLengthName}}",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Create part with negative net unit price (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{ValidPartNumber}}",
  "name": "Valid Name",
  "netUnitPrice": -1,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Create part with net unit price over 100000000 (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{ValidPartNumber}}",
  "name": "Valid Name",
  "netUnitPrice": 100000000.01,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Create part with unsupported VAT rate (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{ValidPartNumber}}",
  "name": "Valid Name",
  "netUnitPrice": 100,
  "vatRatePercent": 10
}

###

### [Negative][Parts] Create part with duplicate part number matching seeded key (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{SeedPartNumber}}",
  "name": "Duplicate Check",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Lowercase part number normalizes and collides with existing uppercase key (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{LowercaseSeedPartNumber}}",
  "name": "Duplicate Lowercase Check",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Update non-existent part (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/parts/{{NonExistentPartId}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{ValidPartNumber}}",
  "name": "Ghost Update",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

###

### [Negative][Parts] Delete non-existent part (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{NonExistentPartId}}
Origin: {{WebUI_Origin}}
