@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@AuthzPartNumber = ZZU{{RunId}}A

# COVERAGE GAP: a MechanicOnly 403 for an authenticated-but-not-mechanic caller cannot be produced
# against the live API today (no fabricated token) - see tests/CLAUDE.md Coverage Anchors.

### [Setup][Catalog] Login as admin to create disposable authz fixtures
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Catalog] Create disposable part used as the authz target id (201 expected)
# @name authzPart
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "partNumber": "{{AuthzPartNumber}}",
  "name": "Catalog Authz Part",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

?? status == 201

###

###

### [Setup][Catalog] Logout before unauthenticated checks
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Catalog] Unauthenticated list parts (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/parts

?? status == 401

###

### [Negative][Catalog] Unauthenticated get part by id (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}

?? status == 401

###

### [Negative][Catalog] Unauthenticated create part (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "partNumber": "UNAUTH-PART",
  "name": "Unauthenticated",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

?? status == 401

###

### [Negative][Catalog] Unauthenticated update part (401 expected)
# @no-cookie-jar
PUT {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "partNumber": "UNAUTH-PART",
  "name": "Unauthenticated",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

?? status == 401

###

### [Negative][Catalog] Unauthenticated delete part (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 401

###

###

###

###

###

###

### [Setup][Catalog] Login as admin again to clean up the disposable authz fixtures
# @name csrfSource2
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Cleanup][Catalog] Delete the disposable authz part fixture (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

###

### [Setup][Catalog] Logout admin after cleanup
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
