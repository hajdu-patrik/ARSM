# All 10 catalog routes are MechanicOnly: 401 without a session, before any handler (a missing id needs no fixture).
# COVERAGE GAP: the 403 for a non-mechanic cannot be produced live (tests/CLAUDE.md); signed-in access: catalog-authz-mechanic.http.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@GhostId = 999999999

### [Setup][Catalog] Login once to hold a real CSRF token for the unsafe requests below (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Catalog] Logout so the checks below run unauthenticated (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Catalog] Unauthenticated GET /api/parts (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/parts

?? status == 401

###

### [Negative][Catalog] Unauthenticated GET /api/parts/{id} (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/parts/{{GhostId}}

?? status == 401

###

### [Negative][Catalog] Unauthenticated POST /api/parts (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "partNumber": "UNAUTH-PART", "name": "Unauthenticated", "netUnitPrice": 100, "vatRatePercent": 27 }

?? status == 401

###

### [Negative][Catalog] Unauthenticated PUT /api/parts/{id} (401 expected)
# @no-cookie-jar
PUT {{AutoService_ApiService_HostAddress}}/api/parts/{{GhostId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "partNumber": "UNAUTH-PART", "name": "Unauthenticated", "netUnitPrice": 100, "vatRatePercent": 27, "version": 1 }

?? status == 401

###

### [Negative][Catalog] Unauthenticated DELETE /api/parts/{id} (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{GhostId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 401

###

### [Negative][Catalog] Unauthenticated GET /api/labor-types (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/labor-types

?? status == 401

###

