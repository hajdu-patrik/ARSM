# ─────────────────────────────────────────────────────────────
# CATALOG - AUTHZ (PARTS + LABOR TYPES, MechanicOnly POLICY)
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@AuthzPartNumber = ZZU{{RunId}}A
@AuthzLaborTypeCode = ZZU{{RunId}}A

# COVERAGE GAP (do not fill with a fabricated token):
# The F1 brief asks every route below to also prove that a request carrying a
# valid CUSTOMER token gets 403 (authenticated but not authorized), not 401.
# That case cannot be produced against the live API today: Customer person
# records never receive an IdentityUserId (DemoDataInitializer.cs: "Customers
# are passive data records - no login account, no IdentityUserId") and
# POST /api/auth/register only accepts personType "Mechanic"
# (AuthEndpoints.Register.cs: "Registration is only available for
# mechanics."). No endpoint issues a session for a person whose person_type
# claim resolves to "customer", so MechanicOnly (Program.cs:
# RequireClaim("person_type","mechanic")) can only currently be observed
# distinguishing "authenticated" from "unauthenticated" below, never
# "authenticated non-mechanic" from "authenticated mechanic". See the test
# agent's report for the full discrepancy writeup instead of a fake token.
#
# The part/labor-type ids used below are created by this file (not a hardcoded seed id like
# @SomePartId=1), so the checks keep working if the demo seed's numeric ids ever change; both
# fixtures are deleted at the end.


# ─────────────────────────────────────────────────────────────

### [Setup][Catalog] Login as admin to create disposable authz fixtures
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Setup][Catalog] Create disposable part used as the authz target id (201 expected)
# @name authzPart
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "{{AuthzPartNumber}}",
  "name": "Catalog Authz Part",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

?? status == 201

###

### [Setup][Catalog] Create disposable labor type used as the authz target id (201 expected)
# @name authzLaborType
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "code": "{{AuthzLaborTypeCode}}",
  "name": "Catalog Authz Labor",
  "hourlyNetRate": 100,
  "vatRatePercent": 27
}

?? status == 201

###

### [Setup][Catalog] Logout before unauthenticated checks
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

?? status == 204

###

### [Negative][Catalog] Unauthenticated list parts (401 expected)
GET {{AutoService_ApiService_HostAddress}}/api/parts

?? status == 401

###

### [Negative][Catalog] Unauthenticated get part by id (401 expected)
GET {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}

?? status == 401

###

### [Negative][Catalog] Unauthenticated create part (401 expected)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "UNAUTH-PART",
  "name": "Unauthenticated",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

?? status == 401

###

### [Negative][Catalog] Unauthenticated update part (401 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "partNumber": "UNAUTH-PART",
  "name": "Unauthenticated",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

?? status == 401

###

### [Negative][Catalog] Unauthenticated delete part (401 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Negative][Catalog] Unauthenticated list labor types (401 expected)
GET {{AutoService_ApiService_HostAddress}}/api/labor-types

?? status == 401

###

### [Negative][Catalog] Unauthenticated get labor type by id (401 expected)
GET {{AutoService_ApiService_HostAddress}}/api/labor-types/{{authzLaborType.id}}

?? status == 401

###

### [Negative][Catalog] Unauthenticated create labor type (401 expected)
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "code": "UNAUTH-LT",
  "name": "Unauthenticated",
  "hourlyNetRate": 100,
  "vatRatePercent": 27
}

?? status == 401

###

### [Negative][Catalog] Unauthenticated update labor type (401 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/labor-types/{{authzLaborType.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "code": "UNAUTH-LT",
  "name": "Unauthenticated",
  "hourlyNetRate": 100,
  "vatRatePercent": 27
}

?? status == 401

###

### [Negative][Catalog] Unauthenticated delete labor type (401 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/labor-types/{{authzLaborType.id}}
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Setup][Catalog] Login as admin again to clean up the disposable authz fixtures
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Cleanup][Catalog] Delete the disposable authz part fixture (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{authzPart.id}}
Origin: {{WebUI_Origin}}

?? status == 204

###

### [Cleanup][Catalog] Delete the disposable authz labor type fixture (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/labor-types/{{authzLaborType.id}}
Origin: {{WebUI_Origin}}

?? status == 204

###

### [Setup][Catalog] Logout admin after cleanup
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

?? status == 204
