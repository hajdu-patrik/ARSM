POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "code": "UNAUTH-LT", "name": "Unauthenticated", "hourlyNetRate": 100, "vatRatePercent": 27 }

