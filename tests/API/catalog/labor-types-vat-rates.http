X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "{{Key}}B",
  "name": "Catalog VAT Rate Fixture",
  "hourlyNetRate": 100,
  "vatRatePercent": 5,
  "version": {{vatB.version}}
}

?? status == 204

###

### [Cleanup][LaborTypes] Delete VAT fixture A (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/labor-types/{{vatA.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

