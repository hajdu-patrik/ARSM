@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@Key = ZZV{{RunId}}

### [Setup][LaborTypes] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][LaborTypes] Login as admin (MechanicOnly prerequisite)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-autoservice_csrf='))?.match(/^__Host-autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][LaborTypes] Create labor type with VAT 0 is rejected (422 expected, 0 is no longer an allowed rate)
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "{{Key}}Z",
  "name": "Catalog VAT Rate Fixture",
  "hourlyNetRate": 100,
  "vatRatePercent": 0
}

?? status == 422
?? js response.parsedBody.detail includes VAT rate

###

### [Positive][LaborTypes] Create labor type with VAT 5 (201 expected)
# @name vatA
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "{{Key}}A",
  "name": "Catalog VAT Rate Fixture",
  "hourlyNetRate": 100,
  "vatRatePercent": 5
}

?? status == 201

###

### [Positive][LaborTypes] Create labor type with VAT 18 (201 expected)
# @name vatB
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "{{Key}}B",
  "name": "Catalog VAT Rate Fixture",
  "hourlyNetRate": 100,
  "vatRatePercent": 18
}

?? status == 201

###

### [Positive][LaborTypes] Create labor type with VAT 27 (201 expected)
# @name vatC
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "{{Key}}C",
  "name": "Catalog VAT Rate Fixture",
  "hourlyNetRate": 100,
  "vatRatePercent": 27
}

?? status == 201

###

### [Negative][LaborTypes] Update labor type to VAT 0 is rejected (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/labor-types/{{vatA.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "{{Key}}A",
  "name": "Catalog VAT Rate Fixture",
  "hourlyNetRate": 100,
  "vatRatePercent": 0,
  "version": {{vatA.version}}
}

?? status == 422
?? js response.parsedBody.detail includes VAT rate

###

### [Positive][LaborTypes] Update labor type from VAT 5 to 27 still succeeds (204 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/labor-types/{{vatA.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "{{Key}}A",
  "name": "Catalog VAT Rate Fixture",
  "hourlyNetRate": 100,
  "vatRatePercent": 27,
  "version": {{vatA.version}}
}

?? status == 204

###

### [Positive][LaborTypes] Update labor type from VAT 18 to 5 still succeeds (204 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/labor-types/{{vatB.id}}
