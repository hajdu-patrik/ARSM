# POST /api/auth/register password policy (Program.cs Identity options: 8+ characters, digit, lower, upper and a symbol).
# Each weak password is refused with its Identity error code as the errors key and creates no account.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}


### [Setup][Auth] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Auth] Login as admin (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Register] Password shorter than 8 characters (400 expected, PasswordTooShort)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Weak", "lastName": "Short", "email": "password.toolong.short.{{RunId}}@example.test", "password": "Ab1!", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).map(k => k.toLowerCase()).includes("passwordtooshort")) == true

###

### [Negative][Register] Password without a digit (400 expected, PasswordRequiresDigit)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Weak", "lastName": "NoDigit", "email": "password.toolong.digit.{{RunId}}@example.test", "password": "Abcdefgh!", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).map(k => k.toLowerCase()).includes("passwordrequiresdigit")) == true

###

### [Negative][Register] Password without an uppercase letter (400 expected, PasswordRequiresUpper)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Weak", "lastName": "NoUpper", "email": "password.toolong.upper.{{RunId}}@example.test", "password": "abcdefg1!", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).map(k => k.toLowerCase()).includes("passwordrequiresupper")) == true

###

### [Negative][Register] Password without a lowercase letter (400 expected, PasswordRequiresLower)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Weak", "lastName": "NoLower", "email": "password.toolong.lower.{{RunId}}@example.test", "password": "ABCDEFG1!", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).map(k => k.toLowerCase()).includes("passwordrequireslower")) == true

###

### [Negative][Register] Password without a symbol (400 expected, PasswordRequiresNonAlphanumeric)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Weak", "lastName": "NoSymbol", "email": "password.toolong.symbol.{{RunId}}@example.test", "password": "Abcdefg12", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).map(k => k.toLowerCase()).includes("passwordrequiresnonalphanumeric")) == true

###

### [Setup][Auth] Logout the admin session (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
