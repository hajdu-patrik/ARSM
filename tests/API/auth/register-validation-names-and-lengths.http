{ "firstName": "O'Brien", "lastName": "Smith", "email": "name.apostrophe.{{RunId}}@example.test", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

