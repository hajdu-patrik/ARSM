# Login success contract: body facts, the three session cookies and their attributes, email normalization. The 401s
# are login-negative-matrix.http, phone shapes login-positive-phone-*.http; the mechanics are created and deleted here.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@MatrixRunSuffix = {{$timestamp}}
# Phone digits derived from this run's id so registrations never collide with another file or an
# earlier, aborted run (the unique-phone constraint would answer 400 instead of 200).
@PhoneTail = {{MatrixRunSuffix.toString().slice(-6)}}
@MatrixEmailOnly = matrix.email.only.{{MatrixRunSuffix}}@example.test
@MatrixEmailWithPhone = matrix.phone.user.{{MatrixRunSuffix}}@example.test


### [Setup][Auth] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Admin Session] Login as admin to provision the matrix accounts (200 expected, isAdmin true)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js response.parsedBody.isAdmin == true

###

### [Setup][Register] Email-only mechanic (200 expected)
# @name regEmailOnly
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Matrix", "lastName": "EmailOnly", "email": "{{MatrixEmailOnly}}", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 200

###

### [Setup][Register] Email+phone mechanic (200 expected)
# @name regPhoneUser
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Matrix", "lastName": "PhoneUser", "email": "{{MatrixEmailWithPhone}}", "password": "{{TestPassword}}", "personType": "Mechanic", "phoneNumber": "06 30 6{{PhoneTail}}", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 200

###

### [Setup][Admin Session] Logout admin before the login matrix (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Positive][Login] Email-only user logs in: body facts and the three session cookies (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{MatrixEmailOnly}}", "password": "{{TestPassword}}" }

?? status == 200
?? js (response.parsedBody.personId == regEmailOnly.personId) == true
?? js response.parsedBody.isAdmin == false
?? js response.parsedBody.mustChangePassword == false
?? js (Object.keys(response.parsedBody).length == 3) == true
?? js (response.headers['set-cookie'].some(c => c.toLowerCase().startsWith('__host-arsm-access-token=') && c.toLowerCase().includes('; httponly') && c.toLowerCase().includes('; secure') && c.toLowerCase().includes('samesite=strict') && c.toLowerCase().includes('path=/') && c.toLowerCase().includes('max-age=') && !c.toLowerCase().includes('domain='))) == true
?? js (response.headers['set-cookie'].some(c => c.toLowerCase().startsWith('__host-arsm-refresh-token=') && c.toLowerCase().includes('; httponly') && c.toLowerCase().includes('; secure') && c.toLowerCase().includes('samesite=strict') && c.toLowerCase().includes('path=/') && c.toLowerCase().includes('max-age=604800') && !c.toLowerCase().includes('domain='))) == true
?? js (response.headers['set-cookie'].some(c => c.toLowerCase().startsWith('__host-arsm-csrf-token=') && !c.toLowerCase().includes('httponly') && c.toLowerCase().includes('; secure') && c.toLowerCase().includes('samesite=strict') && c.toLowerCase().includes('path=/') && c.toLowerCase().includes('max-age=604800') && !c.toLowerCase().includes('domain='))) == true

###

### [Positive][Login] Upper-case email resolves to the same account (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "MATRIX.PHONE.USER.{{MatrixRunSuffix}}@EXAMPLE.TEST", "password": "{{TestPassword}}" }

?? status == 200
?? js (response.parsedBody.personId == regPhoneUser.personId) == true

###

### [Positive][Login] Whitespace around the email is trimmed (200 expected)
# @name whitespaceLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "   MATRIX.PHONE.USER.{{MatrixRunSuffix}}@EXAMPLE.TEST   ", "password": "{{TestPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js (response.parsedBody.personId == regPhoneUser.personId) == true

###

### [Positive][Login] A login while a session already exists needs no CSRF header and replaces the session (200 expected)
# Login is CSRF-exempt, so a second login with the first session's cookies in the jar is still accepted.
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{MatrixEmailOnly}}", "password": "{{TestPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js (response.parsedBody.personId == regEmailOnly.personId) == true

###

### [Setup][Cleanup] Logout the matrix mechanic session with its own CSRF token (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][Cleanup] Login as admin again to delete the throwaway mechanics (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Cleanup] Delete the email-only mechanic (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{regEmailOnly.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Setup][Cleanup] Delete the email+phone mechanic (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{regPhoneUser.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200
