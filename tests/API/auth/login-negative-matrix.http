# ─────────────────────────────────────────────────────────────
# AUTH - LOGIN NEGATIVE MATRIX
# ─────────────────────────────────────────────────────────────
# Verified against AuthEndpoints.Login.cs / ContactNormalization.TryNormalizeEuPhoneNumber before
# writing this file:
# - A phone number that fails libphonenumber validation (wrong length, unsupported area/prefix)
#   never reaches credential lookup: ValidateLoginRequest-adjacent format checks answer a 400
#   ValidationProblem first.
# - The two phone-format cases below prove that a *valid but unusual* phone format still resolves to
#   a real, previously registered account and logs in (200), not just that the format parses. This
#   file provisions its own throwaway mechanics for those two phone shapes (own {{$timestamp}} suffix)
#   instead of depending on another file's fixtures or on httpyac's file execution order, and deletes
#   them again at the end.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
# Phone digits derived from this run's id so registrations never collide with another file or an
# earlier, aborted run (the unique-phone constraint would answer 400 instead of 200).
@PhoneTail = {{RunId.toString().slice(-6)}}
@PhoneTail7 = {{RunId.toString().slice(-7)}}
@BudapestPhoneEmail = login.negmatrix.budapest.{{RunId}}@example.test
@EuPhoneEmail = login.negmatrix.euphone.{{RunId}}@example.test
@MatrixEuPhoneCanonical = +491512{{PhoneTail7}}


# ─────────────────────────────────────────────────────────────

### [Setup][Auth] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Admin Session] Login as admin to provision the phone-format matrix (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Setup][Register] Mechanic with a Budapest landline phone (200 expected)
# @name regBudapest
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "NegMatrix",
  "lastName": "Budapest",
  "email": "{{BudapestPhoneEmail}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "phoneNumber": "+36 1 3{{PhoneTail}}",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

### [Setup][Register] Mechanic with an EU (+49) phone (200 expected)
# @name regEuPhone
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "NegMatrix",
  "lastName": "EuPhone",
  "email": "{{EuPhoneEmail}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "phoneNumber": "+49 151 2{{PhoneTail7}}",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

### [Positive][Login Phone Matrix] Budapest landline login (06 1 3xx xxxx) (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "phoneNumber": "06 1 3{{PhoneTail}}",
  "password": "{{TestPassword}}"
}

?? status == 200

###

### [Positive][Login Phone Matrix] EU phone (+49) for matrix user (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "phoneNumber": "{{MatrixEuPhoneCanonical}}",
  "password": "{{TestPassword}}"
}

?? status == 200

###

### [Negative][Login Phone Matrix] Invalid phone format (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "phoneNumber": "12345",
  "password": "{{TestPassword}}"
}

?? status == 400

###

### [Negative][Login Phone Matrix] Unsupported area/prefix (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "phoneNumber": "06 12 123 4567",
  "password": "{{TestPassword}}"
}

?? status == 400

###

### [Setup][Cleanup] Logout the matrix mechanic session (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

?? status == 204

###

### [Setup][Cleanup] Login as admin again to delete the throwaway mechanics (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Setup][Cleanup] Delete the Budapest-landline matrix mechanic (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{regBudapest.personId}}
Origin: {{WebUI_Origin}}

?? status == 200

###

### [Setup][Cleanup] Delete the EU-phone matrix mechanic (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{regEuPhone.personId}}
Origin: {{WebUI_Origin}}

?? status == 200
