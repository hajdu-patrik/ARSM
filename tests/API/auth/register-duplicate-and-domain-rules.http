# POST /api/auth/register uniqueness (Identity and People, email and phone): every duplicate answers the same generic
# anti-enumeration message under the "register" key. The duplicate-target mechanic is created and deleted here.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
# Phone digits derived from this run's id so registrations never collide with another file or an
# earlier, aborted run (the unique-phone constraint would answer 400 instead of 200).
@PhoneTail = {{RunId.toString().slice(-6)}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@DuplicateTargetEmail = duplicate.rules.target.{{RunId}}@example.test
@DuplicateTargetPhone = +36 30 5{{PhoneTail}}


### [Setup][Admin Session] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Admin Session] Login as admin (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Register] Create the mechanic that later cases collide with (200 expected)
# @name duplicateTarget
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Duplicate", "lastName": "Target", "email": "{{DuplicateTargetEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "phoneNumber": "{{DuplicateTargetPhone}}", "specialization": "GasolineAndDiesel", "expertise": ["Engine", "Brakes"] }

?? status == 200

###

### [Negative][Register] The exact email of an existing mechanic (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Same", "lastName": "Email", "email": "{{DuplicateTargetEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (response.parsedBody.errors.register[0] === "Registration failed. Please check your information, or the account may already exist.") == true

###

### [Negative][Register] The same email in upper case with surrounding whitespace is the same account (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Same", "lastName": "EmailCase", "email": "  DUPLICATE.RULES.TARGET.{{RunId}}@EXAMPLE.TEST ", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (response.parsedBody.errors.register[0] === "Registration failed. Please check your information, or the account may already exist.") == true

###

### [Negative][Register] An existing customer email is blocked by People uniqueness (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Domain", "lastName": "Conflict", "email": "{{KnownCustomerEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine", "Brakes"] }

?? status == 400
?? js (response.parsedBody.errors.register[0] === "Registration failed. Please check your information, or the account may already exist.") == true

###

### [Negative][Register] The phone of an existing mechanic in another valid format (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Duplicate", "lastName": "Phone", "email": "duplicate.phone.{{RunId}}@example.test", "password": "{{TestPassword}}", "personType": "Mechanic", "phoneNumber": "+36305{{PhoneTail}}", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (response.parsedBody.errors.register[0] === "Registration failed. Please check your information, or the account may already exist.") == true

###

### [Negative][Register] The same phone with leading and trailing whitespace (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Duplicate", "lastName": "PhoneWhitespace", "email": "duplicate.phone.whitespace.{{RunId}}@example.test", "password": "{{TestPassword}}", "personType": "Mechanic", "phoneNumber": "   06 30 5{{PhoneTail}}   ", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (response.parsedBody.errors.register[0] === "Registration failed. Please check your information, or the account may already exist.") == true

###

### [Negative][Register] The phone of the fixture customer is blocked by People uniqueness (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Duplicate", "lastName": "CustomerPhone", "email": "duplicate.phone.customer.{{RunId}}@example.test", "password": "{{TestPassword}}", "personType": "Mechanic", "phoneNumber": "+36 30 444 5566", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 400
?? js (response.parsedBody.errors.register[0] === "Registration failed. Please check your information, or the account may already exist.") == true

###

### [Setup][Cleanup] Delete the duplicate-target mechanic created above (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{duplicateTarget.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200
