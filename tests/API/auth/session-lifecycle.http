# Verified against AuthEndpoints.Login/Refresh/Logout/Validate.cs: a stale cookie replayed after logout is
# rejected on both Validate and Refresh. [Manual] blocks stay non-executing to avoid tripping rate limits/lockout and banning the suite's client. Self-provisions/deletes its own mechanic.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@TestWrongPassword = {{$processEnv ARSM_TEST_WRONG_PASSWORD}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@MatrixRunSuffix = {{$timestamp}}
@MatrixEmailWithPhone = session.lifecycle.{{MatrixRunSuffix}}@example.test


### [Setup][Auth] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Admin Session] Login as admin to provision the session-lifecycle mechanic (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Register] Throwaway mechanic for the session-lifecycle chain (200 expected)
# @name regSessionMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Session",
  "lastName": "Lifecycle",
  "email": "{{MatrixEmailWithPhone}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

### [Setup][Admin Session] Logout admin before the session-lifecycle chain (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Positive][Session] Login before validate/refresh/logout chain (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{MatrixEmailWithPhone}}",
  "password": "{{TestPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][Session] Validate authenticated session (200 expected; requires login cookie)
GET {{AutoService_ApiService_HostAddress}}/api/auth/validate

?? status == 200

###

### [Positive][Session] Refresh authenticated session (204 expected; requires refresh cookie)
# @name Refresh
POST {{AutoService_ApiService_HostAddress}}/api/auth/refresh
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 204

###

# Refresh rotates the CSRF cookie too, so the logout below needs the new value.

### [Manual][Session] Refresh rate limiting (expect 429 after >20 refresh calls per minute from same client)
# Manual: re-run rapidly to verify AuthRefreshAttempts (429 after >20/min). PowerShell:
# 1..25 | % { iwr -Method Post -UseBasicParsing "{{AutoService_ApiService_HostAddress}}/api/auth/refresh" }

###

### [Manual][Login] Login rate limiting (expect 429 after >10 login calls per minute from same client)
# Manual: re-run rapidly to verify AuthLoginAttempts (429 after >10/min). PowerShell:
# 1..12 | % { $body = @{ email = "{{MatrixEmailWithPhone}}"; password = "{{TestWrongPassword}}" } | ConvertTo-Json; iwr -Method Post -UseBasicParsing -ContentType "application/json" -Body $body "{{AutoService_ApiService_HostAddress}}/api/auth/login" }

###

### [Manual][Login] Lockout after repeated bad password attempts (expect 429, then valid login works after lockout window)
# Manual: trigger lockout with 5 consecutive wrong-password attempts, then verify a valid-password login
# returns 429 during the lockout window and succeeds again once it expires.

###

### [Positive][Session] Logout current session (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Session] Validate after logout (401 expected)
GET {{AutoService_ApiService_HostAddress}}/api/auth/validate

?? status == 401

###

### [Negative][Session] Refresh without active cookie session (401 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/refresh
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Negative][Session] Logout without active access cookie (401 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Setup][Cleanup] Login as admin again to delete the throwaway mechanic (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Cleanup] Delete the session-lifecycle mechanic (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{regSessionMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200
