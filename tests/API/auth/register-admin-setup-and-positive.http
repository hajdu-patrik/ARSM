# ─────────────────────────────────────────────────────────────
# AUTH - REGISTER ADMIN SETUP AND POSITIVE
# ─────────────────────────────────────────────────────────────
# Verified against AuthEndpoints.Register.cs / AuthEndpoints.cs before writing this file:
# - /api/auth/register requires the "AdminOnly" policy: unauthenticated -> 401 before the handler
#   runs, authenticated non-admin -> 403 (see register-validation-and-nonadmin-authz.http), admin -> 200
#   with {personId, personType, email} (RegisterResponse).
# - This file is self-contained: it registers its own phone-format matrix with a unique {{$timestamp}}
#   suffix and deletes every mechanic it created (DELETE /api/admin/mechanics/{id}) at the end, so no
#   other file may depend on these accounts surviving past this file's own run.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}


# ─────────────────────────────────────────────────────────────

# Dedicated matrix users
@MatrixRunSuffix = {{$timestamp}}
# Phone digits derived from this run's id so registrations never collide with another file or an
# earlier, aborted run (the unique-phone constraint would answer 400 instead of 200).
@PhoneTail = {{MatrixRunSuffix.toString().slice(-6)}}
@PhoneTail7 = {{MatrixRunSuffix.toString().slice(-7)}}
@MatrixEmailOnly = matrix.email.only.{{MatrixRunSuffix}}@example.test
@MatrixEmailWithPhone = matrix.phone.user.{{MatrixRunSuffix}}@example.test
@MatrixBudapestEmail = matrix.budapest.user.{{MatrixRunSuffix}}@example.test
@MatrixEuEmail = matrix.eu.phone.{{MatrixRunSuffix}}@example.test

### [Setup][Auth] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Negative][Register] Unauthenticated registration (AdminOnly policy -> 401 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Blocked",
  "lastName": "Unauth",
  "email": "blocked.unauth.{{MatrixRunSuffix}}@example.test",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 401

###

### [Setup][Admin Session] Login as admin before register matrix (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Positive][Admin Session] Validate authenticated admin session (200 expected, IsAdmin=true)
GET {{AutoService_ApiService_HostAddress}}/api/auth/validate

?? status == 200
?? js response.parsedBody.isAdmin == true

###

### [Positive][Register][Admin] Email-only mechanic registration (200 expected)
# @name regEmailOnly
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Matrix",
  "lastName": "EmailOnly",
  "email": "{{MatrixEmailOnly}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine", "Brakes"]
}

?? status == 200

###

### [Positive][Register][Admin] Mechanic registration with phone (spaced 06 format) (200 expected)
# @name regPhoneUser
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Matrix",
  "lastName": "PhoneUser",
  "email": "{{MatrixEmailWithPhone}}",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "phoneNumber": "06 30 8{{PhoneTail}}",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine", "Brakes"]
}

?? status == 200

###

### [Positive][Register][Admin] Mechanic registration with local Hungarian phone (no 36/06 prefix) (200 expected)
# @name regLocalPhone
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Matrix",
  "lastName": "LocalPhone",
  "email": "matrix.local.phone.{{MatrixRunSuffix}}@example.test",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "phoneNumber": "301{{PhoneTail}}",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine", "Brakes"]
}

?? status == 200

###

### [Positive][Register][Admin] Mechanic registration with Budapest landline (+36 1) (200 expected)
