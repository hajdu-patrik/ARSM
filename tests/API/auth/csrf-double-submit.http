# Verified against Middleware/CsrfDoubleSubmitMiddleware.cs; Origin check runs first (see origin-csrf.http),
# so this file always sends the allowed Origin. Coverage summary: tests/CLAUDE.md Coverage Anchors. "wrong-csrf-token" below is a deliberately invalid literal, not a credential. Self-provisions/deletes its own catalog part.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@MechanicEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@MechanicPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@RunId = {{$timestamp}}
@CsrfPartNumber = ZZC{{RunId}}A


### [Setup][Csrf] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Csrf] Login establishes the auth cookies and the __Host-autoservice_csrf cookie (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{MechanicEmail}}",
  "password": "{{MechanicPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-autoservice_csrf='))?.match(/^__Host-autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# CSRF double-submit token for the requests below (see tests/CLAUDE.md Core Rules).

### [Negative][Csrf] Unsafe authenticated refresh without X-CSRF-Token (403 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/refresh
Origin: {{WebUI_Origin}}

?? status == 403
?? js response.parsedBody.code == csrf_token_invalid

###

### [Negative][Csrf] Unsafe authenticated refresh with a wrong X-CSRF-Token (403 expected, same code)
POST {{AutoService_ApiService_HostAddress}}/api/auth/refresh
Origin: {{WebUI_Origin}}
X-CSRF-Token: wrong-csrf-token

?? status == 403
?? js response.parsedBody.code == csrf_token_invalid

###

### [Positive][Csrf] Unsafe authenticated refresh with the correct X-CSRF-Token (204 expected)
# @name Refresh
POST {{AutoService_ApiService_HostAddress}}/api/auth/refresh
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-autoservice_csrf='))?.match(/^__Host-autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 204

###

### [Setup][Csrf] Create a disposable catalog part as the DELETE target, with the rotated token (201 expected)
# @name csrfTargetPart
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "partNumber": "{{CsrfPartNumber}}",
  "name": "Csrf Delete Target Part",
  "netUnitPrice": 100,
  "vatRatePercent": 27
}

?? status == 201

###

### [Negative][Csrf] Unsafe authenticated DELETE without X-CSRF-Token (403 expected, same code)
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{csrfTargetPart.id}}
Origin: {{WebUI_Origin}}

?? status == 403
?? js response.parsedBody.code == csrf_token_invalid

###

### [Negative][Csrf] The refused DELETE removed nothing, the part still exists (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/parts/{{csrfTargetPart.id}}

?? status == 200

###

### [Setup][Cleanup] Delete the disposable part with the correct X-CSRF-Token (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{csrfTargetPart.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

# Refresh rotates the CSRF cookie too, so the logout cleanup below needs the new value.

### [Setup][Cleanup] Logout with the correct, rotated X-CSRF-Token (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
