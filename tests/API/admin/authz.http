@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@UnknownMechanicId = 999999

# UnknownMechanicId never needs to resolve to a real mechanic: RequireAuthorization("AdminOnly") gates
# before the 404 lookup (AdminEndpoints.cs), so every check below rejects on policy, not existence.

### [Setup][Admin] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Admin] Login as non-admin for forbidden access check (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Admin] Non-admin cannot list mechanics (403 expected)
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics

?? status == 403

###

### [Negative][Admin] Non-admin cannot delete mechanic (403 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{UnknownMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 403

###

### [Setup][Admin] Logout non-admin before unauthenticated checks (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Admin] Unauthenticated list mechanics (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics

?? status == 401

###

### [Negative][Admin] Unauthenticated delete mechanic (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{UnknownMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 401
