# AdminOnly gates every /api/admin/mechanics route before any lookup. The 403 cases aim at a real disposable mechanic, so
# a broken gate would change it; afterwards it must still exist with its password and no forced change.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@TemporaryPassword = {{$processEnv ARSM_TEST_MECHANIC_NEW_PASSWORD}}
@RunId = {{$timestamp}}
@TargetEmail = delete.mechanic.authz.{{RunId}}@example.test

### [Setup][Admin] Clear any session cookie left by a previous file (204, 401 or 403, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Admin] Login as admin (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Admin] Register the disposable target mechanic (200 expected)
# @name authzTarget
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Authz", "lastName": "Target", "email": "{{TargetEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 200

###

### [Setup][Admin] Logout admin (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][Admin] Login as the plain mechanic (200 expected, not an admin)
# @name csrfSource2
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{NonAdminEmail}}", "password": "{{NonAdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js response.parsedBody.isAdmin == false

###

### [Negative][Admin] Non-admin cannot list mechanics (403 expected)
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics

?? status == 403

###

### [Negative][Admin] Non-admin cannot delete a real mechanic (403 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{authzTarget.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 403

###

### [Negative][Admin] Non-admin cannot reset the password of a real mechanic (403 expected)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{authzTarget.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "{{TemporaryPassword}}" }

?? status == 403

###

### [Negative][Admin] The policy answers before the lookup, so an unknown id is 403 too (403 expected, not 404)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/999999
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 403

###

### [Setup][Admin] Logout the plain mechanic (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Admin] Unauthenticated list mechanics (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics

?? status == 401

###

### [Negative][Admin] Unauthenticated delete mechanic (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{authzTarget.personId}}
Origin: {{WebUI_Origin}}

?? status == 401

###

### [Negative][Admin] Unauthenticated reset mechanic password (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{authzTarget.personId}}/password-reset
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "temporaryPassword": "{{TemporaryPassword}}" }

?? status == 401

###

### [Positive][Admin] The target still logs in with its original password and has no forced change (200 expected)
# A reset that slipped through the gate would have flagged mustChangePassword and replaced the password.
# @name targetLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{TargetEmail}}", "password": "{{TestPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js response.parsedBody.mustChangePassword == false

###

### [Setup][Admin] Logout the target (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Cleanup][Admin] Login as admin again (200 expected)
# @name csrfSource3
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][Admin] The blocked delete left the target in the roster (200 expected, one match)
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics?search={{TargetEmail}}

?? status == 200
?? js response.parsedBody.totalCount == 1
?? js (response.parsedBody.items[0].personId == authzTarget.personId) == true

###

### [Cleanup][Admin] Delete the disposable target (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{authzTarget.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Setup][Admin] Logout admin (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
