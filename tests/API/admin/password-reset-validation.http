# Temporary password rules of POST /api/admin/mechanics/{id}/password-reset: required, at most 128 characters, and the Identity policy
# (8+ characters with a digit, lower, upper and symbol). Every rejection is a 400 and changes nothing; 128 characters pass.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@RunId = {{$timestamp}}
@ResetMechanicEmail = password.reset.validation.{{RunId}}@example.test
@Over128Password = Aa1!{{'x'.repeat(125)}}
@Exactly128Password = Aa1!{{'x'.repeat(124)}}

### [Setup][ResetValidation] Clear any session cookie left by a previous file (204, 401 or 403, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][ResetValidation] Login as admin (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][ResetValidation] Register the disposable mechanic (200 expected)
# @name resetMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Reset", "lastName": "Validation", "email": "{{ResetMechanicEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "specialization": "GasolineAndDiesel", "expertise": ["Engine"] }

?? status == 200

###

### [Negative][ResetValidation] Whitespace-only temporary password (400 expected, required)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "   " }

?? status == 400
?? js (response.parsedBody.errors.TemporaryPassword[0] == "Temporary password is required.") == true

###

### [Negative][ResetValidation] Null temporary password (400 expected, required)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": null }

?? status == 400
?? js (response.parsedBody.errors.TemporaryPassword[0] == "Temporary password is required.") == true

###

### [Negative][ResetValidation] Missing temporary password property (400 expected, required)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ }

?? status == 400
?? js (response.parsedBody.errors.TemporaryPassword[0] == "Temporary password is required.") == true

###

### [Negative][ResetValidation] 129 characters (400 expected, length cap)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "{{Over128Password}}" }

?? status == 400
?? js (response.parsedBody.errors.TemporaryPassword[0] == "TemporaryPassword must be at most 128 characters.") == true

###

### [Negative][ResetValidation] 7 characters (400 expected, PasswordTooShort)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "Abcde1!" }

?? status == 400
?? js (response.parsedBody.errors.PasswordTooShort.length == 1) == true

###

### [Negative][ResetValidation] No upper case letter (400 expected, PasswordRequiresUpper)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "abcdefg1!" }

?? status == 400
?? js (response.parsedBody.errors.PasswordRequiresUpper.length == 1) == true

###

### [Negative][ResetValidation] No lower case letter (400 expected, PasswordRequiresLower)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "ABCDEFG1!" }

?? status == 400
?? js (response.parsedBody.errors.PasswordRequiresLower.length == 1) == true

###

### [Negative][ResetValidation] No digit (400 expected, PasswordRequiresDigit)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "Abcdefgh!" }

?? status == 400
?? js (response.parsedBody.errors.PasswordRequiresDigit.length == 1) == true

###

### [Negative][ResetValidation] No symbol (400 expected, PasswordRequiresNonAlphanumeric)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "Abcdefg12" }

?? status == 400
?? js (response.parsedBody.errors.PasswordRequiresNonAlphanumeric.length == 1) == true

###

### [Setup][ResetValidation] Logout admin (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Positive][ResetValidation] After every rejection the mechanic still has the original password and no forced change (200 expected)
# @name mechanicLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{ResetMechanicEmail}}", "password": "{{TestPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js response.parsedBody.mustChangePassword == false

###

### [Setup][ResetValidation] Logout the mechanic (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][ResetValidation] Login as admin again (200 expected)
# @name csrfSource2
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][ResetValidation] Exactly 128 characters are accepted (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}/password-reset
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "temporaryPassword": "{{Exactly128Password}}" }

?? status == 200
?? js (response.parsedBody.email == ResetMechanicEmail) == true

###

### [Cleanup][ResetValidation] Delete the disposable mechanic (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{resetMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Setup][ResetValidation] Logout admin (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
