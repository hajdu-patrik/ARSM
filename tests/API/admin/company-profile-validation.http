# Every case changes one field of an otherwise valid body; errors are keyed by camelCase field name.
# Max-length cases use 300 characters, above every column cap, so they hold if a cap is tuned.
@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}

### [Setup][CompanyProfile] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][CompanyProfile] Login as admin (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][CompanyProfile] All seven fields blank (400 expected, one error per field)
PUT {{AutoService_ApiService_HostAddress}}/api/admin/company-profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "name": "", "addressLine": "", "postalCode": "", "city": "", "taxNumber": "", "phoneNumber": "", "email": "" }

?? status == 400
?? js (["name","addressLine","postalCode","city","taxNumber","phoneNumber","email"].every(k => response.parsedBody.errors[k]?.length >= 1)) == true

###

### [Negative][CompanyProfile] Whitespace-only name (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/admin/company-profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "name": "   ", "addressLine": "Teszt utca 1.", "postalCode": "1111", "city": "Budapest", "taxNumber": "12345678-1-12", "phoneNumber": "+36301234567", "email": "a@example.test" }

?? status == 400
?? js (response.parsedBody.errors.name.length >= 1) == true

###

### [Negative][CompanyProfile] Tax number without hyphens (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/admin/company-profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "name": "X", "addressLine": "Teszt utca 1.", "postalCode": "1111", "city": "Budapest", "taxNumber": "12345678112", "phoneNumber": "+36301234567", "email": "a@example.test" }

?? status == 400
?? js (response.parsedBody.errors.taxNumber.length >= 1) == true

