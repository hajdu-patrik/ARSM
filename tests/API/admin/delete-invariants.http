# Every id here is resolved at runtime or created as a disposable fixture, never hardcoded: literal
# mechanic ids drifted with the seed counter and once deleted the real ARSM_TEST_MECHANIC_EMAIL account.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@RunId = {{$timestamp}}
@UnknownMechanicId = 999999

### [Setup][Admin] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Admin] Login as admin (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Admin] Admin cannot delete own account (403 expected)
# adminLogin.personId comes from the login response (AuthEndpoints.Contracts.cs), never hardcoded:
# DeleteMechanicAsync compares the caller's person_id claim to the route id.
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{adminLogin.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 403

###

# COVERAGE GAP: DeleteMechanicAsync's 403-on-admin-target branch needs a second seeded admin, which
# would require mutating the shared demo seed (only gabor.kovacs@example.com is Admin); not executed.

# COVERAGE GAP: the "last remaining mechanic" 422 needs the shared demo DB down to one mechanic, which
# every other suite's login depends on staying intact; not executed.


### [Setup][Admin] Resolve a seeded customer that owns a vehicle (200 expected)
# @name seedCustomers
GET {{AutoService_ApiService_HostAddress}}/api/customers

?? status == 200

###

@SoleAssignmentCustomerId = {{seedCustomers.find(c => c.vehicleCount > 0).id}}

### [Setup][Admin] Resolve one of that customer vehicles (200 expected)
# @name seedVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{SoleAssignmentCustomerId}}/vehicles

?? status == 200

###

### [Setup][Admin] Register a disposable mechanic to be an appointment sole assignee (200 expected)
# @name soleAssignmentMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Delete",
  "lastName": "SoleAssignment",
  "email": "delete.mechanic.sole.{{RunId}}@example.test",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

### [Setup][Admin] Create an appointment where the disposable mechanic is the sole assignee (201 expected)
# This fixture appointment is not deleted by this file and stays on the calendar after the run
# (appointment-delete.http covers the AdminOnly DELETE /api/appointments/{id} route).
# @name soleAssignmentAppt
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{SoleAssignmentCustomerId}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{seedVehicles[0].id}},
  "scheduledDate": "2020-01-01T10:00:00",
  "taskDescription": "ARSM delete-invariants sole-assignment fixture",
  "mechanicIds": [{{soleAssignmentMechanic.personId}}]
}

?? status == 201

###

### [Negative][Admin] Cannot delete mechanic that would leave an appointment unassigned (422 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{soleAssignmentMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 422

###

### [Cleanup][Admin] Assign a second mechanic so the disposable one is no longer the sole assignee (200 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/appointments/{{soleAssignmentAppt.id}}/assign/{{adminLogin.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Cleanup][Admin] Delete the disposable sole-assignment mechanic now that the invariant no longer blocks it (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{soleAssignmentMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Setup][Admin] Register a disposable mechanic with no appointment assignments (200 expected)
# @name deletableMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Delete",
  "lastName": "Candidate",
  "email": "delete.mechanic.candidate.{{RunId}}@example.test",
  "password": "{{TestPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine"]
}

?? status == 200

###

### [Positive][Admin] Delete non-admin mechanic when invariants hold (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{deletableMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Manual][Admin] Concurrent mechanic delete contention returns conflict (409 expected)
# Not automated: needs a DbUpdateConcurrencyException/Postgres serialization failure mid-transaction,
# which sequential HTTP calls cannot force; reproduce by hand with two concurrent deletes of one mechanic.

###

### [Manual][Admin] Linked identity delete failure returns server error (500 expected)
# Not automated: needs UserManager.DeleteAsync to fail for a mechanic with a resolvable IdentityUserId,
# unreachable via the public API; reproduce by fault-injecting the Identity store or deleting the row.

###

### [Negative][Admin] Cannot delete unknown mechanic (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{UnknownMechanicId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
