# Safety net for a run that dies mid-file: purges only '@example.test' mechanics matching the fixture-prefix
# allowlist in the @loop filter below (never the shared MechanicEmail or an admin, keep it in sync with new fixtures); file order isn't guaranteed (see tests/API/_setup/ensure-test-accounts.http).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@MechanicEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}


### [Setup][Cleanup] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Cleanup] Login as admin (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Cleanup] List every mechanic (200 expected)
# @name mechanics
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics

?? status == 200

###

### [Cleanup] Delete every leftover test-fixture mechanic still matching the filter above
# @loop for leftoverMechanic of mechanics.filter(m => !m.isAdmin && m.email.toLowerCase() !== MechanicEmail.toLowerCase() && m.email.toLowerCase().endsWith("@example.test") && ["matrix.","appt.","delete.mechanic.","login.negmatrix.","duplicate.rules.target.","duplicate.phone.","bad.phone.","bad.expertise.","customer.should.fail.","name.","lastname.","middlename.","firstname.toolong.","phone.toolong.","password.toolong.","blocked.nonadmin.","blocked.unauth.","profile.conflict.","profile.delete.","session.lifecycle."].some(p => m.email.toLowerCase().startsWith(p)))
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{leftoverMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

# Only a genuine 500 fails this run: DeleteMechanicAsync can legitimately answer 403 (self/admin-role),
# 404 (already gone), 409 (concurrency) or 422 (last-mechanic/sole-assignment) for a leftover with no context here.
?? status != 500
