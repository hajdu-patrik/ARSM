###

### [Positive][Vehicles] A European Cyrillic plate (201 expected, stored as written)
# @name cyrillic
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "АВ-{{Digits}}-ЕЖ", "vin": "{{Vin}}0906", "brand": "Skoda", "model": "Kodiaq", "year": 2021, "mileageKm": 39000, "enginePowerKw": 140, "drivetrainType": "Hybrid" }

?? status == 201
?? js response.parsedBody.licensePlate == АВ-{{Digits}}-ЕЖ

###

### [Positive][Vehicles] Lower limits: year 1886, mileage 0, kW 0, a 20-character plate, a 50-character brand (201 expected)
# @name lowest
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "M{{'X'.repeat(12)}}{{Digits}}", "vin": "{{Vin}}0907", "brand": "{{'B'.repeat(50)}}", "model": "Veteran", "year": 1886, "mileageKm": 0, "enginePowerKw": 0, "drivetrainType": "Petrol" }

?? status == 201
?? js response.parsedBody.licensePlate.length == 20
?? js response.parsedBody.brand.length == 50
?? js response.parsedBody.year == 1886
?? js response.parsedBody.mileageKm == 0
?? js response.parsedBody.enginePowerKw == 0

###

### [Positive][Vehicles] Upper limits: year 2100, mileage 1,000,000, kW 50,000, a 50-character model (201 expected)
# @name highest
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "HI-{{Digits}}", "vin": "{{Vin}}0908", "brand": "Limit", "model": "{{'M'.repeat(50)}}", "year": 2100, "mileageKm": 1000000, "enginePowerKw": 50000, "drivetrainType": "Electric" }

?? status == 201
?? js response.parsedBody.model.length == 50
?? js response.parsedBody.year == 2100
?? js response.parsedBody.mileageKm == 1000000
?? js response.parsedBody.enginePowerKw == 50000

###

### [Positive][Vehicles] All eight vehicles are listed for the owner (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles

?? status == 200
?? js response.parsedBody.totalCount == 8

###

### [Cleanup][Vehicles] Delete the owner, which deletes its vehicles (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
