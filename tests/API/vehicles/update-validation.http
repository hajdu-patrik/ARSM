# PUT /api/vehicles/{id} validation: the same required, length, range, VIN, drivetrain and plate rules (422) as create
# (create-validation-*.http) hold on update, and a refused update changes nothing. One representative case per rule group.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@Digits = {{RunId.toString().slice(-7)}}
@Vin = TST{{RunId.toString().slice(-10)}}1501

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Vehicles] Create the owner (201 expected)
# @name owner
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Vehicle", "middleName": null, "lastName": "UpdateValidation", "email": "vehicles.update.validation.{{RunId}}@example.test", "phoneNumber": null }

?? status == 201

###

### [Setup][Vehicles] Create the vehicle the updates target (201 expected)
# @name target
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 124500, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 201

###

### [Negative][Vehicles] Empty license plate (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "LicensePlate, Vin, Brand, Model, and DrivetrainType are required.") == true

###

### [Negative][Vehicles] A 51-character brand (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin}}", "brand": "{{'B'.repeat(51)}}", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "Brand must be at most 50 characters.") == true

###

### [Negative][Vehicles] Year 2200 (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2200, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "Year must be between 1886 and 2100.") == true

###

### [Negative][Vehicles] Negative mileage (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": -1, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "MileageKm and EnginePowerKw must be non-negative.") == true

###

### [Negative][Vehicles] Engine power 50,001 kW (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 50001, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail.includes('1000000') && response.parsedBody.detail.includes('50000')) == true

###

### [Negative][Vehicles] A 16-character VIN (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin.slice(0, 16)}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "VIN must be exactly 17 characters.") == true

###

### [Negative][Vehicles] A VIN with the forbidden letter Q (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin.slice(0, 16)}}Q", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "VIN may only contain digits and uppercase letters A-H, J-N, P, and R-Z.") == true

###

### [Negative][Vehicles] An unknown drivetrain (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "UV-{{Digits}}", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Hydrogen" }

?? status == 422
?? js (response.parsedBody.detail === "DrivetrainType must be one of: Petrol, Diesel, Hybrid, PHEV, Electric.") == true

###

### [Negative][Vehicles] A plate without a digit (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "ABCDEF", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "License plate must contain at least one digit.") == true

###

### [Negative][Vehicles] A plate in a non-European script (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "اب-123", "vin": "{{Vin}}", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 0, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail.includes('non-European letters')) == true

###

### [Positive][Vehicles] None of the refused updates changed the vehicle (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{target.id}}

?? status == 200
?? js response.parsedBody.licensePlate == UV-{{Digits}}
?? js (response.parsedBody.vin == Vin) == true
?? js response.parsedBody.brand == Volkswagen
?? js response.parsedBody.year == 2018
?? js response.parsedBody.mileageKm == 124500
?? js response.parsedBody.enginePowerKw == 81
?? js response.parsedBody.drivetrainType == Petrol

###

### [Cleanup][Vehicles] Delete the owner (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
