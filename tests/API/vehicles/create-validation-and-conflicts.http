# ─────────────────────────────────────────────────────────────
# VEHICLES - CREATE VALIDATION AND CONFLICTS
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@ValidVehicleVin = TST{{RunId.toString().slice(-10)}}0101
@InvalidYearVehicleVin = TST{{RunId.toString().slice(-10)}}0102
@InvalidPlateVehicleVin = TST{{RunId.toString().slice(-10)}}0103
@InvalidMileageVehicleVin = TST{{RunId.toString().slice(-10)}}0104
@DuplicatePlateVehicleVin = TST{{RunId.toString().slice(-10)}}0105
@SeedVehicleVin = WVWZZZAUZJW123456
@FixtureCustomerEmail = vehicles.create.validation.{{RunId}}@example.test


# ─────────────────────────────────────────────────────────────

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin for create validation tests (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

?? status == 200

###

### [Setup][Vehicles] Create a fixture customer to own the vehicles below (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "firstName": "Vehicle",
  "middleName": null,
  "lastName": "Validation",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Negative][Vehicles] Create vehicle with missing required fields (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "",
  "vin": "{{ValidVehicleVin}}",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": 45000,
  "enginePowerKw": 110,
  "drivetrainType": "Petrol"
}

?? status == 422

###

### [Negative][Vehicles] Create vehicle with invalid year (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "BAD-YR1",
  "vin": "{{InvalidYearVehicleVin}}",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 1800,
  "mileageKm": 0,
  "enginePowerKw": 74,
  "drivetrainType": "Diesel"
}

?? status == 422

###

### [Negative][Vehicles] Create vehicle with non-European script in plate (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "\u0627\u0628-123",
  "vin": "{{InvalidPlateVehicleVin}}",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": 0,
  "enginePowerKw": 74,
  "drivetrainType": "Hybrid"
}

?? status == 422

###

### [Negative][Vehicles] Create vehicle with negative mileage (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "BAD-MI1",
  "vin": "{{InvalidMileageVehicleVin}}",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": -1,
  "enginePowerKw": 110,
  "drivetrainType": "PHEV"
}

?? status == 422

###

### [Negative][Vehicles] Create vehicle with invalid VIN format (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "BAD-VIN",
  "vin": "SHORTVIN",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": 45000,
  "enginePowerKw": 110,
  "drivetrainType": "Petrol"
}

?? status == 422

###

### [Negative][Vehicles] Create vehicle with unsupported drivetrain type (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "BAD-DRV",
  "vin": "TST{{RunId.toString().slice(-10)}}0106",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": 45000,
  "enginePowerKw": 110,
  "drivetrainType": "Hydrogen"
}

?? status == 422

###

### [Negative][Vehicles] Create vehicle with duplicate license plate (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "ABC-101",
  "vin": "{{DuplicatePlateVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 409

###

### [Negative][Vehicles] Create vehicle with duplicate VIN conflict (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "licensePlate": "VIN-{{RunId}}",
  "vin": "{{SeedVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 409

###

### [Cleanup][Vehicles] Delete the fixture customer created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}

?? status == 204
