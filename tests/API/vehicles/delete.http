# DELETE /api/vehicles/{id} as admin: 204, gone from every read while the owner and its other vehicles stay, 404 on repeat,
# plate and VIN free again. The 403 and 401 are in authz.http, the appointment and quote cascade in delete-cascade.http.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@Digits = {{RunId.toString().slice(-7)}}
@Vin = TST{{RunId.toString().slice(-10)}}17
@GhostVehicleId = 999999999

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Vehicles] Create the owner (201 expected)
# @name owner
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Vehicle", "middleName": null, "lastName": "Delete", "email": "vehicles.delete.{{RunId}}@example.test", "phoneNumber": null }

?? status == 201

###

### [Setup][Vehicles] Create the vehicle to delete (201 expected)
# @name doomed
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "DV-{{Digits}}", "vin": "{{Vin}}01", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

###

### [Setup][Vehicles] Create the vehicle that must survive (201 expected)
# @name survivor
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "DS-{{Digits}}", "vin": "{{Vin}}02", "brand": "Skoda", "model": "Fabia", "year": 2019, "mileageKm": 91500, "enginePowerKw": 70, "drivetrainType": "Diesel" }

?? status == 201

###

### [Positive][Vehicles] Admin deletes the vehicle (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{doomed.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Vehicles] The deleted vehicle cannot be read (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{doomed.id}}

?? status == 404
?? js (response.parsedBody.detail === "Vehicle not found.") == true

###

### [Negative][Vehicles] The plate lookup no longer finds it (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-license-plate?licensePlate=DV-{{Digits}}

?? status == 404

###

### [Positive][Vehicles] The owner's list holds only the survivor (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles

?? status == 200
?? js response.parsedBody.totalCount == 1
?? js (response.parsedBody.items[0].id == survivor.id) == true

###

### [Positive][Vehicles] The owner is untouched (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}

?? status == 200
?? js response.parsedBody.vehicles.length == 1

###

### [Negative][Vehicles] Deleting it again (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{doomed.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js (response.parsedBody.detail === "Vehicle not found.") == true

###

### [Negative][Vehicles] Deleting a missing id (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{GhostVehicleId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404
?? js (response.parsedBody.detail === "Vehicle not found.") == true

###

### [Positive][Vehicles] The plate and VIN are free again (201 expected)
# @name reborn
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "DV-{{Digits}}", "vin": "{{Vin}}01", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

###

### [Cleanup][Vehicles] Delete the owner, which deletes its vehicles (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
