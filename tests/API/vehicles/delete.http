# ─────────────────────────────────────────────────────────────
#  DELETE VEHICLE
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@NonExistentVehicleId = 99999
@RunId = {{$timestamp}}
@FixtureCustomerEmail = delete.vehicle.{{RunId}}@example.test
@FixtureVehicleVin = TST{{RunId.toString().slice(-10)}}0701


# ─────────────────────────────────────────────────────────────

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin for delete tests (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Vehicles] Create a fixture customer to own the vehicle below (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Delete",
  "middleName": null,
  "lastName": "VehicleFixture",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Setup][Vehicles] Create a fixture vehicle to delete below (201 expected)
# @name fixtureVehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "DVH-{{RunId}}",
  "vin": "{{FixtureVehicleVin}}",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": 45000,
  "enginePowerKw": 110,
  "drivetrainType": "Petrol"
}

?? status == 201

###

### [Negative][Vehicles] Delete non-existent vehicle (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentVehicleId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

### [Setup][Vehicles] Logout admin, login as non-admin for delete auth check
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as non-admin mechanic (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Vehicles] Authenticated non-admin delete keeps domain not-found semantics (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentVehicleId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

### [Setup][Vehicles] Login as admin before positive delete
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][Vehicles] Admin deletes the fixture vehicle (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureVehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Vehicles] Deleted vehicle cannot be fetched (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureVehicle.id}}

?? status == 404

###

### [Negative][Vehicles] Re-delete deleted vehicle returns not found (404 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureVehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 404

###

### [Cascade][Vehicles] Customer vehicle list stays queryable and empty after its only vehicle is deleted (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles

?? status == 200
?? js response.parsedBody.length == 0

###

### [Cleanup][Vehicles] Delete the fixture customer created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
