# POST /api/customers/{id}/vehicles number ranges: year 1886..2100, mileage 0..1,000,000, kW 0..50,000 (the exact limits
# are accepted in create-happy.http). All 422 with the reason in `detail`; the year is checked before mileage and kW.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@Digits = {{RunId.toString().slice(-7)}}
@Vin = TST{{RunId.toString().slice(-10)}}1101

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Vehicles] Create the owner (201 expected)
# @name owner
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Vehicle", "middleName": null, "lastName": "Numeric", "email": "vehicles.numeric.{{RunId}}@example.test", "phoneNumber": null }

?? status == 201

###

### [Negative][Vehicles] Year 1885, one below the minimum (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "NU-{{Digits}}", "vin": "{{Vin}}", "brand": "Skoda", "model": "Octavia", "year": 1885, "mileageKm": 0, "enginePowerKw": 74, "drivetrainType": "Diesel" }

?? status == 422
?? js (response.parsedBody.detail === "Year must be between 1886 and 2100.") == true

###

### [Negative][Vehicles] Year 2101, one above the maximum (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "NU-{{Digits}}", "vin": "{{Vin}}", "brand": "Skoda", "model": "Octavia", "year": 2101, "mileageKm": 0, "enginePowerKw": 74, "drivetrainType": "Diesel" }

?? status == 422
?? js (response.parsedBody.detail === "Year must be between 1886 and 2100.") == true

###

### [Negative][Vehicles] Negative mileage (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "NU-{{Digits}}", "vin": "{{Vin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": -1, "enginePowerKw": 110, "drivetrainType": "PHEV" }

?? status == 422
?? js (response.parsedBody.detail === "MileageKm and EnginePowerKw must be non-negative.") == true

###

### [Negative][Vehicles] Negative engine power (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "NU-{{Digits}}", "vin": "{{Vin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 100, "enginePowerKw": -1, "drivetrainType": "PHEV" }

?? status == 422
?? js (response.parsedBody.detail === "MileageKm and EnginePowerKw must be non-negative.") == true

###

### [Negative][Vehicles] Mileage 1,000,001 (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "NU-{{Digits}}", "vin": "{{Vin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 1000001, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail.includes('1000000') && response.parsedBody.detail.includes('50000')) == true

###

### [Negative][Vehicles] Engine power 50,001 kW (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "NU-{{Digits}}", "vin": "{{Vin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 100, "enginePowerKw": 50001, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail.includes('1000000') && response.parsedBody.detail.includes('50000')) == true

###

### [Negative][Vehicles] A bad year and a negative mileage together (422 expected, the year is reported first)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "NU-{{Digits}}", "vin": "{{Vin}}", "brand": "Skoda", "model": "Octavia", "year": 1800, "mileageKm": -1, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 422
?? js (response.parsedBody.detail === "Year must be between 1886 and 2100.") == true

###

### [Positive][Vehicles] None of the refused requests created a vehicle (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}/vehicles

?? status == 200
?? js response.parsedBody.totalCount == 0

###

### [Cleanup][Vehicles] Delete the owner (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{owner.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
