# ─────────────────────────────────────────────────────────────
# VEHICLES - CREATE AUTHZ
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonExistentCustomerId = 99999
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@RunId = {{$timestamp}}
@GhostVehicleVin = TST{{RunId.toString().slice(-10)}}0201
@NonAdminVehicleVin = TST{{RunId.toString().slice(-10)}}0202
@FixtureCustomerEmail = vehicles.create.authz.{{RunId}}@example.test


# ─────────────────────────────────────────────────────────────

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin for setup (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Vehicles] Create a fixture customer to own the vehicle below (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Vehicle",
  "middleName": null,
  "lastName": "CreateAuthz",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Negative][Vehicles] POST /api/customers/{{NonExistentCustomerId}}/vehicles (404 expected: GhostVehicleVin is a syntactically valid 17-char VIN, so body validation passes and the route-id existence lookup is reached)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentCustomerId}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "GHO-ST1",
  "vin": "{{GhostVehicleVin}}",
  "brand": "Ghost",
  "model": "Rider",
  "year": 2023,
  "mileageKm": 0,
  "enginePowerKw": 147,
  "drivetrainType": "Electric"
}

?? status == 404

###

### [Setup][Vehicles] Logout admin, login as non-admin for write check
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as non-admin mechanic (200 expected)
# @name nonAdminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][Vehicles] Non-admin can create vehicle (201 expected)
# @name createdByNonAdmin
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "NON-{{RunId}}",
  "vin": "{{NonAdminVehicleVin}}",
  "brand": "Blocked",
  "model": "ByPolicy",
  "year": 2020,
  "mileageKm": 0,
  "enginePowerKw": 74,
  "drivetrainType": "Petrol"
}

?? status == 201

###

### [Cleanup][Vehicles] Non-admin deletes the fixture customer, cascading its vehicle (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
