# ─────────────────────────────────────────────────────────────
# VEHICLES - LIST GET CREATE POSITIVE
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@NonExistentCustomerId = 99999
@NonExistentVehicleId = 99999
@FixtureVehicleVin = TST{{RunId.toString().slice(-10)}}0000
@NewVehicleVin = TST{{RunId.toString().slice(-10)}}0001
@LatinPlateVehicleVin = TST{{RunId.toString().slice(-10)}}0002
@CyrillicPlateVehicleVin = TST{{RunId.toString().slice(-10)}}0003
@FixtureCustomerEmail = vehicles.list.get.create.{{RunId}}@example.test


# ─────────────────────────────────────────────────────────────

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin (session prerequisite) (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Vehicles] Create a fixture customer to own the vehicles below (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Vehicle",
  "middleName": null,
  "lastName": "Owner",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Setup][Vehicles] Create a fixture vehicle for the customer (201 expected)
# @name fixtureVehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "LST-{{RunId}}",
  "vin": "{{FixtureVehicleVin}}",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": 45000,
  "enginePowerKw": 110,
  "drivetrainType": "Petrol"
}

?? status == 201

###

# ─────────────────────────────────────────────────────────────
#  LIST VEHICLES FOR CUSTOMER
# ─────────────────────────────────────────────────────────────

### [Positive][Vehicles] List vehicles for the fixture customer (200 expected, includes vin/enginePowerKw/drivetrainType)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles

?? status == 200

###

### [Negative][Vehicles] List vehicles for non-existent customer (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/customers/{{NonExistentCustomerId}}/vehicles

?? status == 404

###
# ─────────────────────────────────────────────────────────────
#  GET VEHICLE BY ID
# ─────────────────────────────────────────────────────────────

### [Positive][Vehicles] Get vehicle by id (200 expected, includes vin/enginePowerKw/drivetrainType and customer summary)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{fixtureVehicle.id}}

?? status == 200

###

### [Negative][Vehicles] Get non-existent vehicle (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentVehicleId}}

?? status == 404

###

# ─────────────────────────────────────────────────────────────
#  CREATE VEHICLE
# ─────────────────────────────────────────────────────────────

### [Positive][Vehicles] Admin creates vehicle for customer (201 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "NEW-{{RunId}}",
  "vin": "{{NewVehicleVin}}",
  "brand": "Skoda",
  "model": "Octavia",
  "year": 2020,
  "mileageKm": 45000,
  "enginePowerKw": 110,
  "drivetrainType": "Petrol"
}

?? status == 201

###

### [Positive][Vehicles] Create vehicle with EU-style Latin plate formatting (201 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "AB {{RunId}} CD",
  "vin": "{{LatinPlateVehicleVin}}",
  "brand": "Renault",
  "model": "Megane",
  "year": 2019,
  "mileageKm": 88000,
  "enginePowerKw": 85,
  "drivetrainType": "Diesel"
}

?? status == 201

###

### [Positive][Vehicles] Create vehicle with European Cyrillic plate formatting (201 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "\u0410\u0412-{{RunId}}-\u0415\u0416",
  "vin": "{{CyrillicPlateVehicleVin}}",
  "brand": "Skoda",
  "model": "Kodiaq",
  "year": 2021,
  "mileageKm": 39000,
  "enginePowerKw": 140,
  "drivetrainType": "Hybrid"
}

?? status == 201

###

### [Cleanup][Vehicles] Delete the fixture customer, cascading every vehicle created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
