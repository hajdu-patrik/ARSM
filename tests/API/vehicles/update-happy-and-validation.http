@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonExistentVehicleId = 99999
@RunId = {{$timestamp}}
@FixtureCustomerEmail = vehicles.update.happy.{{RunId}}@example.test
@PrimaryVehicleVin = TST{{RunId.toString().slice(-10)}}0300
@ConflictPlate = DUP-{{RunId}}
@ConflictVehicleVin = TST{{RunId.toString().slice(-10)}}0301
@GhostVehicleVin = TST{{RunId.toString().slice(-10)}}0302

### [Setup][Vehicles] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Vehicles] Login as admin for update tests (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Vehicles] Create a fixture customer to own the vehicles below (201 expected)
# @name fixtureCustomer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Vehicle",
  "middleName": null,
  "lastName": "UpdateHappy",
  "email": "{{FixtureCustomerEmail}}",
  "phoneNumber": null
}

?? status == 201

###

### [Setup][Vehicles] Create the primary fixture vehicle to update below (201 expected)
# @name primaryVehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "PRI-{{RunId}}",
  "vin": "{{PrimaryVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 124500,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 201

###

### [Positive][Vehicles] Admin updates existing vehicle (204 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{primaryVehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "PRI-{{RunId}}",
  "vin": "{{PrimaryVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf 7",
  "year": 2018,
  "mileageKm": 130000,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 204

###

### [Setup][Vehicles] Create second vehicle for duplicate plate/VIN update validation (201 expected)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "{{ConflictPlate}}",
  "vin": "{{ConflictVehicleVin}}",
  "brand": "Skoda",
  "model": "Fabia",
  "year": 2019,
  "mileageKm": 91500,
  "enginePowerKw": 70,
  "drivetrainType": "Petrol"
}

?? status == 201

###

### [Negative][Vehicles] Update vehicle with duplicate license plate conflict (409 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{primaryVehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "{{ConflictPlate}}",
  "vin": "{{PrimaryVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf 7",
  "year": 2018,
  "mileageKm": 130000,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 409

###

### [Negative][Vehicles] Update vehicle with duplicate VIN conflict (409 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{primaryVehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "PRI-{{RunId}}",
  "vin": "{{ConflictVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf 7",
  "year": 2018,
  "mileageKm": 130000,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 409

###

### [Negative][Vehicles] Update non-existent vehicle (404 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{NonExistentVehicleId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "GHO-ST1",
  "vin": "{{GhostVehicleVin}}",
  "brand": "Ghost",
  "model": "Rider",
  "year": 2020,
  "mileageKm": 0,
  "enginePowerKw": 74,
  "drivetrainType": "Petrol"
}

?? status == 404

###

### [Negative][Vehicles] Update vehicle with missing required fields (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{primaryVehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "",
  "vin": "{{PrimaryVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 0,
  "enginePowerKw": 81,
  "drivetrainType": "Petrol"
}

?? status == 422

###

### [Negative][Vehicles] Update vehicle with unsupported drivetrain type (422 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/vehicles/{{primaryVehicle.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "licensePlate": "PRI-{{RunId}}",
  "vin": "{{PrimaryVehicleVin}}",
  "brand": "Volkswagen",
  "model": "Golf",
  "year": 2018,
  "mileageKm": 0,
  "enginePowerKw": 81,
  "drivetrainType": "Hydrogen"
}

?? status == 422

###

### [Cleanup][Vehicles] Delete the fixture customer, cascading both vehicles created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
