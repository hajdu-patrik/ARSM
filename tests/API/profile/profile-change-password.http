# Change-password as the shared mechanic: rejected input, password policy, wrong current password, the success flow, and the
# original password restored. Lengths: field-length-validation.http; lockout: credential-lockout.http; other sessions: session-revocation-check.py.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestWrongPassword = {{$processEnv ARSM_TEST_WRONG_PASSWORD}}
@ProfileMechanicEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@ProfileCurrentPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@ProfileNewPassword = {{$processEnv ARSM_TEST_MECHANIC_NEW_PASSWORD}}

### [Setup][Profile] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Profile] Login as the shared plain mechanic (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{ProfileMechanicEmail}}", "password": "{{ProfileCurrentPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Profile] All three fields blank are named (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "", "newPassword": " ", "confirmNewPassword": "" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("Current password is required.")) == true
?? js (Object.values(response.parsedBody.errors).flat().includes("New password is required.")) == true
?? js (Object.values(response.parsedBody.errors).flat().includes("Password confirmation is required.")) == true

###

### [Negative][Profile] Confirmation mismatch (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{ProfileCurrentPassword}}", "newPassword": "{{ProfileNewPassword}}", "confirmNewPassword": "{{ProfileNewPassword}}-mismatch" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("Passwords do not match.")) == true

###

### [Negative][Profile] A new password that breaks the policy is refused with the Identity code (400 expected, PasswordTooShort)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{ProfileCurrentPassword}}", "newPassword": "123", "confirmNewPassword": "123" }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).map(k => k.toLowerCase()).includes("passwordtooshort")) == true

###

### [Negative][Profile] A new password without an uppercase letter (400 expected, PasswordRequiresUpper)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{ProfileCurrentPassword}}", "newPassword": "abcdefg1!", "confirmNewPassword": "abcdefg1!" }

?? status == 400
?? js (Object.keys(response.parsedBody.errors).map(k => k.toLowerCase()).includes("passwordrequiresupper")) == true

###

### [Negative][Profile] Wrong current password (400 expected, CurrentPassword)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{TestWrongPassword}}", "newPassword": "{{ProfileNewPassword}}", "confirmNewPassword": "{{ProfileNewPassword}}" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("Current password is invalid.")) == true

###

### [Positive][Profile] Change password: 200 and a rotated cookie set (200 expected)
# @name ChangePassword
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{ProfileCurrentPassword}}", "newPassword": "{{ProfileNewPassword}}", "confirmNewPassword": "{{ProfileNewPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200
?? js (response.parsedBody.message === "Password changed successfully.") == true
?? js (["__Host-arsm-access-token=","__Host-arsm-refresh-token=","__Host-arsm-csrf-token="].every(n => response.headers['set-cookie'].some(c => c.startsWith(n) && !c.startsWith(n + ";")))) == true

###

# Password change rotates the CSRF cookie too, so the requests below need the new value.

### [Positive][Profile] The session stays valid on the rotated cookies (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/auth/validate

?? status == 200
?? js response.parsedBody.mustChangePassword == false

###

### [Negative][Profile] The old password no longer logs in (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{ProfileMechanicEmail}}", "password": "{{ProfileCurrentPassword}}" }

?? status == 401
?? js response.parsedBody.title == invalid_credentials

###

### [Positive][Profile] The new password logs in (200 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{ProfileMechanicEmail}}", "password": "{{ProfileNewPassword}}" }

?? status == 200

###

### [Positive][Profile] Refresh succeeds on the rotated refresh cookie (204 expected)
# @name Refresh
POST {{AutoService_ApiService_HostAddress}}/api/auth/refresh
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 204

###

# Refresh rotates the CSRF cookie again, so the password restore below needs the new value.

### [Setup][Profile] Restore the original password (200 expected)
# Keeps the suite idempotent: every later mechanic login in this run needs the original password.
# @name ChangePassword
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{ProfileNewPassword}}", "newPassword": "{{ProfileCurrentPassword}}", "confirmNewPassword": "{{ProfileCurrentPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Profile] Logout with the rotated CSRF token (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Profile] Change password without authentication (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "currentPassword": "{{ProfileCurrentPassword}}", "newPassword": "{{ProfileNewPassword}}", "confirmNewPassword": "{{ProfileNewPassword}}" }

?? status == 401
