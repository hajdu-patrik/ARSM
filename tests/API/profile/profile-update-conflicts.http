# PUT /api/profile uniqueness: an email or phone of another mechanic or a customer is 400 with a naming message. The 409 for
# a race past the pre-check cannot be produced deterministically over HTTP and stays a recorded gap.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@PhoneTail = {{RunId.toString().slice(-6)}}
@ProfileMechanicEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@ProfileCurrentPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@KnownCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@ProfileConflictEmail = profile.conflict.{{RunId}}@example.test

### [Setup][Profile] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Profile] Login as admin to provision the profile conflict identity (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Profile] Register the mechanic whose email and phone the update collides with (200 expected)
# @name profileConflictMechanic
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Profile", "lastName": "Conflict", "email": "{{ProfileConflictEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "phoneNumber": "+36 30 6{{PhoneTail}}", "specialization": "GasolineAndDiesel", "expertise": ["Engine", "Brakes"] }

?? status == 200

###

### [Setup][Profile] Logout admin before the mechanic profile checks (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][Profile] Login as the shared plain mechanic (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{ProfileMechanicEmail}}", "password": "{{ProfileCurrentPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Profile] The email of another mechanic (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "email": "{{ProfileConflictEmail}}" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("An account already exists with this email address.")) == true

###

### [Negative][Profile] The same email in upper case is the same address (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "email": "  PROFILE.CONFLICT.{{RunId}}@EXAMPLE.TEST " }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("An account already exists with this email address.")) == true

###

### [Negative][Profile] The email of a customer (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "email": "{{KnownCustomerEmail}}" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("An account already exists with this email address.")) == true

###

### [Negative][Profile] The phone of another mechanic, written in another notation (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "phoneNumber": "06 30 6{{PhoneTail}}" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("An account already exists with this phone number.")) == true

###

### [Negative][Profile] The phone of a customer (400 expected)
PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "phoneNumber": "+36 30 444 5566" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("An account already exists with this phone number.")) == true

###

### [Setup][Profile] Logout the shared mechanic before deleting the conflict fixture (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][Profile] Login as admin to clean up the disposable conflict fixture (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Cleanup][Profile] Delete the disposable profile-conflict mechanic (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{profileConflictMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Setup][Profile] Logout admin after cleanup (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
