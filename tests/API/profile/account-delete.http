# DELETE /api/profile checks the missing password first (400), then the admin role BEFORE the password (403 for any admin),
# so the wrong-password case runs as a disposable non-admin. A successful delete expires every session cookie and kills the login.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestPassword = {{$processEnv ARSM_TEST_PASSWORD}}
@TestWrongPassword = {{$processEnv ARSM_TEST_WRONG_PASSWORD}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@DeleteRunSuffix = {{$timestamp}}
@DeleteSelfEmail = profile.delete.self.{{DeleteRunSuffix}}@example.test
@DeleteSelfPhoneSuffix = {{$randomInt 1000000 9999999}}
@DeleteSelfPhone = +3630{{DeleteSelfPhoneSuffix}}

### [Setup][Profile] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Profile] Login as admin for the self-delete negative tests (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Profile] Self-delete with an empty body (400 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{}

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("Current password is required.")) == true

###

### [Negative][Profile] Self-delete with a blank password (400 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "   " }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("Current password is required.")) == true

###

### [Negative][Profile] Admin self-delete is forbidden with the right password (403 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{AdminPassword}}" }

?? status == 403
?? js (response.parsedBody.detail === "Administrator accounts cannot be deleted.") == true

###

### [Negative][Profile] Admin self-delete is forbidden before the password is even checked (403 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{TestWrongPassword}}" }

?? status == 403
?? js (response.parsedBody.detail === "Administrator accounts cannot be deleted.") == true

###

### [Setup][Profile] Register the disposable non-admin mechanic for the self-delete flow (200 expected)
# @name regDeleteSelf
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Delete", "lastName": "Self", "email": "{{DeleteSelfEmail}}", "password": "{{TestPassword}}", "personType": "Mechanic", "phoneNumber": "{{DeleteSelfPhone}}", "specialization": "GasolineAndDiesel", "expertise": ["Engine", "Brakes"] }

?? status == 200

###

### [Setup][Profile] Logout admin before the non-admin self-delete (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][Profile] Login as the disposable non-admin mechanic (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{DeleteSelfEmail}}", "password": "{{TestPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Profile] Self-delete with a wrong password changes nothing (400 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{TestWrongPassword}}" }

?? status == 400
?? js (Object.values(response.parsedBody.errors).flat().includes("Current password is invalid.")) == true

###

### [Positive][Profile] The account is still there after the refused delete (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/profile

?? status == 200
?? js (response.parsedBody.personId == regDeleteSelf.personId) == true

###

### [Positive][Profile] Non-admin self-delete: 200 and every session cookie expired (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "currentPassword": "{{TestPassword}}" }

?? status == 200
?? js (response.parsedBody.message === "Profile deleted successfully.") == true
?? js (["__Host-arsm-access-token","__Host-arsm-refresh-token","__Host-arsm-csrf-token","__Host-autoservice_at","__Host-autoservice_rt","__Host-autoservice_csrf"].every(n => response.headers['set-cookie'].some(c => c.startsWith(n + "=;") && c.toLowerCase().includes("expires=thu, 01 jan 1970")))) == true

###

### [Negative][Profile] The deleted account can no longer log in (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{DeleteSelfEmail}}", "password": "{{TestPassword}}" }

?? status == 401
?? js response.parsedBody.title == invalid_credentials

###

### [Negative][Profile] The deleted account's phone is free and does not log in either (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "phoneNumber": "{{DeleteSelfPhone}}", "password": "{{TestPassword}}" }

?? status == 401

###

### [Negative][Profile] Unauthenticated self-delete (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "currentPassword": "{{TestPassword}}" }

?? status == 401
