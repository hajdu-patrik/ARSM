@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@TestWrongPassword = {{$processEnv ARSM_TEST_WRONG_PASSWORD}}
@ProfileMechanicEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@ProfileCurrentPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@ProfileNewPassword = {{$processEnv ARSM_TEST_MECHANIC_NEW_PASSWORD}}

### [Setup][Profile] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Profile] Login as non-admin mechanic (session prerequisite)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{ProfileMechanicEmail}}",
  "password": "{{ProfileCurrentPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Negative][Profile] Update firstName with space rejected (400 expected)
# "First name may only contain letters and hyphens."
### [Case][Profile] PUT /api/profile

PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Mary Jane"
}

?? status == 400

###

### [Negative][Profile] Update firstName with digit rejected (400 expected)
# "First name may only contain letters and hyphens."
### [Case][Profile] PUT /api/profile

PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "John2"
}

?? status == 400

###

### [Negative][Profile] Update lastName with apostrophe rejected (400 expected)
# "Last name may only contain letters and hyphens."
### [Case][Profile] PUT /api/profile

PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lastName": "O'Brien"
}

?? status == 400

###

### [Negative][Profile] Update middleName with space rejected (400 expected)
# "Middle name may only contain letters and hyphens."
### [Case][Profile] PUT /api/profile

PUT {{AutoService_ApiService_HostAddress}}/api/profile
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "middleName": "Van Der"
}

?? status == 400

###

### [Negative][Profile] Change password with wrong current password (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "currentPassword": "{{TestWrongPassword}}",
  "newPassword": "{{ProfileNewPassword}}",
  "confirmNewPassword": "{{ProfileNewPassword}}"
}

?? status == 400

###

### [Negative][Profile] Change password with too short new password (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "currentPassword": "{{ProfileCurrentPassword}}",
  "newPassword": "123",
  "confirmNewPassword": "123"
}

?? status == 400

###

### [Negative][Profile] Change password with confirmation mismatch (400 expected)
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "currentPassword": "{{ProfileCurrentPassword}}",
  "newPassword": "{{ProfileNewPassword}}",
  "confirmNewPassword": "{{ProfileNewPassword}}-mismatch"
}

?? status == 400

###

### [Positive][Profile] Change password (200 expected)
# @name ChangePassword
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "currentPassword": "{{ProfileCurrentPassword}}",
  "newPassword": "{{ProfileNewPassword}}",
  "confirmNewPassword": "{{ProfileNewPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# Password change rotates the CSRF cookie too, so the refresh below needs the new value.

### [Positive][Profile] Session still valid on the rotated cookies right after change-password
# ChangePasswordAsync revokes the caller's refresh tokens and issues a fresh access/refresh
# cookie pair; this proves the rotated cookies actually authenticate (200 expected).
GET {{AutoService_ApiService_HostAddress}}/api/auth/validate

?? status == 200

###

### [Positive][Profile] Refresh succeeds on the rotated refresh cookie after change-password (204 expected)
# @name Refresh
POST {{AutoService_ApiService_HostAddress}}/api/auth/refresh
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 204

###

# Refresh rotates the CSRF cookie again, so the password restore below needs the new value.

### [Setup][Profile] Restore the original password (200 expected)
# Keeps the suite idempotent: without this step the mechanic account keeps the new password until
# the next API restart re-seeds it, and every later mechanic login in the same run series fails.
# @name ChangePassword
POST {{AutoService_ApiService_HostAddress}}/api/profile/change-password
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "currentPassword": "{{ProfileNewPassword}}",
  "newPassword": "{{ProfileCurrentPassword}}",
  "confirmNewPassword": "{{ProfileCurrentPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

# This restore also rotates the CSRF cookie, so the logout below needs the new value.

### [Setup][Profile] Logout before unauthenticated profile check
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Profile] Get profile without authentication (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/profile

?? status == 401
