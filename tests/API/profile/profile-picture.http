# No picture ever gets uploaded here, so every check proves the no-picture-yet / never-304 paths only;
# the genuine ETag-match round trip is covered by profile-picture-upload-check.py - see tests/CLAUDE.md.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@NonAdminEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@NonAdminPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}
@NonExistentPersonId = 99999

### [Setup][Profile] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Profile] Login as admin first, capture the admin's own person id
# @name adminPictureLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Profile] Logout admin before the non-admin mechanic session
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][Profile] Login as non-admin mechanic, capture their own person id
# @name nonAdminPictureLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{NonAdminEmail}}",
  "password": "{{NonAdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][Profile] Get own profile picture (200/304 if a picture exists, 404 if none)
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture

?? status != 401
?? status != 403
?? status < 500

###

### [Positive][Profile] Conditional get own profile picture with a non-matching ETag
# Never 304 here: the placeholder If-None-Match value cannot match a real stored ETag, and when no
# picture exists the handler returns 404 before If-None-Match is even read.
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture
If-None-Match: "no-picture-uploaded-by-this-file"

?? status != 304
?? status != 401
?? status != 403
?? status < 500

###

### [Negative][Profile] Non-admin cannot get the admin's profile picture by person id (403 expected)
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture/{{adminPictureLogin.personId}}

?? status == 403

###

### [Setup][Profile] Logout non-admin before admin picture checks
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Setup][Profile] Login as admin for person-id picture checks
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Positive][Profile] Admin can get the mechanic's profile picture by person id (200/304 if a picture exists, 404 if none)
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture/{{nonAdminPictureLogin.personId}}

?? status != 401
?? status != 403
?? status < 500

###

### [Positive][Profile] Admin conditional get with a non-matching ETag (never 304, see file header)
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture/{{nonAdminPictureLogin.personId}}
If-None-Match: "no-picture-uploaded-by-this-file"

?? status != 304
?? status != 401
?? status != 403
?? status < 500

###

### [Negative][Profile] Get profile picture for non-existent person id (404 expected)
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture/{{NonExistentPersonId}}

?? status == 404

###

### [Manual][Profile] Open realtime profile picture updates stream (authorized SSE)
# SSE streams never complete a normal HTTP response, so this is not automated; verify manually by
# opening GET .../profile/picture/updates and confirming a "profile-picture-updated" event on change.

###

### [Note][Profile] Multipart upload edge checks are automated by the local test runner
# python scripts/run-local-test-suite.py http runs profile-picture-upload-check.py after HTTPYAC for
# the multipart upload, magic-byte and stored-ETag checks this file skips - see tests/CLAUDE.md.

###

### [Positive][Profile] Remove own (admin) profile picture (200 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/profile/picture
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Setup][Profile] Logout before unauthenticated picture checks
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][Profile] Unauthenticated get profile picture (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture

?? status == 401

###

### [Negative][Profile] Unauthenticated get profile picture by person id (401 expected)
# @no-cookie-jar
# Any integer id works: the group's RequireAuthorization answers 401 before the handler loads the person,
# and a fixed id keeps this check independent of whether an earlier login in this file succeeded.
GET {{AutoService_ApiService_HostAddress}}/api/profile/picture/999999

?? status == 401

###

### [Negative][Profile] Unauthenticated delete profile picture (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/profile/picture
Origin: {{WebUI_Origin}}

?? status == 401
