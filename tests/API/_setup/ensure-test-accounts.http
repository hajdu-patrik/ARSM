# Provisions the shared plain-mechanic account other suites log in as; httpyac's file order across
# tests/API/**/*.http is not guaranteed, so this never assumes it runs first (fix tests/.env on a stale-password 401).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@MechanicEmail = {{$processEnv ARSM_TEST_MECHANIC_EMAIL}}
@MechanicPassword = {{$processEnv ARSM_TEST_MECHANIC_PASSWORD}}


### [Setup] Clear any session cookie left by a previous file (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup] Probe the plain mechanic test login (not asserted - the repair step below decides)
# @name mechanicProbe
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{MechanicEmail}}",
  "password": "{{MechanicPassword}}"
}

###

### [Setup] Clear the probe session before the admin login (204 or 401, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup] Login as admin to provision the shared plain-mechanic test account (200 expected)
# @name Login
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup] List mechanics to find a stale plain-mechanic test account (200 expected)
# @name allMechanics
GET {{AutoService_ApiService_HostAddress}}/api/admin/mechanics

?? status == 200

###

### [Repair] Delete the plain mechanic test account only when its login failed (200 expected per delete)
# Self-healing: a stale password left by an earlier non-idempotent test is fixed by deleting and
# re-registering below, only when the probe login failed, and only for an '@example.test' address (never an admin or a demo '@example.com' account).
# @loop for staleMechanic of (mechanicProbe && mechanicProbe.personId ? [] : allMechanics.filter(m => !m.isAdmin && m.email.toLowerCase() === MechanicEmail.toLowerCase() && m.email.toLowerCase().endsWith("@example.test")))
DELETE {{AutoService_ApiService_HostAddress}}/api/admin/mechanics/{{staleMechanic.personId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Setup] Register the plain mechanic test account if it does not already exist
# Register answers 200 for a fresh account or 400 for ANY conflict (same generic message, by design, to
# avoid enumeration); both are valid here since an earlier run may already have created this account.
POST {{AutoService_ApiService_HostAddress}}/api/auth/register
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Mechanic",
  "email": "{{MechanicEmail}}",
  "password": "{{MechanicPassword}}",
  "personType": "Mechanic",
  "specialization": "GasolineAndDiesel",
  "expertise": ["Engine", "Brakes"]
}

?? js [200, 400].includes(response.statusCode) == true

###

### [Setup] Logout admin before proving the plain-mechanic account can log in (204 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Positive] Plain mechanic test account logs in (200 expected)
# After the repair step this should succeed. A persisting 401 means a demo '@example.com' mechanic (never
# reset here) or an undeletable account (e.g. 422 sole appointment assignee) - fix tests/.env.
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{MechanicEmail}}",
  "password": "{{MechanicPassword}}"
}

?? status == 200
