### [Setup][Fixtures] Resolve the fixture part (200 expected)
# @name fixturePart
GET {{AutoService_ApiService_HostAddress}}/api/parts?search=OLF-1001&pageSize=500

?? status == 200
?? js (response.parsedBody.items.some(p => p.partNumber === 'OLF-1001')) == true

###

### [Setup][Fixtures] Resolve the fixture labor type (200 expected)
# @name fixtureLaborType
GET {{AutoService_ApiService_HostAddress}}/api/labor-types?search=OLAJCSERE&pageSize=500

?? status == 200
?? js (response.parsedBody.items.some(l => l.code === 'OLAJCSERE')) == true

###

### [Setup][Fixtures] Resolve the primary customer's vehicles after the creates above (200 expected)
# @name fixtureVehicles
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{FixtureCustomerEmail}}

{{
  exports.AnchorVehicleId = fixtureVehicles.vehicles.find(v => v.licensePlate === 'ABC-101')?.id;
}}

?? status == 200
?? js (response.parsedBody.vehicles.some(v => v.licensePlate === 'ABC-101')) == true
?? js (response.parsedBody.vehicles.some(v => v.licensePlate === 'ABC-102')) == true

###

### [Setup][Fixtures] Probe for the anchor draft quote (200 expected)
# @name anchorProbe
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=ARSM%20fixture%20anchor%20quote&pageSize=500

?? status == 200

###

### [Setup][Fixtures] Create the anchor draft quote on vehicle ABC-101 only while it is missing (201 expected)
# @loop for missing of (anchorProbe.items.some(q => q.title === 'ARSM fixture anchor quote') ? [] : [1])
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "ARSM fixture anchor quote", "notes": "Shared fixture created by tests/API/_setup; never mutated by a suite" }

?? status == 201

###

### [Setup][Fixtures] Re-read the anchor quote for its id and version (200 expected)
# @name anchorBeforeLines
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=ARSM%20fixture%20anchor%20quote&pageSize=500

{{
  exports.AnchorQuoteId = anchorBeforeLines.items.find(q => q.title === 'ARSM fixture anchor quote')?.id;
  exports.AnchorQuoteVersion = anchorBeforeLines.items.find(q => q.title === 'ARSM fixture anchor quote')?.version;
}}

?? status == 200

###

### [Setup][Fixtures] Add the catalog part line to a newly created anchor quote (201 expected)
# @loop for missing of (anchorProbe.items.some(q => q.title === 'ARSM fixture anchor quote') ? [] : [1])
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{AnchorQuoteId}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "lineKind": "Part", "quantity": 2, "partId": {{fixturePart.items.find(p => p.partNumber === 'OLF-1001').id}}, "version": {{AnchorQuoteVersion}} }

?? status == 201

###

### [Setup][Fixtures] Re-read the anchor quote for the version after its first line (200 expected)
# @name anchorAfterPartLine
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=ARSM%20fixture%20anchor%20quote&pageSize=500

{{
  exports.AnchorQuoteVersion = anchorAfterPartLine.items.find(q => q.title === 'ARSM fixture anchor quote')?.version;
}}

?? status == 200

###

### [Setup][Fixtures] Add the catalog labor line to a newly created anchor quote (201 expected)
# @loop for missing of (anchorProbe.items.some(q => q.title === 'ARSM fixture anchor quote') ? [] : [1])
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{AnchorQuoteId}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "lineKind": "Labor", "quantity": 1, "laborTypeId": {{fixtureLaborType.items.find(l => l.code === 'OLAJCSERE').id}}, "version": {{AnchorQuoteVersion}} }

?? status == 201

###

### [Setup][Fixtures] The anchor quote exists with a part line and a labor line (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{AnchorQuoteId}}

?? status == 200
?? js (response.parsedBody.lines.some(l => l.lineKind == "Part") && response.parsedBody.lines.some(l => l.lineKind == "Labor")) == true
