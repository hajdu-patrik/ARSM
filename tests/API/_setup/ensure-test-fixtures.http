# Idempotent shared fixtures for the HTTP suite (a fresh database holds no customers, vehicles, catalog rows or quotes): every create accepts 409 for "already there",
# the anchor quote and its lines are created only while the quote is missing. Other files address these rows by email, plate or title and never change them.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@FixtureCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@SecondFixtureCustomerEmail = fixture.second@example.test


### [Setup][Fixtures] Clear any session cookie left by a previous file (204, 401 or 403, not asserted)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}

###

### [Setup][Fixtures] Login as the bootstrap admin (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Fixtures] Ensure the primary fixture customer (201 created or 409 already there)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Fixture", "middleName": null, "lastName": "Primary", "email": "{{FixtureCustomerEmail}}", "phoneNumber": "+36304445566" }

?? js [201, 409].includes(response.statusCode) == true

###

### [Setup][Fixtures] Ensure the second fixture customer (201 created or 409 already there)
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "Fixture", "middleName": null, "lastName": "Second", "email": "{{SecondFixtureCustomerEmail}}", "phoneNumber": null }

?? js [201, 409].includes(response.statusCode) == true

###

### [Setup][Fixtures] Resolve the primary fixture customer (200 expected)
# @name fixtureCustomerA
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{FixtureCustomerEmail}}

?? status == 200

###

### [Setup][Fixtures] Resolve the second fixture customer (200 expected)
# @name fixtureCustomerB
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{SecondFixtureCustomerEmail}}

?? status == 200

###

### [Setup][Fixtures] Ensure primary vehicle ABC-101 (201 created or 409 already there)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomerA.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "ABC-101", "vin": "WVWZZZAUZJW123456", "brand": "Volkswagen", "model": "Golf", "year": 2018, "mileageKm": 124500, "enginePowerKw": 81, "drivetrainType": "Petrol" }

?? js [201, 409].includes(response.statusCode) == true

###

### [Setup][Fixtures] Ensure primary customer's second vehicle ABC-102 (201 created or 409 already there)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomerA.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "ABC-102", "vin": "WVWZZZAUZJW123457", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Diesel" }

?? js [201, 409].includes(response.statusCode) == true

###

### [Setup][Fixtures] Ensure the second customer's vehicle ABC-201 (201 created or 409 already there)
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomerB.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "ABC-201", "vin": "WVWZZZAUZJW123458", "brand": "Peugeot", "model": "308", "year": 2019, "mileageKm": 80000, "enginePowerKw": 96, "drivetrainType": "Diesel" }

?? js [201, 409].includes(response.statusCode) == true

###

### [Setup][Fixtures] Ensure the catalog part OLF-1001 (201 created or 409 already there)
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "partNumber": "OLF-1001", "name": "Fixture oil filter", "netUnitPrice": 4500, "vatRatePercent": 27 }

?? js [201, 409].includes(response.statusCode) == true

###

### [Setup][Fixtures] Ensure the labor type OLAJCSERE (201 created or 409 already there)
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "code": "OLAJCSERE", "name": "Fixture oil change", "hourlyNetRate": 12000, "vatRatePercent": 27 }

?? js [201, 409].includes(response.statusCode) == true

