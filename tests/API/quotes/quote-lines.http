@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@NonExistentCatalogId = 999999999

### [Setup][QuoteLines] Login as admin (MechanicOnly prerequisite)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][QuoteLines] Resolve the demo vehicle anchor from the seeded quotes (200 expected)
# Vehicle ids depend on the local DB's insert history, so this resolves the demo vehicle anchor via the
# seeded quote's stable QuoteNumber (D13) instead of a literal id that would 404 on another machine.
# @name seedQuotes
GET {{AutoService_ApiService_HostAddress}}/api/quotes

{{
  exports.AnchorVehicleId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0001').vehicleId;
}}

?? status == 200

###

### [Setup][QuoteLines] Create a disposable part fixture for the catalog line checks below (201 expected)
# @name createdPart
POST {{AutoService_ApiService_HostAddress}}/api/parts
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "partNumber": "ZZL{{RunId}}A",
  "name": "Quote Line Fixture Part",
  "netUnitPrice": 1234,
  "vatRatePercent": 27
}

?? status == 201

###

### [Setup][QuoteLines] Create a draft quote fixture for line validation (201 expected)
# @name draftQuote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Quote Line Fixture {{RunId}}"
}

?? status == 201

###

### [Positive][QuoteLines] Add catalog part line with no override (201 expected, snapshot fills description/price/VAT from the disposable Part fixture, D40)
# @name catalogLine
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "partId": {{createdPart.id}},
  "version": {{draftQuote.version}}
}

?? status == 201

###

### [Positive][QuoteLines] Add catalog part line with an explicit override (201 expected, override NetUnitPrice wins over the Part snapshot, D40)
# @name overrideLine
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "partId": {{createdPart.id}},
  "netUnitPrice": 4321,
  "version": {{catalogLine.version}}
}

?? status == 201

###

### [Negative][QuoteLines] Add line with no catalog id and no manual fields (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "version": {{overrideLine.version}}
}

?? status == 422

###

### [Negative][QuoteLines] Add line with a non-existent PartId (404 expected; a non-existent LaborTypeId shares the same lookup path)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "partId": {{NonExistentCatalogId}},
  "version": {{overrideLine.version}}
}

?? status == 404

###

### [Negative][QuoteLines] NetUnitPrice over the 100,000,000 cap is rejected (422 expected, D24)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "description": "Over-priced manual line",
  "netUnitPrice": 100000001,
  "vatRatePercent": 27,
  "version": {{overrideLine.version}}
}

?? status == 422

###

### [Negative][QuoteLines] Quantity over the 10,000 cap is rejected (422 expected, D24)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 10001,
  "description": "Over-quantity manual line",
  "netUnitPrice": 100,
  "vatRatePercent": 27,
  "version": {{overrideLine.version}}
}

?? status == 422

###

### [Setup][QuoteLines] Send the fixture quote, reusing its 2 existing lines (200 expected)
# @name sentQuote
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Sent",
  "version": {{overrideLine.version}}
}

?? status == 200

###

### [Negative][QuoteLines] Adding a line to a Sent quote is rejected (409 expected, Draft-only lock; update/delete share the same lock, see quotes-validation.http for the Title-edit sibling case)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{draftQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "description": "Should not be added",
  "netUnitPrice": 100,
  "vatRatePercent": 27,
  "version": {{sentQuote.version}}
}

?? status == 409

###

### [Cleanup][QuoteLines] Delete the disposable part fixture (204 expected, SetNull on delete leaves the quote's line snapshots intact, D4)
DELETE {{AutoService_ApiService_HostAddress}}/api/parts/{{createdPart.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
