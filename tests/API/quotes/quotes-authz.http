@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@SomeVersion = 1

# COVERAGE GAP: a MechanicOnly 403 for an authenticated-but-not-mechanic caller cannot be produced
# against the live API today (no fabricated token) - see tests/CLAUDE.md Coverage Anchors.

### [Setup][QuotesAuthz] Login as admin to resolve real ids for the checks below (200 expected)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][QuotesAuthz] Resolve the demo quote and vehicle anchors from the seeded quotes (200 expected)
# @name seedQuotes
GET {{AutoService_ApiService_HostAddress}}/api/quotes

{{
  exports.SomeVehicleId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0001').vehicleId;
  exports.SomeQuoteId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0001').id;
}}

?? status == 200

###

### [Setup][QuotesAuthz] Resolve that quote's first line id (200 expected)
# @name seedQuoteDetail
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}

{{
  exports.SomeQuoteLineId = seedQuoteDetail.lines[0].id;
}}

?? status == 200

###

### [Setup][QuotesAuthz] Logout before unauthenticated checks (204 expected, the login above guarantees a live session)
POST {{AutoService_ApiService_HostAddress}}/api/auth/logout
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Negative][QuotesAuthz] Unauthenticated list quotes (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/quotes

?? status == 401

###

### [Negative][QuotesAuthz] Unauthenticated get quote by id (401 expected)
# @no-cookie-jar
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}

?? status == 401

###

### [Negative][QuotesAuthz] Unauthenticated update quote (401 expected)
# @no-cookie-jar
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Unauthenticated",
  "notes": null,
  "version": {{SomeVersion}}
}

?? status == 401

###

### [Negative][QuotesAuthz] Unauthenticated delete quote (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}?version={{SomeVersion}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 401

###

### [Negative][QuotesAuthz] Unauthenticated add quote line (401 expected)
# @no-cookie-jar
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "description": "Unauthenticated",
  "netUnitPrice": 100,
  "vatRatePercent": 27,
  "version": {{SomeVersion}}
}

?? status == 401

###

### [Negative][QuotesAuthz] Unauthenticated update quote line (401 expected)
# @no-cookie-jar
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}/lines/{{SomeQuoteLineId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "description": "Unauthenticated",
  "netUnitPrice": 100,
  "vatRatePercent": 27,
  "version": {{SomeVersion}}
}

?? status == 401

###

### [Negative][QuotesAuthz] Unauthenticated delete quote line (401 expected)
# @no-cookie-jar
DELETE {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}/lines/{{SomeQuoteLineId}}?version={{SomeVersion}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 401

