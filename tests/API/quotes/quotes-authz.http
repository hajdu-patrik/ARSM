POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{SomeQuoteId}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Sent",
  "version": {{SomeVersion}}
}

