# Split from quotes-crud-happy.http for the 250-line test file limit: creates a disposable draft quote
# on the fixture anchor vehicle and deletes it (only a Draft is deletable).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}

### [Setup][Quotes] Login as admin (MechanicOnly prerequisite)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-autoservice_csrf='))?.match(/^__Host-autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###
### [Setup][Quotes] Resolve the anchor vehicle from the fixture anchor quote (200 expected)
# Vehicle ids depend on the local DB's insert history, so the anchor vehicle is resolved via the fixture anchor
# quote's stable title (created by tests/API/_setup) instead of a literal id that would 404 on another machine.
# @name anchorQuotes
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=ARSM%20fixture%20anchor%20quote&pageSize=500

{{
  exports.AnchorVehicleId = anchorQuotes.items.find(q => q.title === 'ARSM fixture anchor quote').vehicleId;
}}

?? status == 200

### [Positive][Quotes] Create a second draft quote for the delete happy path (201 expected)
# @name deletableQuote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "CRUD Happy Deletable Quote {{RunId}}"
}

?? status == 201

###

### [Positive][Quotes] Delete the draft quote (204 expected, D7: only Draft is deletable)
DELETE {{AutoService_ApiService_HostAddress}}/api/quotes/{{deletableQuote.id}}?version={{deletableQuote.version}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
