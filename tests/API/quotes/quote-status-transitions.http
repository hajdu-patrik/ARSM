# POST /api/quotes/{id}/status from Draft and Sent (D7): the one allowed move out of each, every refused move, the no-line
# rule, the SentAt and DecidedAt stamps. Accepted and Rejected are terminal (quote-*-terminal.http). Disposable customer.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@FixtureCustomerEmail = quote.status.customer.{{RunId}}@example.test
@FixtureVehicleVin = TST{{RunId.toString().slice(-10)}}0733

### [Setup][QuoteStatus] Login as admin (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][QuoteStatus] Create the disposable customer (201 expected)
# @name customer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "QuoteStatus", "middleName": null, "lastName": "Fixture", "email": "{{FixtureCustomerEmail}}", "phoneNumber": null }

?? status == 201

### [Setup][QuoteStatus] Create the customer vehicle (201 expected)
# @name vehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "QST-{{RunId}}", "vin": "{{FixtureVehicleVin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

### [Setup][QuoteStatus] Create a draft quote with no lines (201 expected)
# @name noLines
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{vehicle.id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Status No Lines {{RunId}}" }

?? status == 201

### [Negative][QuoteStatus] Sending a quote with no lines is refused (409 expected, D21)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{noLines.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Sent", "version": {{noLines.version}} }

?? status == 409
?? js response.parsedBody.detail includes A quote must have at least one line before it can be sent

### [Negative][QuoteStatus] Draft to Draft is not a transition (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{noLines.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Draft", "version": {{noLines.version}} }

?? status == 409
?? js response.parsedBody.detail includes Cannot transition a quote from Draft to Draft

### [Setup][QuoteStatus] Create the quote that goes through the state machine (201 expected)
# @name main
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{vehicle.id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Status Main {{RunId}}" }

?? status == 201

### [Setup][QuoteStatus] Add a line so the quote can be sent (201 expected)
# @name mainLine
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "lineKind": "Part", "quantity": 1, "description": "Status fixture line", "netUnitPrice": 100, "vatRatePercent": 27, "version": {{main.version}} }

?? status == 201

### [Negative][QuoteStatus] Draft to Accepted skips Sent (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Accepted", "version": {{mainLine.version}} }

?? status == 409
?? js response.parsedBody.detail includes Cannot transition a quote from Draft to Accepted

### [Negative][QuoteStatus] Draft to Rejected skips Sent (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Rejected", "version": {{mainLine.version}} }

?? status == 409
?? js response.parsedBody.detail includes Cannot transition a quote from Draft to Rejected

### [Negative][QuoteStatus] An unknown status name is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Bogus", "version": {{mainLine.version}} }

?? status == 422
?? js response.parsedBody.detail includes Status must be one of: Draft, Sent, Accepted, Rejected

### [Negative][QuoteStatus] A numeric status that names no member is refused (422 expected, "9" is not one of the four)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "9", "version": {{mainLine.version}} }

?? status == 422

### [Negative][QuoteStatus] An empty status is refused (422 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "", "version": {{mainLine.version}} }

?? status == 422

### [Positive][QuoteStatus] The refused moves left the quote a draft (200 expected, no SentAt yet)
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}

?? status == 200
?? js (response.parsedBody.status === "Draft" && response.parsedBody.sentAt == null && response.parsedBody.decidedAt == null && response.parsedBody.version === mainLine.version) == true

### [Positive][QuoteStatus] Draft to Sent, the status name ignores case (200 expected, SentAt stamped, lines and totals kept)
# @name sent
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "sent", "version": {{mainLine.version}} }

?? status == 200
?? js (response.parsedBody.status === "Sent" && response.parsedBody.decidedAt == null && response.parsedBody.sentAt != null && Math.abs(new Date(response.parsedBody.sentAt).getTime() - Date.now()) < 86400000) == true
?? js (response.parsedBody.version !== mainLine.version && response.parsedBody.lines.length === 1 && response.parsedBody.totalNet === 100 && response.parsedBody.canDelete === false && response.parsedBody.isExpired === false) == true

### [Negative][QuoteStatus] Sent to Draft is refused (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Draft", "version": {{sent.version}} }

?? status == 409
?? js response.parsedBody.detail includes Cannot transition a quote from Sent to Draft

### [Negative][QuoteStatus] Sent to Sent is refused, a second send mails nothing (409 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Sent", "version": {{sent.version}} }

?? status == 409
?? js response.parsedBody.detail includes Cannot transition a quote from Sent to Sent

### [Positive][QuoteStatus] Sent to Accepted (200 expected, DecidedAt stamped, SentAt kept)
# @name accepted
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Accepted", "version": {{sent.version}} }

?? status == 200
?? js (response.parsedBody.status === "Accepted" && response.parsedBody.decidedAt != null && Math.abs(new Date(response.parsedBody.sentAt) - new Date(sent.sentAt)) < 1000 && new Date(response.parsedBody.decidedAt) >= new Date(response.parsedBody.sentAt)) == true
?? js (response.parsedBody.canDelete === false && response.parsedBody.version !== sent.version && response.parsedBody.isLocked === false) == true

### [Positive][QuoteStatus] The accepted state is persisted (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{main.id}}

?? status == 200
?? js (response.parsedBody.status === "Accepted" && response.parsedBody.version === accepted.version && response.parsedBody.sentAt != null && response.parsedBody.decidedAt != null) == true

### [Cleanup][QuoteStatus] Delete the disposable customer, cascading vehicle and quotes (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
