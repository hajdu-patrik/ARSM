# search on GET /api/quotes matches the quote number, the title and the license plate, ignores case and surrounding blanks,
# treats % and _ literally and combines with status and vehicleId. Disposable customer, deleted at the end (cascade).

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}
@FixtureCustomerEmail = quote.search.customer.{{RunId}}@example.test
@FixtureVehicleVin = TST{{RunId.toString().slice(-10)}}0740

### [Setup][QuoteSearch] Login as admin (200 expected)
# @name adminLogin
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{ "email": "{{AdminEmail}}", "password": "{{AdminPassword}}" }

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-arsm-csrf-token='))?.match(/^__Host-arsm-csrf-token=([^;]+)/)?.[1];
}}

?? status == 200

### [Setup][QuoteSearch] Create the disposable customer (201 expected)
# @name customer
POST {{AutoService_ApiService_HostAddress}}/api/customers
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "firstName": "QuoteSearch", "middleName": null, "lastName": "Fixture", "email": "{{FixtureCustomerEmail}}", "phoneNumber": null }

?? status == 201

### [Setup][QuoteSearch] Create the customer vehicle (201 expected)
# @name vehicle
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}/vehicles
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "licensePlate": "QSR-{{RunId}}", "vin": "{{FixtureVehicleVin}}", "brand": "Skoda", "model": "Octavia", "year": 2020, "mileageKm": 45000, "enginePowerKw": 110, "drivetrainType": "Petrol" }

?? status == 201

### [Setup][QuoteSearch] Create draft quote Alpha (201 expected)
# @name searchA
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{vehicle.id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Search Quote Alpha {{RunId}}" }

?? status == 201

### [Setup][QuoteSearch] Create draft quote Bravo (201 expected)
# @name searchB
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{vehicle.id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Search Quote Bravo {{RunId}}" }

?? status == 201

### [Setup][QuoteSearch] Create quote Charlie (201 expected)
# @name searchC
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{vehicle.id}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "title": "Search Quote Charlie {{RunId}}" }

?? status == 201

### [Setup][QuoteSearch] Add a line to Charlie so it can be sent (201 expected)
# @name searchCLine
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{searchC.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "lineKind": "Part", "quantity": 1, "description": "Search line", "netUnitPrice": 100, "vatRatePercent": 27, "version": {{searchC.version}} }

?? status == 201

### [Setup][QuoteSearch] Send Charlie (200 expected, no-op mail sender in the test environment)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{searchC.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{ "status": "Sent", "version": {{searchCLine.version}} }

?? status == 200

### [Positive][QuoteSearch] By the quote number (200 expected, one row)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?vehicleId={{vehicle.id}}&search={{searchB.quoteNumber}}

?? status == 200
?? js (response.parsedBody.totalCount === 1 && response.parsedBody.items[0].id === searchB.id) == true

### [Positive][QuoteSearch] By the title in lower case (200 expected, one row)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=search%20quote%20alpha%20{{RunId}}

?? status == 200
?? js (response.parsedBody.totalCount === 1 && response.parsedBody.items[0].id === searchA.id) == true

### [Positive][QuoteSearch] By part of the title with blanks around it (200 expected, trimmed)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?vehicleId={{vehicle.id}}&search=%20%20bravo%20%20

?? status == 200
?? js (response.parsedBody.totalCount === 1 && response.parsedBody.items[0].id === searchB.id) == true

### [Positive][QuoteSearch] By the license plate in lower case (200 expected, all three quotes of the vehicle)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=qsr-{{RunId}}

?? status == 200
?? js (response.parsedBody.totalCount === 3 && response.parsedBody.items.every(q => q.vehicleId === vehicle.id)) == true

### [Positive][QuoteSearch] A blank search is ignored (200 expected, no filter)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?vehicleId={{vehicle.id}}&search=%20%20%20

?? status == 200
?? js (response.parsedBody.totalCount === 3) == true

### [Positive][QuoteSearch] A search without a match is an empty page (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=zz-no-such-quote-{{RunId}}

?? status == 200
?? js (response.parsedBody.items.length === 0 && response.parsedBody.totalCount === 0 && response.parsedBody.page === 1) == true

### [Positive][QuoteSearch] A percent sign is searched literally, not as a wildcard (200 expected, nothing matches)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?vehicleId={{vehicle.id}}&search=%25

?? status == 200
?? js (response.parsedBody.totalCount === 0) == true

### [Positive][QuoteSearch] An underscore is searched literally too (200 expected, nothing matches)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?vehicleId={{vehicle.id}}&search=_

?? status == 200
?? js (response.parsedBody.totalCount === 0) == true

### [Positive][QuoteSearch] Search with status=Sent narrows to the sent quote (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search={{RunId}}&status=Sent

?? status == 200
?? js (response.parsedBody.totalCount === 1 && response.parsedBody.items[0].id === searchC.id && response.parsedBody.items[0].status === "Sent") == true

### [Positive][QuoteSearch] Search with status=Draft keeps the two drafts (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search={{RunId}}&status=Draft

?? status == 200
?? js (response.parsedBody.totalCount === 2 && response.parsedBody.items.every(q => q.status === "Draft")) == true

### [Negative][QuoteSearch] An invalid status is still refused together with a search (422 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search={{RunId}}&status=Bogus

?? status == 422

### [Cleanup][QuoteSearch] Delete the disposable customer, cascading vehicle and quotes (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/customers/{{customer.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
