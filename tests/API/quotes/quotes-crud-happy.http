@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}

### [Setup][Quotes] Login as admin (MechanicOnly prerequisite)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][Quotes] Resolve the demo vehicle anchor from the seeded quotes (200 expected)
# Vehicle ids depend on the local DB's insert history, so this resolves the demo vehicle anchor via the
# seeded quote's stable QuoteNumber (D13) instead of a literal id that would 404 on another machine.
# @name seedQuotes
GET {{AutoService_ApiService_HostAddress}}/api/quotes

{{
  exports.AnchorVehicleId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0001').vehicleId;
}}

?? status == 200

###

### [Setup][Quotes] Create a disposable labor type fixture for the catalog line below (201 expected)
# @name createdLaborType
POST {{AutoService_ApiService_HostAddress}}/api/labor-types
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "code": "ZZQ{{RunId}}A",
  "name": "Quotes Happy Labor Fixture",
  "hourlyNetRate": 5000,
  "vatRatePercent": 27
}

?? status == 201

###

### [Positive][Quotes] Create draft quote with no ValidUntil (201 expected, validUntil defaults to now + 30 days, D22)
# @name createdQuote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "CRUD Happy Quote {{RunId}}",
  "notes": "Created by the quotes-crud-happy suite"
}

?? status == 201

###

### [Positive][Quotes] Get created quote by id (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}

?? status == 200

###

### [Positive][Quotes] List the anchor vehicle's quotes (200 expected, includes the created quote)
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes

?? status == 200

###

### [Positive][Quotes] List quotes filtered by vehicleId and Draft status (200 expected)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?vehicleId={{AnchorVehicleId}}&status=Draft

?? status == 200

###

### [Positive][Quotes] Update draft quote title and notes (200 expected)
# @name updatedQuote
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "CRUD Happy Quote {{RunId}} Updated",
  "notes": "Updated by the quotes-crud-happy suite",
  "version": {{createdQuote.version}}
}

?? status == 200

###

### [Positive][Quotes] Extend draft quote's ValidUntil (200 expected, Draft accepts any future date)
# @name extendedQuote
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}/valid-until
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "validUntil": "2027-06-01T00:00:00",
  "version": {{updatedQuote.version}}
}

?? status == 200

###

### [Positive][Quotes] Add a manual part line (201 expected, no catalog reference)
# @name lineAdded1
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 2,
  "description": "Manual brake pad set",
  "netUnitPrice": 15000,
  "vatRatePercent": 27,
  "version": {{extendedQuote.version}}
}

?? status == 201

###

### [Positive][Quotes] Add a catalog labor line (201 expected, snapshot from the disposable LaborType fixture created above)
# @name lineAdded2
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}/lines
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Labor",
  "quantity": 1,
  "laborTypeId": {{createdLaborType.id}},
  "version": {{lineAdded1.version}}
}

?? status == 201

###

### [Positive][Quotes] Update the manual part line's quantity (200 expected)
# @name lineUpdated
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}/lines/{{lineAdded2.lines[0].id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 3,
  "description": "Manual brake pad set",
  "netUnitPrice": 15000,
  "vatRatePercent": 27,
  "version": {{lineAdded2.version}}
}

?? status == 200

###

### [Positive][Quotes] Remove the catalog labor line (200 expected, returns the updated quote, not 204)
# @name lineDeleted
DELETE {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}/lines/{{lineUpdated.lines[1].id}}?version={{lineUpdated.version}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 200

###

### [Cleanup][Quotes] Delete the disposable labor type fixture now that no quote line references it (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/labor-types/{{createdLaborType.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204

###

### [Positive][Quotes] Transition draft quote to Sent (200 expected, at least one line remains)
# @name sentQuote
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Sent",
  "version": {{lineDeleted.version}}
}

?? status == 200

###

### [Positive][Quotes] Transition sent quote to Accepted (200 expected)
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{createdQuote.id}}/status
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "status": "Accepted",
  "version": {{sentQuote.version}}
}

?? status == 200

###
