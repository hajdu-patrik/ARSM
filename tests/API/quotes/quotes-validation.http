# ValidUntil status-matrix scenarios (Sent/Accepted lock behavior) live in the sibling
# quotes-validity-matrix.http, split out to keep both files under the 250-line limit.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@FixtureCustomerEmail = {{$processEnv ARSM_TEST_CUSTOMER_EMAIL}}
@RunId = {{$timestamp}}

### [Setup][QuotesValidation] Login as admin (MechanicOnly prerequisite)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('__Host-autoservice_csrf='))?.match(/^__Host-autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][QuotesValidation] Resolve the anchor vehicle from the fixture anchor quote (200 expected)
# Vehicle ids depend on the local DB's insert history, so the anchor vehicle is resolved via the fixture anchor
# quote's stable title (created by tests/API/_setup) instead of a literal id that would 404 on another machine.
# @name anchorQuotes
GET {{AutoService_ApiService_HostAddress}}/api/quotes?search=ARSM%20fixture%20anchor%20quote&pageSize=500

{{
  exports.AnchorVehicleId = anchorQuotes.items.find(q => q.title === 'ARSM fixture anchor quote').vehicleId;
}}

?? status == 200

###

### [Setup][QuotesValidation] Resolve the shared fixture customer and a second vehicle of it (200 expected)
# The second vehicle is a vehicle other than the anchor's, used below for the D42 appointment mismatch case.
# @name fixtureCustomer
GET {{AutoService_ApiService_HostAddress}}/api/customers/by-email?email={{FixtureCustomerEmail}}

{{
  exports.OtherVehicleId = fixtureCustomer.vehicles.find(v => v.id !== AnchorVehicleId).id;
}}

?? status == 200

###

### [Setup][QuotesValidation] Create an appointment on the anchor vehicle (201 expected, deleted at the end)
# Used below against the other vehicle for the D42 mismatch case; an admin-created appointment may carry any scheduled date.
# @name anchorAppointment
POST {{AutoService_ApiService_HostAddress}}/api/customers/{{fixtureCustomer.id}}/appointments
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "vehicleId": {{AnchorVehicleId}},
  "scheduledDate": "2026-04-18T10:30:00",
  "taskDescription": "Quote validation foreign-appointment fixture",
  "mechanicIds": [{{csrfSource1.personId}}]
}

{{
  exports.ForeignAppointmentId = anchorAppointment.id;
}}

?? status == 201

###

### [Negative][QuotesValidation] Create with a past ValidUntil is rejected (422 expected, D22)
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Past ValidUntil Quote {{RunId}}",
  "validUntil": "2020-01-01T00:00:00"
}

?? status == 422

###

### [Negative][QuotesValidation] Create with an AppointmentId belonging to a different vehicle is rejected (422 expected, D42)
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{OtherVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Foreign Appointment Quote {{RunId}}",
  "appointmentId": {{ForeignAppointmentId}}
}

?? status == 422

###

### [Negative][QuotesValidation] Unknown ?status= filter value is rejected (422 expected, D43: Expired is a computed flag, not a filter value)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?status=Expired

?? status == 422

###

### [Setup][QuotesValidation] Create a draft quote for the concurrency checks (201 expected)
# @name versionQuote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}}"
}

?? status == 201

###

### [Negative][QuotesValidation] Update with a version that does not match is rejected (409 expected, body {"code":"quote_version_conflict"}, D30/D38)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{versionQuote.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}} Stale",
  "version": 123456789
}

?? status == 409
?? js response.parsedBody.code == quote_version_conflict
###

### [Negative][QuotesValidation] Update with no version is rejected (422 expected, "Version is required.", D38)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{versionQuote.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}} No Version"
}

?? status == 422

###

### [Cleanup][QuotesValidation] Delete the fixture appointment created above (204 expected)
DELETE {{AutoService_ApiService_HostAddress}}/api/appointments/{{ForeignAppointmentId}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}

?? status == 204
