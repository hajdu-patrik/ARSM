# ─────────────────────────────────────────────────────────────
# QUOTES - CREATION VALIDATION, CONCURRENCY, AND VALID-UNTIL MATRIX
# ─────────────────────────────────────────────────────────────

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}

# ─────────────────────────────────────────────────────────────

### [Setup][QuotesValidation] Login as admin (MechanicOnly prerequisite)
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

###

### [Setup][QuotesValidation] Resolve the demo vehicle anchor from the seeded quotes (200 expected)
# Vehicle identity ids depend on the local database's insert history, so a literal
# id is right on one machine and 404 on the next. The three demo quotes (D12) are
# addressed here by their stable QuoteNumber (D13), and each one sits on its own vehicle.
# @name seedQuotes
GET {{AutoService_ApiService_HostAddress}}/api/quotes

{{
  exports.AnchorVehicleId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0001').vehicleId;
  exports.OtherVehicleId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0002').vehicleId;
}}

###

### [Setup][QuotesValidation] Resolve an appointment that belongs to the anchor vehicle (200 expected)
# Used below against a different vehicle, which is exactly the D42 mismatch case.
# descending is spelled out on purpose: the handler binds it as a non-nullable bool
# with no default, so omitting it is a binding failure (400), not a default sort.
# @name anchorAppointments
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/appointments?descending=false

{{
  exports.ForeignAppointmentId = anchorAppointments[0].id;
}}

###

### [Negative][QuotesValidation] Create with a past ValidUntil is rejected (422 expected, D22)
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "title": "Past ValidUntil Quote {{RunId}}",
  "validUntil": "2020-01-01T00:00:00"
}

###

### [Negative][QuotesValidation] Create with an AppointmentId belonging to a different vehicle is rejected (422 expected, D42)
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{OtherVehicleId}}/quotes
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "title": "Foreign Appointment Quote {{RunId}}",
  "appointmentId": {{ForeignAppointmentId}}
}

###

### [Negative][QuotesValidation] Unknown ?status= filter value is rejected (422 expected, D43: Expired is a computed flag, not a filter value)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?status=Expired

###

### [Setup][QuotesValidation] Create a draft quote for the concurrency checks (201 expected)
# @name versionQuote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}}"
}

###

### [Negative][QuotesValidation] Update with a version that does not match is rejected (409 expected, body {"code":"quote_version_conflict"}, D30/D38)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{versionQuote.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}} Stale",
  "version": 123456789
}

###

### [Negative][QuotesValidation] Update with no version is rejected (422 expected, "Version is required.", D38)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{versionQuote.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}} No Version"
}

###

### [Setup][QuotesValidation] Create a draft quote to drive the ValidUntil status matrix (201 expected)
# @name sentQuote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "title": "ValidUntil Matrix Quote {{RunId}}"
}

###

### [Setup][QuotesValidation] Add a line so the quote can be sent (201 expected)
# @name sentQuoteLine
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{sentQuote.id}}/lines
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "lineKind": "Part",
  "quantity": 1,
  "description": "ValidUntil matrix fixture line",
  "netUnitPrice": 100,
  "vatRatePercent": 27,
  "version": {{sentQuote.version}}
}

###

### [Setup][QuotesValidation] Transition to Sent (200 expected)
# @name sentQuoteSent
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{sentQuote.id}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Sent",
  "version": {{sentQuoteLine.version}}
}

###

### [Negative][QuotesValidation] Editing the Title of a Sent quote is rejected (409 expected, Draft-only lock)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{sentQuote.id}}
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "title": "Should not apply",
  "version": {{sentQuoteSent.version}}
}

###

### [Positive][QuotesValidation] Extending a Sent quote's ValidUntil to a later date succeeds (200 expected, D23)
# @name sentQuoteExtended
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{sentQuote.id}}/valid-until
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "validUntil": "2031-01-01T00:00:00",
  "version": {{sentQuoteSent.version}}
}

###

### [Negative][QuotesValidation] Moving a Sent quote's ValidUntil earlier is rejected (422 expected, Sent only allows extension)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{sentQuote.id}}/valid-until
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "validUntil": "2030-01-01T00:00:00",
  "version": {{sentQuoteExtended.version}}
}

###

### [Setup][QuotesValidation] Transition to Accepted (200 expected)
# @name sentQuoteAccepted
POST {{AutoService_ApiService_HostAddress}}/api/quotes/{{sentQuote.id}}/status
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "status": "Accepted",
  "version": {{sentQuoteExtended.version}}
}

###

### [Negative][QuotesValidation] Editing an Accepted quote's ValidUntil is rejected (409 expected, decided quotes are locked)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{sentQuote.id}}/valid-until
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "validUntil": "2032-01-01T00:00:00",
  "version": {{sentQuoteAccepted.version}}
}
