# ValidUntil status-matrix scenarios (Sent/Accepted lock behavior) live in the sibling
# quotes-validity-matrix.http, split out to keep both files under the 250-line limit.

@AutoService_ApiService_HostAddress = {{$processEnv AutoService_ApiService_HostAddress}}
@WebUI_Origin = {{$processEnv ARSM_TEST_WEBUI_ORIGIN}}
@AdminEmail = {{$processEnv ARSM_TEST_ADMIN_EMAIL}}
@AdminPassword = {{$processEnv ARSM_TEST_ADMIN_PASSWORD}}
@RunId = {{$timestamp}}

### [Setup][QuotesValidation] Login as admin (MechanicOnly prerequisite)
# @name csrfSource1
POST {{AutoService_ApiService_HostAddress}}/api/auth/login
Origin: {{WebUI_Origin}}
Content-Type: application/json

{
  "email": "{{AdminEmail}}",
  "password": "{{AdminPassword}}"
}

{{
  exports.CsrfToken = response.headers['set-cookie']?.find(c => c.startsWith('autoservice_csrf='))?.match(/^autoservice_csrf=([^;]+)/)?.[1];
}}

?? status == 200

###

### [Setup][QuotesValidation] Resolve the demo vehicle anchor from the seeded quotes (200 expected)
# Vehicle ids depend on the local DB's insert history, so this resolves the demo vehicle anchor via the
# seeded quote's stable QuoteNumber (D13) instead of a literal id that would 404 on another machine.
# @name seedQuotes
GET {{AutoService_ApiService_HostAddress}}/api/quotes

{{
  exports.AnchorVehicleId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0001').vehicleId;
  exports.OtherVehicleId = seedQuotes.find(q => q.quoteNumber === 'ARSM-2026-0002').vehicleId;
}}

?? status == 200

###

### [Setup][QuotesValidation] Resolve an appointment that belongs to the anchor vehicle (200 expected)
# Used below against a different vehicle for the D42 mismatch case; descending is spelled out because
# the handler binds it as a non-nullable bool with no default, so omitting it would 400, not default-sort.
# @name anchorAppointments
GET {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/appointments?descending=false

{{
  exports.ForeignAppointmentId = anchorAppointments[0].id;
}}

?? status == 200

###

### [Negative][QuotesValidation] Create with a past ValidUntil is rejected (422 expected, D22)
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Past ValidUntil Quote {{RunId}}",
  "validUntil": "2020-01-01T00:00:00"
}

?? status == 422

###

### [Negative][QuotesValidation] Create with an AppointmentId belonging to a different vehicle is rejected (422 expected, D42)
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{OtherVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Foreign Appointment Quote {{RunId}}",
  "appointmentId": {{ForeignAppointmentId}}
}

?? status == 422

###

### [Negative][QuotesValidation] Unknown ?status= filter value is rejected (422 expected, D43: Expired is a computed flag, not a filter value)
GET {{AutoService_ApiService_HostAddress}}/api/quotes?status=Expired

?? status == 422

###

### [Setup][QuotesValidation] Create a draft quote for the concurrency checks (201 expected)
# @name versionQuote
POST {{AutoService_ApiService_HostAddress}}/api/vehicles/{{AnchorVehicleId}}/quotes
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}}"
}

?? status == 201

###

### [Negative][QuotesValidation] Update with a version that does not match is rejected (409 expected, body {"code":"quote_version_conflict"}, D30/D38)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{versionQuote.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}} Stale",
  "version": 123456789
}

?? status == 409
?? js response.parsedBody.code == quote_version_conflict
###

### [Negative][QuotesValidation] Update with no version is rejected (422 expected, "Version is required.", D38)
PUT {{AutoService_ApiService_HostAddress}}/api/quotes/{{versionQuote.id}}
Origin: {{WebUI_Origin}}
X-CSRF-Token: {{CsrfToken}}
Content-Type: application/json

{
  "title": "Version Conflict Quote {{RunId}} No Version"
}

?? status == 422

###
