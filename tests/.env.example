# ARSM HTTP test environment (copy to tests/.env)

# --- Endpoints ---
AutoService_ApiService_HostAddress=https://localhost:5200
ARSM_TEST_WEBUI_ORIGIN=https://localhost:5173

# --- Shared test passwords ---
ARSM_TEST_PASSWORD=SET_LOCAL_TEST_PASSWORD
ARSM_TEST_WRONG_PASSWORD=Wrong_Password.999

# --- Admin ---
ARSM_TEST_ADMIN_EMAIL=gabor.kovacs@example.com
ARSM_TEST_ADMIN_PASSWORD=SET_LOCAL_ADMIN_PASSWORD

# --- Mechanic ---
ARSM_TEST_MECHANIC_EMAIL=peter.nagy@example.com
ARSM_TEST_MECHANIC_PASSWORD=SET_LOCAL_MECHANIC_PASSWORD
ARSM_TEST_MECHANIC_NEW_PASSWORD=SET_LOCAL_MECHANIC_NEW_PASSWORD

# --- Customer ---
ARSM_TEST_CUSTOMER_EMAIL=anna.toth@example.com
