#!/bin/sh
# Mandatory pre-push gate (mirrors CI). Install: git config core.hooksPath .githooks
# Bypass with `git push --no-verify` only as a documented exception.

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

if command -v python >/dev/null 2>&1; then
    py=python
elif command -v python3 >/dev/null 2>&1; then
    py=python3
else
    echo "pre-push: python was not found on PATH." >&2
    exit 1
fi

# stdin carries git's ref list; the gate never reads it, so keep it away from the child tools.
exec "$py" scripts/pre-push.py </dev/null
